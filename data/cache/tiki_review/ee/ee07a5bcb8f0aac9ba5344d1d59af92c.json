butes": {"agree": ["Bìa đẹp, bắt mắt", "chất lượng giấy tốt", "in ấn/màu sắc rõ nét", "Nội dung hấp dẫn, lôi cuốn"], "disagree": []}, "delivery_rating": []}, {"id": 19148223, "title": "Cực kì hài lòng", "content": "Tại sao mình thích \"Điều kỳ diệu của tiệm tạp hóa Namiya\"\r\n\r\n1. Vì mình bất ngờ. sau khi đọc vài đầu trình thám và tâm lý xã hội của bác Keigo như \"Phía sau nghi can X\" , \"Sự cứu rỗi của thánh nữ\" và \"Bạch dạ hành\" - những cuốn sách rất u ám và thê thảm của bác, mình hoàn toàn bị bất ngờ vì không ngờ bác Keigo lại viết ra một cuốn sách rất ấm áp và dễ thương thế này.\r\n\r\n2. Vì nhân văn. Ở tiệm tạp hóa Namiya, là cơ hội đổi đời chỉ vì có thể giúp đỡ người khác. Nếu so với những cuốn sách khác của bác Keigo, thường vì một lầm lỡ mà nhân vật cứ tiếp tục dấn sâu hơn vào con đường tội lỗi không lối thoát, ở Namiya, là cơ hội nhìn ra ánh sáng cuối đường hầm, tìm lại được con đường chính nghĩa chỉ vì đơn giản họ nhận ra mình có ích. Mình rất thích thông điệp này. Để cứu rỗi bản thân, có lẽ phải bắt đầu từ trái tim mở lòng mong muốn giúp đỡ người khác.\r\n\r\n3. Vì nó giúp mình quên đi hiện tại để lạc vào thế giới màu nhiệm nơi thời gian và không gian tương thông. Thời gian đọc \"Điều kỳ diệu của tiệm tạp hóa Namiya\" đang bị crush ghosted :))) quay quắt trong vòng xoáy nt, chờ nt,... nhờ cuốn sách thú vị này mà quên đi những khoảng lặng chờ tn mệt mỏi, quên mẹ luôn crush là tđn :)) so its mean so much to me.", "status": "approved", "thank_count": 0, "score": 27.77777778, "new_score": 0.16776441, "customer_id": 491673, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1682916293, "created_by": {"id": 491673, "name": "Bùi Thị Phương Liên", "full_name": "Bùi Thị Phương Liên", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2014-11-25 00:38:18", "group_id": 8, "purchased": true, "purchased_at": 1670251413, "contribute_info": {"id": 491673, "name": "Bùi Thị Phương Liên", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 12 năm", "total_review": 11, "total_thank": 43}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 3304877, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 3304875, "timeline": {"review_created_date": "2023-05-01 11:44:53", "delivery_date": "2022-12-06 14:27:50", "current_date": "2026-09-08 23:20:04", "content": "Đã dùng 5 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 5 tháng."}, "comments": [], "vote_attributes": {"agree": ["Bìa đẹp, bắt mắt", "chất lượng giấy tốt", "in ấn/màu sắc rõ nét", "Nội dung hấp dẫn, lôi cuốn"], "disagree": []}, "delivery_rating": []}, {"id": 19102999, "title": "Cực kì hài lòng", "content": "Bác Keigo thì quá tuyệt vời r, mình mua cuốn này theo rv trên YouTube. Sách hay lắm nhe quí vị :>>> sách chia thành 5 chương, lúc đầu đọc thì mình thấy hơi rời rạc😅 nhưng từ chương 3 trở đi thì cuốn cực. Càng đọc tới cuối kiểu càng thấy nhiều tình tiết nó liên kết với nhau, kiểu đang được mà mình phải dừng lại nghĩ r kiểu “À mình có đọc tình tiết này r, hóa ra là nó như v”. Nói chung một trong những quyển sách yêu thích của mình. Nhiều tình tiết cũng làm mình cực xúc động 🥹 đánh mua nhé mng. Tiki giao nhanh lém:>>> Đánh giá 4/5", "status": "approved", "thank_count": 0, "score": 27.77777778, "new_score": 0.16751839, "customer_id": 22019420, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1681751455, "created_by": {"id": 22019420, "name": "Phương Khanh", "full_name": "Phương Khanh", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2021-06-03 02:14:16", "group_id": 8, "purchased": true, "purchased_at": 1658304977, "contribute_info": {"id": 22019420, "name": "Phương Khanh", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 5 năm", "total_review": 4, "total_thank": 0}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 3304877, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 3304875, "timeline": {"review_created_date": "2023-04-18 00:10:55", "delivery_date": "2022-07-21 08:30:56", "current_date": "2026-09-08 23:20:04", "content": "Đã dùng 1 năm", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 năm."}, "comments": [], "vote_attributes": {"agree": ["Bìa đẹp, bắt mắt", "chất lượng giấy tốt", "in ấn/màu sắc rõ nét", "Nội dung hấp dẫn, lôi cuốn"], "disagree": []}, "delivery_rating": []}, {"id": 19077434, "title": "Cực kì hài lòng", "content": "Vẫn như cũ mình vẫn không thích kiểu đóng gói không bọc gì sách bên ngoài mà cho hộp chuyển luôn tuy mình chưa dính quyển nào móp méo. Tuy nhiên đc cái nhanh gọi và nhân viên dễ thương về truyện: \r\nĐiều kỳ diệu ở tập hóa Namiya - Higashino Keigo\r\n“...hãy tin ngày mai sẽ tốt đẹp hơn ngày hôm nay”\r\nTại sao, tại sao, tại sao bây giờ mình mới đọc cuốn này, thực sự mình rất bất ngờ về cách viết của bác Keigo trong cuốn này vì trước đó mình có trải nghiệm không tốt ở cuốn Án mạng mười một chữ, nhưng sang cuốn này là một trải nghiệm khác hẳn. Cách kể truyện lôi cuốn từ chương đầu tiên cho tới khi khép lại cuốn sách với lối hành văn sâu sắc tác giả đã truyền tải cho người đọc những ý nghĩa rất nhân văn.\r\nQua mỗi câu chuyện chúng ta như cảm thấy hình bóng của bản thân đâu đó trong các câu chuyện, trong cuộc sống ai cũng có các vấn đề cần phải giải quyết những băn khoăn, những “rối tơ lòng”. Mỗi người có một nỗi niềm riêng mà đôi khi ta chỉ mong muốn được ai đó lắng nghe, để sẻ chia thấu hiểu thế là đủ, dù lời khuyên có ra sao đi nữa chúng ta cũng sẽ nhẹ lòng hơn. Thông qua đó cho chúng ta thêm niềm tin về lòng tốt và sự hướng thiện.\r\nKết cấu câu chuyện làm mình nhớ đến 1367 của Trần Hạo Cơ, về cách xâu chuỗi mỗi câu chuyện nhỏ móc nối với nhau như một mắt xích làm thành một câu chuyện lớn hoàn chỉnh. Mình cũng thích cách tác giả lấy chủ đề các bức thư viết tay gửi đi và nhận lại làm mình nhớ một thời mình cũng viết thư khá nhiều cho chị gái ở xa, giờ cảm giác như lâu lắm rồi. \r\nĐiểm mình còn chưa thích là cảm giác cái kết còn hơi thiếu, như về 3 nhân vậy chính còn “thiếu” đất diễn để thể hiện sự thay đổi trong họ.\r\nTruyện phù hợp cho mọi lứa tuổi vì khá nhẹ nhàng, dễ đọc.\r\n4,5/5*\r\n“Mọi thứ đều tự do, khả năng là vô hạn. Điều này thật tuyệt. Tôi mong bạn tin vào bản thân và cháy hết mình với cuộc đời”.", "status": "approved", "thank_count": 0, "score": 27.77777778, "new_score": 0.16739755, "customer_id": 28986403, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1681179331, "created_by": {"id": 28986403, "name": "Phùng Thái", "full_name": "Phùng Thái", "region": null, "avatar_url": "https://salt.tikicdn.com/cache/512x512/ts/avatar/97/9f/d1/0fdad76e51809aedb9a37487cb6856f2.png", "created_time": "2023-03-24 20:45:04", "group_id": 8, "purchased": true, "purchased_at": 1679902630, "contribute_info": {"id": 28986403, "name": "Phùng Thái", "avatar": "https://salt.tikicdn.com/cache/512x512/ts/avatar/97/9f/d1/0fdad76e51809aedb9a37487cb6856f2.png", "summary": {"joined_time": "Đã tham gia 4 năm", "total_review": 41, "total_thank": 3}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 3304877, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 3304875, "timeline": {"review_created_date": "2023-04-11 09:15:31", "delivery_date": "2023-03-28 10:14:41", "current_date": "2026-09-08 23:20:04", "content": "Đã dùng 14 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 14 ngày."}, "comments": [], "vote_attribu