 []}, {"id": 9219204, "title": "Cực kì hài lòng", "content": "Siêu hay luôn. Rất lâu rồi t mới được đọc 1 cuốn sách mà từ nhân vật cho đến câu chuyện, cách viết của tác giả lại hay đến thế. Nhân vật “tôi” tuy không hoàn hảo nhưng cái sự thiếu hoàn hảo ấy thật sự rất đời, trong 1 con người luôn có sự song hành của sự tốt đẹp và những ý nghĩ, ích kỉ riêng rất con người. Câu chuyện vô cùng hay, hoàn cảnh tạo ra nghịch cảnh. Cách viết của tác giả cũng thật sự rất hay, miêu tả tâm lí con người vô cùng chuẩn xác, thậm chí thỉnh thoảng những suy nghĩ của nhân vật còn khiến T chột dạ vì t cũng như vậy, kiểu rất trẻ con?. Hay, highly recommend", "status": "approved", "thank_count": 0, "score": 4.27350427, "new_score": 0.15426429, "customer_id": 17105831, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1618997002, "created_by": {"id": 17105831, "name": "Khuất Phương Dung", "full_name": "Khuất Phương Dung", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2020-04-12 23:05:25", "purchased": true, "purchased_at": 1611470096, "contribute_info": {"id": 17105831, "name": "Khuất Phương Dung", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 7 năm", "total_review": 11, "total_thank": 0}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 4781791, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 4780917, "timeline": {"review_created_date": "2021-04-21 16:23:22", "delivery_date": "2021-01-25 12:59:50", "current_date": "2026-09-08 23:17:29", "content": "Đã dùng 3 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 3 tháng."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 2933931, "title": "Cực kì hài lòng", "content": "Thật ra trước đây mình cũng từng nghe tóm tắt nội dung cuốn này rồi kiểu dạng audio book ấy nhưng bằng tiếng trung. Hồi ấy nghe cũng đã cảm thấy rất rất thích rồi nên quyết định.mua sách về đọc. Quá hay quá xuất sắc luôn ạ. Mình nghĩ rằng nó không chỉ nói về tình bạn của Amir và hassan, về sự ích kỉ hèn nhát của Amir, mà còn có cả cách mà bố của Amir kì vọng ở con mình... Có lẽ \"người đua diều\" là quyển sách làm mình xúc động ở nhiều đoạn nhất, dễ dàng lấy đi nước mắt của người đọc nhất mà mình từng đọc. Vốn dĩ cuốn sách được mọi người đánh giá cao đến thế mình nghĩ không chỉ vì nó rất cảm động, ý nghĩa mà còn cả những cảm xúc thực tế của nhân vật. Nói chung là mình sẵn sàng đánh giá 5 sao cho quyển sách tuyệt vời này.", "status": "approved", "thank_count": 4, "score": 0.01107895, "new_score": 0.14920726, "customer_id": 11706495, "comment_count": 0, "rating": 5, "images": [{"id": 785490, "full_path": "https://salt.tikicdn.com/ts/review/a2/7e/dd/8fb1d6f1d60259335108e4ed2bb1029e.jpg", "status": "approved"}], "thanked": false, "created_at": 1580618842, "created_by": {"id": 11706495, "name": "Thúy Linh", "full_name": "Thúy Linh", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "purchased": true, "purchased_at": 1580092304, "contribute_info": {"id": 11706495, "name": "Thúy Linh", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 8 năm", "total_review": 31, "total_thank": 4}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 4781791, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 4780917, "timeline": {"review_created_date": "2020-02-02 11:47:22", "delivery_date": "2020-01-29 12:07:07", "current_date": "2026-09-08 23:17:29", "content": "Đã dùng 4 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 4 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []