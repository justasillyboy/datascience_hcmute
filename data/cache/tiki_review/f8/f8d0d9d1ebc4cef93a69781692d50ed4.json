o nhắc đến sự quán chiếu bản thân. Với những đóng góp to lớn cho nhân loại bằng cách luôn nghĩ cách giúp tốt hơn cho con người, mình nghĩ ai cũng làm được nhưng chỉ khi có sự không vị kỷ trong con người mình.\n\nLove.!", "status": "approved", "thank_count": 20, "score": 0.00492717, "new_score": 0.16915792, "customer_id": 5726334, "comment_count": 1, "rating": 5, "images": [{"id": 1781311, "full_path": "https://salt.tikicdn.com/ts/review/61/23/fe/21d7423be3b9ce5fa8ac512ab9604fb4.jpg", "status": "approved"}, {"id": 1781312, "full_path": "https://salt.tikicdn.com/ts/review/67/ff/0a/f9ccf24c13708aacbd94a25e6807c61e.jpg", "status": "approved"}, {"id": 1781313, "full_path": "https://salt.tikicdn.com/ts/review/39/9e/a2/a4eb463fc040638619371f758648aecd.jpg", "status": "approved"}, {"id": 1781314, "full_path": "https://salt.tikicdn.com/ts/review/2b/b0/97/b468b3eb5db8b72f4e42518ea85c91b5.jpg", "status": "approved"}, {"id": 1781315, "full_path": "https://salt.tikicdn.com/ts/review/a3/f8/95/4fc84b88377c66ac8f8d8c6ba18c15ff.jpg", "status": "approved"}], "thanked": false, "created_at": 1617339968, "created_by": {"id": 5726334, "name": "Hoàng Anh Sỹ", "full_name": "Hoàng Anh Sỹ", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2017-09-06 11:57:27", "group_id": 8, "purchased": true, "purchased_at": 1611921704, "contribute_info": {"id": 5726334, "name": "Hoàng Anh Sỹ", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 9 năm", "total_review": 16, "total_thank": 63}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 3083073, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "21/ce/5c/b52d0b8576680dc3666474ae31b091ec.jpg"}, "product_id": 3082815, "comments": [{"id": 1932230, "review_id": 8838997, "commentator": "customer", "customer_id": 22282754, "fullname": "Vo Duong", "avatar_url": "https://tiki.vn/assets/img/avatar.png", "content": "mình ai đó