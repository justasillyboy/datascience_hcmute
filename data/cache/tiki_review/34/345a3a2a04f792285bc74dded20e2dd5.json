om/ts/ta/21/ce/5c/f3809056f0195db1a6295a50ac68ee0e.jpg", "content": "Chào bạn, Tiki đã ghi nhận thông tin đánh giá và nhận xét từ bạn, Tiki rất xin lỗi vì những trải nghiệm vừa qua chưa được trọn vẹn khi mua sắm và sử dụng dịch vụ tại Tiki. Tuy nhiên, Tiki cũng đã liên hệ bạn qua cuộc gọi để hỗ trợ. Hiện tương da nóng khi bôi sản phẩm có vitamin C lên da là bình thường. Bao bì có thêm dòng chữ “Essence” là bao bì mới nhất của hãng. Tiki luôn cam kết hàng chính hãng, chất lượng nên mong bạn yên tâm sử dụng nhé. Trường hợp cần hỗ trợ thêm, bạn có thể liên hệ Tiki qua hộp thư hotro@tiki.vn hoặc hotline 1900-6035. Trân trọng.", "score": 0, "create_at": 1568195522, "badge": "https://salt.tikicdn.com/ts/review/05/6f/c0/d7462c4721ae3d6aabb2f51ff13fa44f.png", "status": 1, "is_reported": false}], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 2428457, "title": "Thắc mắc về sản phẩm này, mùi hương lạ", "content": "Mình nhận dc sản phẩm này, bao bì này có thêm chữ Essence trong khi mình từng sử dụng 1 sp khác cùng mẫu này thì không có chữ đó. Thêm nữa thì mùi của sản phẩm rất lạ, khôgn giống với lọ mình đang dùng (lọ đang dùng mình mua ở nơi khác, mùi hương dễ chịu). Mùi của lọ mình mới nhận đây khá nồng và lạ, các bạn trả lời giúp mình với.", "status": "approved", "thank_count": 0, "score": 0.0039323, "new_score": 0.14341994, "customer_id": 1337613, "comment_count": 0, "rating": 1, "images": [], "thanked": false, "created_at": 1567652059, "created_by": {"id": 1337613, "name": "Nguyen Thanh Ha", "full_name": "Nguyen Thanh Ha", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2016-05-01 17:48:44", "purchased": true, "purchased_at": 1566746234, "contribute_info": {"id": 1337613, "name": "Nguyen Thanh Ha", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 11 năm", "total_review": 3, "total_thank": 38}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_a