{"stars": {"1": {"count": 0, "percent": 0}, "2": {"count": 0, "percent": 0}, "3": {"count": 0, "percent": 0}, "4": {"count": 11, "percent": 5}, "5": {"count": 192, "percent": 95}}, "rating_average": 4.9, "reviews_count": 203, "review_photo": {"total": 29, "total_photo": 41}, "data": [{"id": 20195007, "title": "Cực kì hài lòng", "content": "[Vừa nhắm mắt vừa mở cửa sổ]\r\nLát cắt cuộc sống của một đứa trẻ 10 tuổi về gia đình, bạn bè, hàng xóm láng giềng và một đứa trẻ lang thang khác sống trong chợ. Vừa nhắm mắt vừa mở cửa sổ là hành động thường xuyên lặp lại của cậu bé khi dang tay đón lấy hương thơm và không khí trong lành từ vườn hoa nhà mình. Không nhìn bằng mắt nữa, chuyển sang \"nhìn\" bằng các giác quan khác, bạn sẽ cảm nhận được sự thú vị của cuộc sống. Chạm tay vào cánh hoa, hít hà hương thơm cỏ cây, lắng tai nghe tiếng xao động của từng kẽ lá, trái tim bình yên đến lạ.\r\nCách kể chuyện mộc mạc, bình dị, hồn nhiên pha chút hài hước cuốn người đọc vào từng mảnh ghép cuộc sống của cậu bé lúc nào không hay.\r\n#vuanhammatvuamocuaso", "status": "approved", "thank_count": 0, "score": 33.33333333, "new_score": 0.18804273, "customer_id": 10529571, "comment_count": 0, "rating": 5, "images": [{"id": 4418766, "full_path": "https://salt.tikicdn.com/ts/review/a1/63/12/cd1a0b0d16245537b8a50da884137a56.jpg", "status": "approved"}], "thanked": false, "created_at": 1764724333, "created_by": {"id": 10529571, "name": "Thái Thị Hồng Trang", "full_name": "Thái Thị Hồng Trang", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2019-01-24 16:05:07", "group_id": 8, "purchased": true, "purchased_at": 1733970875, "contribute_info": {"id": 10529571, "name": "Thái Thị Hồng Trang", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 8 năm", "total_review": 70, "total_thank": 11}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 168662172, "is_photo": true, "seller": {"