a Van mình rất quý, cực kì ưng. Nói chung là mình chịu đựng bạn này quá mức rồi. Thành ra mình giảm hết hứng thú khi mua được sách mới từ Tiki so với trước đây", "status": "approved", "thank_count": 1, "score": 0.02832464, "new_score": 0.14509542, "customer_id": 771180, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1575527407, "created_by": {"id": 771180, "name": "Nguyễn Bích Hồng", "full_name": "Nguyễn Bích Hồng", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "purchased": true, "purchased_at": 1575439842, "contribute_info": {"id": 771180, "name": "Nguyễn Bích Hồng", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 11 năm", "total_review": 99, "total_thank": 45}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading", "Loại bìa Bản Thông Thường"], "product_attributes": ["Loại bìa: Bản Thông Thường"], "spid": 24951097, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 24951095, "timeline": {"review_created_date": "2019-12-05 13:30:07", "delivery_date": "2019-12-05 11:33:03", "current_date": "2026-09-08 23:35:45", "content": "Đã dùng 2 giờ", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 2 giờ."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 4191091, "title": "Cực kì hài lòng", "content": "giáo hàng nhanh và tốt nhân viên giao hàng thân thiện nói chung rất đc", "status": "approved", "thank_count": 0, "score": 44.44444444, "new_score": 0.14065182, "customer_id": 17746021, "comment_count": 0, "rating": 5, "images": [{"id": 1100035, "full_path": "https://salt.tikicdn.com/ts/review/df/b2/f2/9db0c57544a042e67537f027f065d09a.jpg", "status": "approved"}, {"id": 1100036, "full_path": "https://salt.tikicdn.com/ts/review/7f/35/57/28bd50aa6990a0d5a89fae0eb7a185e1.jpg", "status": "approved"}, {"id": 11