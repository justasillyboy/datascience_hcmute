d": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 13419678, "timeline": {"review_created_date": "2021-08-23 15:38:10", "delivery_date": "2021-08-23 10:28:05", "current_date": "2026-09-08 12:46:02", "content": "Đã dùng 5 giờ", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 5 giờ."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 11469840, "title": "Cực kì hài lòng", "content": "Một cuốn sách khá hay, tuy nhiên nếu bạn không thích đọc một cuốn sách tự truyện thì lại không hợp nha.", "status": "approved", "thank_count": 0, "score": 44.44444444, "new_score": 0.15063143, "customer_id": 6149189, "comment_count": 0, "rating": 5, "images": [{"id": 2355289, "full_path": "https://salt.tikicdn.com/ts/review/d8/04/8c/ab488e3ff813019715000be2d5d664ee.jpg", "status": "approved"}, {"id": 2355290, "full_path": "https://salt.tikicdn.com/ts/review/83/ac/76/542d0f87e8a040054ecfec92ee9e7b8a.jpg", "status": "approved"}, {"id": 2355291, "full_path": "https://salt.tikicdn.com/ts/review/6d/c0/93/37dce60809a03b277cffbac72a5a85a9.jpg", "status": "approved"}], "thanked": false, "created_at": 1627363915, "created_by": {"id": 6149189, "name": "Nguyễn Thị Nguyệt", "full_name": "Nguyễn Thị Nguyệt", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2017-12-01 13:18:48", "purchased": true, "purchased_at": 1625643985, "contribute_info": {"id": 6149189, "name": "Nguyễn Thị Nguyệt", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 9 năm", "total_review": 21, "total_thank": 11}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 13419679, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 13419678, "timeline": {"review_created_date": "2021-07-27 12:31:55", "delivery_date": "2021-07-07 16:33:18", "current_date": "2026-09-08 12:46:02", "content": "Đã dùng 1 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 tháng."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 11896044, "title": "Cực kì hài lòng", "content": "Một tác phẩm hay, cảm xúc; giúp người đọc thấy nhiều giá trị. Tiki giao hàng nhanh; bao bọc cẩn thận. Mình khuyên các bạn đã xem nên mua. Mình tóm tắt qua nội dung để các bạn có thể lựa chọn. \n\nĐi Tìm Lẽ Sống tựa tiếng Anh là Man's Search for Meaning là sách được viết từ những năm tháng trải nghiệm thảm khốc của chính tác giả trong trại tập trung của Đức Quốc Xã.  Frnakl đã phát triển một phương pháp điều trị tâm lý là \" Liệu Pháp Ý Nghĩa\" để giúp người bệnh tìm ra ý nghĩa cuộc sống của đời mình. \nBằng những chứng kiến và trải nghiệm thực tế ông cho rằng con người mình có thể giữ được phẩm giá đó chính là giá trị; đầu óc, sự tự do bên trong nếu nổ lực đấu tranh trong hoàn cảnh bị người khác đe doạ, vây hãm. \nNhững trải nghiệm từ cuộc sống trong trại tập trung cho thấy con người có sự lựa chọn cho hành động của mình. Con người bằng tinh thần quả cảm có vượt qua sự vô cảm và kiềm chế sự tức giận. Con người có thể giữ vững sự tự do về tinh thần, sự độc lập về tâm trí, ngay cả trong điều kiện căng thẳng về thần kinh và tâm trí. Trở thành loại người nào là kết quả quyết định từ bên trong của mỗi người. \nTrại tập trung phát xít qua trang viết của tác giả vô cùng tàn bạo nhưng ở đó có những câu chuyện cũng thật cao cả về tình người, một con người khi bản thân mình cảm thấy tuyệt vọng vẫn có khả năng đem lại hi vọng, niềm an ủi cho người khác. Cuộc sống có những sự kiện xảy ra một cách ngẫu nhiên và đôi khi tương lại là bất định nhưng ta sẽ chấp nhận tương lại đó với một niềm lạc quan chứ không phải trong sự hỗn loạn bên trong mình hay biến thành một kẻ cơ hội. Cuộc sống luôn đặt câu hỏi cho mọi người, và con người chỉ có thể trả lời cuộc sống thông qua chính cuộc sống riêng của mình, trả lời bằng thái độ sống trách nhiệm với bản thân. \nMỗi chúng ta nên phân biệt sự khác biệt chủ chốt giữa giá trị theo phẩm cách và giá trị theo sự hữu dụng. Không phân biệt rõ ràng được điều này dẫn đến sự đề cao quá mức về giá trị theo sự hữu dụng, đề cao giá trị của người có tiền hay thành công. \nTrong lúc dịch bệnh đang hoành hoành, hoàn cảnh khiến cho mỗi người có đôi phút tự suy nghĩ về giá trị sống của mình, cộng đồng mình đang sống. Và Đi Tìm Lẽ Sống là nguồn năng lượng để mỗi cả nhân chiêm nghiệm lại chính mình và cảm ơn cuộc đời nếu mình có một hoàn cảnh sống tốt hơn và có điều kiện hơn phần còn lại.", "status": "approved", "thank_count": 4, "score": 0.01483003, "new_score": 0.15648414, "customer_id": 16641140, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1629276997, "created_by": {"id": 16641140, "name": "Tra Huy", "full_name": "Tra Huy", "region": null, "avatar_url": "https://graph.facebook.com/v3.3/3146747525337912/picture?type=large&return_ssl_resources=1", "created_time": "2020-03-01 17:44:23", "group_id": 8, "purchased": true, "purchased_at": 1627874471, "contribute_info": {"id": 16641140, "name": "Tra Huy", "avatar": "https://graph.facebook.com/v3.3/3146747525337912/picture?type=large&return_ssl_resources=1", "summary": {"joined_time": "Đã tham gia 7 năm", "total_review": 9, "total_thank": 4}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 13419679, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 13419678, "timeline": {"review_created_date": "2021-08-18 15:56:37", "delivery_date": "2021-08-03 11:27:30", "current_date": "2026-09-08 12:46:02", "content": "Đã dùng 1 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 tháng."}, "comments": [], "vote_att