created_by": {"id": 620317, "name": "Nguyễn  Giang", "full_name": "Nguyễn  Giang", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2015-04-26 20:26:32", "group_id": 8, "purchased": true, "purchased_at": 1658845657, "contribute_info": {"id": 620317, "name": "Nguyễn  Giang", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 12 năm", "total_review": 491, "total_thank": 12}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 8886008, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 8886007, "timeline": {"review_created_date": "2022-07-30 13:34:07", "delivery_date": "2022-07-29 08:47:44", "current_date": "2026-09-08 23:19:33", "content": "Đã dùng 1 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 2166371, "title": "Quyển sách của sự sống", "content": "Cũng như Người đua diều, Ngàn mặt trời rực rỡ giúp người đọc hiểu thêm nhiều về Afghanistan, về chiến tranh Hồi giáo, nhưng hơn hết Ngàn mặt trời rực rỡ đưa ta đến với những người phụ nữ, những số phận, trong cùng cực mà đứng dậy đấu tranh. Cuộc đời của Mariam và Laila (2 nhân vật chính) khác nhau từ cách bắt đầu lẫn kết thúc, nhưng cả hai đã gặp nhau, quyện vào nhau và làm nên một tác phẩm đầy cảm xúc. Tác phẩm ấy đưa tôi đến nhiều cung bậc cảm xúc, dở khóc dở cười, cũng xen đôi chút khó chịu vì \"tại sao nó lại như thế mà không phải như kia\" và đặc biệt nhất, tôi học được rất nhiều từ những con người ấy. Mariam có nói \"Đây là một kết thúc chính đáng của một cuộc sống được bắt đầu bằng những điều không chính đáng\", quả thực như vậy, cô đã đứng dậy và quyết định cuộc sống của mình, dù đó chỉ là một khoảnh khắc. Nhờ tác phẩm ấy, tôi lại càng thêm yêu cuộc sống này, yêu hòa bình, thấy hạnh phúc khi mình được sinh ra và đứng trên mảnh đất này, vì ngoài kia thế giới, biết bao nhiêu con người không được sống theo đúng cách của nó.\nĐó là tác phẩm tuyệt vời.", "status": "approved", "thank_count": 4, "score": 0.00397912, "new_score": 0.14102776, "customer_id": 5885500, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1556095358, "created_by": {"id": 5885500, "name": "Ngô Thị Thanh Tuyền", "full_name": "Ngô Thị Thanh Tuyền", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "purchased": true, "purchased_at": 1555080198, "contribute_info": {"id": 5885500, "name": "Ngô Thị Thanh Tuyền", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 9 năm", "total_review": 10, "total_thank": 5}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 8886008, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 8886007, "timeline": {"review_created_date": "2019-04-24 15:42:38", "delivery_date": "2019-04-17 08:36:16", "current_date": "2026-09-08 23:19:33", "content": "Đã dùng 7 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 7 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 20041762, "title": "Cực kì hài lòng", "content": "", "status": "approved", "thank_count": 0, "score": 27.77777778, "new_score": 0.15505046, "customer_id": 14418212, "comment_count": 1, "rating": 5, "images": [], "thanked": false, "created_at": 1733196131, "created_by": {"id": 14418212, "name": "Trần Long", "full_name": "Trần Long", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2019-10-13 08:50:59", "group_id": 8, "purchased": true, "purchased_at": 1729520995, "contribute_info": {"id": 14418212, "name": "Trần Long", "avatar": "//ti