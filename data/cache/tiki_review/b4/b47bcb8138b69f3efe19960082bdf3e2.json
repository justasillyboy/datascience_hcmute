egion": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2016-11-24 15:14:59", "group_id": 8, "purchased": true, "purchased_at": 1639964776, "contribute_info": {"id": 1917567, "name": "Nguyễn Thị Huyền Trang", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 10 năm", "total_review": 25, "total_thank": 0}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 106863965, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 106863963, "timeline": {"review_created_date": "2021-12-21 19:01:34", "delivery_date": "2021-12-21 17:26:04", "current_date": "2026-09-08 23:45:33", "content": "Đã dùng 2 giờ", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 2 giờ."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 13624334, "title": "Cực kì hài lòng", "content": "Một cuốn sách tâm lý hay. Nó giống 1 cuốn truyện trinh thám tập hợp nhiều vụ án khác nhau. Điểm cuốn hút là những câu chuyện này đều có thật ngoài đời. Nhưng cách suy luận tìm ra hung thủ của những nhà tâm lý mới thật sự ấn tượng. Đọc mà cuốn từng câu chữ. Cách họ hỗ trợ cảnh sát trong việc phá án giống ảo thuật gia vén tấm màn bí mật mà ai cũng đau đầu tìm kiếm.\n\nNhững kiến thức suy luận quý giá và góc nhìn tư duy của các mật vụ trong đây là những điều mà chỉ những cuốn sách chuyên ngành và chuyên sâu mới có. Có thể học đc chút gì đó của lĩnh vực này từ 1 cuốn sách phổ cập rộng ngoài thị trường là điều khiến tôi mến mộ ở tác giả Diệp Hồng Vũ. Và bản thân ông, với vài dòng giới thiệu sơ lược ở trang bìa, cũng mang nét bí ẩn hệt như phong vị của nó. \n\nHầu hết những tội phạm giết người khủng khiếp trong sách đều chịu ảnh hưởng tâm lý không nhỏ từ khi còn bé. Một thời gian dài chịu đựng những chấn thương không thể chữa lành về mặt tinh thần như vậy đã làm nảy sinh mầm ác quỷ trong mỗi con người. Chia sẻ của chuyên gia tâm lý cho chúng ta hiểu hơn rằng, không phải tự nhiên ai sinh ra cũng là ác quỷ mà chính cách họ nhận sự đối xử của người thân xung quanh mới là điều quan trọng nhất hình thành nên con người họ sau này. Hy vọng chúng ta có cái nhìn bao dung hơn và rộng tình yêu thương hơn để không 1 ác quỷ nào phải đc sinh ra. (***)", "status": "approved", "thank_count": 2, "score": 0.01322235, "new_score": 0.16144634, "customer_id": 5873528, "comment_count": 0, "rating": 5, "images": [{"id": 2846278, "full_path": "https://salt.tikicdn.com/ts/review/21/98/a1/16e1963a08c119e3a686bb373bcd028b.jpg", "status": "approved"}], "thanked": false, "created_at": 1638682652, "created_by": {"id": 5873528, "name": "Tống Đức Khải", "full_name": "Tống Đức Khải", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2017-10-06 15:15:45", "group_id": 8, "purchased": true, "purchased_at": 1632147020, "contribute_info": {"id": 5873528, "name": "Tống Đức Khải", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 9 năm", "total_review": 13, "total_thank": 142}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 106863965, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 106863963, "timeline": {"review_created_date": "2021-12-05 12:37:32", "delivery_date": "2021-09-26 10:37:27", "current_date": "2026-09-08 23:45:33", "content": "Đã dùng 2 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 2 tháng."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 16206584, "title": "Cực kì hài lòng", "content": "Sách bảo quản sách rất tốt, đóng gói cẩn thận. Từ bìa, trang đến gáy sách đều không bị móp hay rách, mỗi tội cái bookmark bị móp 😅", "status": "