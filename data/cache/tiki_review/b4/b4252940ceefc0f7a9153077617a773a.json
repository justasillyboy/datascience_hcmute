ất tiện lợi. Có nút để tắt đèn bàn phím và nút chuyển qua chế độ game. Khi ở chế độ game thì mặc định những nút như Windows hay nút chức năng như chuột phải sẽ không hoạt động. Nếu tải thêm phần mềm G-Hub thì còn có thể tùy chỉnh tắt thêm các nút khác, cũng như màu đèn, độ sáng hoặc tích hợp thêm chức năng khác cho các phím từ F1 tới F12. Khả năng tích hợp thêm chức năng là rất nhiều. \nBàn phím sử dụng cổng USB, dây dài và có bọc dù chống đứt gãy rất chắc chắn.", "status": "approved", "thank_count": 15, "score": 0.00361065, "new_score": 0.15382625, "customer_id": 7032905, "comment_count": 1, "rating": 5, "images": [{"id": 346527, "full_path": "https://salt.tikicdn.com/ts/review/54/1e/d0/73363b2c4e5791410434a1be349213e9.jpg", "status": "approved"}, {"id": 346528, "full_path": "https://salt.tikicdn.com/ts/review/d3/26/4c/8ebf30490d69a823372732e1bcd44b94.jpg", "status": "approved"}, {"id": 346529, "full_path": "https://salt.tikicdn.com/ts/review/f3/96/62/bb243f3bff494afa29d710a4d34cb823.jpg", "status": "approved"}, {"id": 346530, "full_path": "https://salt.tikicdn.com/ts/review/87/bb/e7/ffb599156864ce42ad6526cb44505346.jpg", "status": "approved"}, {"id": 346531, "full_path": "https://salt.tikicdn.com/ts/review/00/97/71/489c2c94a9443b33260444db05413ddb.jpg", "status": "approved"}], "thanked": false, "created_at": 1545038202, "created_by": {"id": 7032905, "name": "Phùng Xuân Tú", "full_name": "Phùng Xuân Tú", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2018-04-30 21:31:03", "group_id": 8, "purchased": true, "purchased_at": 1543804682, "contribute_info": {"id": 7032905, "name": "Phùng Xuân Tú", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 9 năm", "total_review": 44, "total_thank": 426}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 287425, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/se