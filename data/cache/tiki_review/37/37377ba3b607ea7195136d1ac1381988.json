{"stars": {"1": {"count": 13, "percent": 1}, "2": {"count": 8, "percent": 1}, "3": {"count": 21, "percent": 1}, "4": {"count": 161, "percent": 7}, "5": {"count": 1943, "percent": 90}}, "rating_average": 4.9, "reviews_count": 2146, "review_photo": {"total": 262, "total_photo": 395}, "data": [{"id": 14415698, "title": "Cực kì hài lòng", "content": "Tiki cần cải thiện dịch vụ đóng gói nhé. Trước đây mình rất thích cách đóng gói của tiki mà giờ càng ngày càng cẩu thả  =)) \nNội dung sách hay, giúp mình hiểu thêm nhiều điều về tình yêu. Có những điều khiến mình phải giật mình bừng tỉnh. Sách nói về tình yêu với gia đình, tình yêu đôi lứa và tình yêu đối với mọi thứ xung quanh. Sách có nhiều triết lí đáng suy ngẫm và cũng có nhiều điều trái với chúng ta nghĩ. Tuy nhiên, có lẽ là sách chép lại từ các buổi nói chuyện nên có khá nhiều chỗ lặp lại =)) Nhưng dù sao vẫn nên mua nha mọi người.", "status": "approved", "thank_count": 0, "score": 27.77777778, "new_score": 0.15912228, "customer_id": 18910702, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1641998222, "created_by": {"id": 18910702, "name": "Nguyễn Thu Hà", "full_name": "Nguyễn Thu Hà", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2020-10-17 16:53:21", "group_id": 8, "purchased": true, "purchased_at": 1640785357, "contribute_info": {"id": 18910702, "name": "Nguyễn Thu Hà", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 6 năm", "total_review": 6, "total_thank": 0}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 75307229, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 75307228, "timeline": {"review_created_date": "2022-01-12 21:37:02", "delivery_date": "2021-12-31 16:40:04", "current_date": "2026-09-08 12:51:50", "content": "Đã dùng 12 ngày