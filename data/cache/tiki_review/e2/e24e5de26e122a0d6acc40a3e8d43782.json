 1766038160, "badge": "https://salt.tikicdn.com/ts/review/05/6f/c0/d7462c4721ae3d6aabb2f51ff13fa44f.png", "status": 1, "is_reported": false}], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 14919846, "title": "Rất không hài lòng", "content": "Lần thứ 2 rồi, Tiki bọc hàng thiếu cẩn thận. Cho mỗi sách vào trong cái hộp giấy. Kết quả là trời mưa, hộp ngoài ướt rách, sách bên trong cũng bị ướt và ảnh hưởng đến chất lượng. Cần phải có lớp nilong ở ngoài mới đảm bảo được.", "status": "approved", "thank_count": 0, "score": 44.44444444, "new_score": 0.16595105, "customer_id": 5807518, "comment_count": 0, "rating": 1, "images": [{"id": 3123186, "full_path": "https://salt.tikicdn.com/ts/review/f3/be/1c/28a9c778949799941a78a6a878ad3daa.jpg", "status": "approved"}, {"id": 3123187, "full_path": "https://salt.tikicdn.com/ts/review/61/fe/b2/c31e99a60211b1e0f0de4b4443077ef9.jpg", "status": "approved"}, {"id": 3123188, "full_path": "https://salt.tikicdn.com/ts/review/5f/88/f6/f0078aa3d814203453d16cfd2ba776bf.jpg", "status": "approved"}], "thanked": false, "created_at": 1644659650, "created_by": {"id": 5807518, "name": "Đỗ Thị Nhật Minh", "full_name": "Đỗ Thị Nhật Minh", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2017-09-23 11:49:02", "group_id": 8, "purchased": true, "purchased_at": 1644403142, "contribute_info": {"id": 5807518, "name": "Đỗ Thị Nhật Minh", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 9 năm", "total_review": 3, "total_thank": 0}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 17336365, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 17336364, "timeline": {"review_created_date": "2022-02-12 16:54:10", "delivery_date": "2022-02-12 16:45:05", "current_date": "2026-09-08 12:52:13", "content": "Đã dùng 9 phút", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 9 phút."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 3130276, "title": "Sách giảm giá không có nghĩa chất lượng cũng giảm", "content": "- Sách bị cáu bẩn, móp gáy, nhiều trang sách đổi màu giấy như bị tồn kho, ẩm mốc lâu ngày\n- Không đăng ký Bookcare nhưng tự động cho vào đơn hàng,  ngoài ra bọc sách bị hỏng.\n\nĐây là lần thứ 2 trong vòng 03 ngày tôi gặp phải vấn đề đối với chất lượng sản phẩm của các bạn. Các bạn cần chú ý giúp chúng tôi mua hàng trên Tiki vì tin tưởng vào sản phẩm và dịch vụ của các bạn. Nhưng nếu các bạn tiếp tục chỉ tập trung giao hàng nhanh mà không kiểm tra chất lượng sản phẩm thì các bạn sẽ đánh mất niềm tin của chúng tôi. Các bạn nên hiểu rõ thị trường không chỉ có các bạn cung cấp những dịch vụ này.  Các bạn không nên để chúng tôi là khách hàng nghĩ rằng sản phẩm của các bạn có chiết khấu tức là chúng tôi sẽ phải nhận những sản phẩm tồn kho, kém chất lượng như thế này. Thực sự là sự không tôn trọng khách hàng từ phía các bạn. \nNgoài ra, tôi đăng ký dịch vụ Tikinow nhưng chất lượng sản phẩm và việc đổi trả thực hiện chậm trễ như vậy thì thực sự quá thất vọng.  Nhìn quyển sách trông như sách cũ mất luôn cả hứng đọc!!", "status": "approved", "thank_count": 102, "score": 0.00833444, "new_score": 0.15707359, "customer_id": 832772, "comment_count": 1, "rating": 1, "images": [{"id": 873153, "full_path": "https://salt.tikicdn.com/ts/review/41/ab/ff/961aefa8e7a896dabe9a35390dfb7116.jpg", "status": "approved"}, {"id": 873154, "full_path": "https://salt.tikicdn.com/ts/review/18/1e/9f/eac0381ab2d7b6e3ab8e522084266efc.jpg", "status": "approved"}, {"id": 873155, "full_path": "https://salt.tikicdn.com/ts/review/2f/e0/2c/d0361245d092e9c28ce1f329b4919873.jpg", "status": "approved"}], "thanked": false, "created_at": 1583810573, "created_by": {"id": 832772, "name": "Đàm Đức Dương", "full_name": "Đàm Đức Dương", "region":