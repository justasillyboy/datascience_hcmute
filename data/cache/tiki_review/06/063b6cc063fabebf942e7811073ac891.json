}, "delivery_rating": []}, {"id": 218831, "title": "Hay!", "content": "Bác Ánh mỗi lần xuất bản sách đều đem đến cho mình những điều thú vị mới , thật sự rất cám ơn.\r\nCó Hai Con Mèo Ngồi Bên Cửa Sổ thật sự là một tác phẩm đáng đọc. Mình thích không chỉ vì truyện hay, mà mình là một người yêu động vật, nhất là loài mèo/ Còn chuyện Mèo và chuột song hành cùng nhau như trong truyện  thì có phần hư cấu. Nhưng là truyện mà, mình thích những điều như vậy, mình cảm nhận được nét vui tươi trong từng câu chữ của bác Ánh, còn có cả những đoạn thơ vui vui nữa chứ. \r\nVề sách thì sách đẹp, giấy in chữ rõ ràng; tuyệt nhất là bìa sách, thật sự mình nhìn mãi không biết chán luôn.", "status": "approved", "thank_count": 0, "score": 0.00155666, "new_score": 0.11554584, "customer_id": 37970, "comment_count": 0, "rating": 4, "images": [], "thanked": false, "created_at": 1435676006, "created_by": {"id": 37970, "name": "hồ văn minh đức", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "purchased": true, "purchased_at": 1394289071, "rank": 3, "badge": "Bút sừng sỏi", "badge_icon": "https://vcdn.tikicdn.com/assets/img/review-badge/badge-3.png", "contribute_info": {"id": 37970, "name": "hồ văn minh đức", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 15 năm", "total_review": 168, "total_thank": 107}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 39001, "is_photo": false, "content_id": 218804, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 347334, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 7290302, "title": "Hài lòng", "content": "", "status": "approved", "thank_count": 0, "score": 27.77777778, "new_score": 0.12939615, "customer_id": 7025624, "comment_count": 0, "rating": 4, "images": [], "thanked": false, "created_at": 1611