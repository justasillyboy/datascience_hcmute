nh phúc khi được nhận sách. Mong cuốn sáng sẽ đến được với nhiều bạn đọc để cuộc sống đang sáng lên.\r\n\r\nTôi vô cùng biết ơn Mae Hường-Nhà văn Phan Việt. Mae vô cùng từ bi và dũng mãnh. Sự từ bi và dũng mãnh của Mae đã giúp chuyển hóa tôi thành một người tự tin, vui sống, bắt đầu nếm được hương vị của một đời sống sáng.", "status": "approved", "thank_count": 1, "score": 0.05369484, "new_score": 0.17936222, "customer_id": 12064355, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1737771002, "created_by": {"id": 12064355, "name": "Thu Hien PHAM", "full_name": "Thu Hien PHAM", "region": null, "avatar_url": "https://lh5.googleusercontent.com/-WU4B9haiHs0/AAAAAAAAAAI/AAAAAAAAAAA/ACHi3rcfWWaLMBDzceCl4NcKMpPIcGhNkg/mo/photo.jpg", "created_time": "2019-05-12 22:58:07", "group_id": 8, "purchased": true, "purchased_at": 1737688129, "contribute_info": {"id": 12064355, "name": "Thu Hien PHAM", "avatar": "https://lh5.googleusercontent.com/-WU4B9haiHs0/AAAAAAAAAAI/AAAAAAAAAAA/ACHi3rcfWWaLMBDzceCl4NcKMpPIcGhNkg/mo/photo.jpg", "summary": {"joined_time": "Đã tham gia 7 năm", "total_review": 2, "total_thank": 1}}}, "suggestions": [], "attributes": ["Mua từ nhà bán SÁNG BOOKS", "Loại bìa Màu Đỏ"], "product_attributes": ["Loại bìa: Màu Đỏ"], "spid": 276886801, "is_photo": false, "seller": {"id": 356985, "name": "SÁNG BOOKS", "logo": "https://vcdn.tikicdn.com/ts/seller/f4/e9/59/c8739ac713f9cddec62181e9c02a5937.jpg"}, "product_id": 276883579, "timeline": {"review_created_date": "2025-01-25 09:10:02", "delivery_date": "2025-01-24 12:59:12", "current_date": "2026-09-07 23:37:26", "content": "Đã dùng 1 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": [{"question": "Thời gian giao hàng?", "option": "Giao đúng hẹn"}, {"question": "Thái độ của shipper?", "option": "Lịch sự"}, {"question": "Giờ giao hàng?", "option": "Có hẹn giờ trước"}, {"question":