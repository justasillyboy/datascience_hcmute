": []}, {"id": 19928887, "title": "Cực kì hài lòng", "content": "Đặt sách ở tiki thì ko lo về đóng gói sách chỉnh chu rồi. Tất cả đều mới và bookmark vs phụ lục đều đẹp xỉu nhé, sách hơi dài nên mình để tủ lớn. Phần nội dung được booktok giới thiệu quá trời hay nên mình mong chờ. Mình có phần khó tính vs cũng ko hay đọc tình cảm nên thấy phần nd ổn áp. Đúng là câu từ rất thơ và cách xây dựng vô cùng hợp lý trong bối cảnh Hy Lạp cổ đại. Mình đánh giá là 4,5/5 nhe\r\n* mà hình như tiki ko đăng vd đc ạ 😅🥹 định đăng vd unbox mà ko bao giờ đc", "status": "approved", "thank_count": 1, "score": 0.00723473, "new_score": 0.18484612, "customer_id": 5648448, "comment_count": 1, "rating": 5, "images": [{"id": 4366689, "full_path": "https://salt.tikicdn.com/ts/review/80/74/2a/4d82296e74b5b266b74239e3a5284bde.jpg", "status": "approved"}, {"id": 4366690, "full_path": "https://salt.tikicdn.com/ts/review/9e/c2/b2/b21c10926e2243636d8dc247495bdb1e.jpg", "status": "approved"}, {"id": 4366691, "full_path": "https://salt.tikicdn.com/ts/review/1c/15/d5/7c424ced671ff4f0016fb8988cfc3af2.jpg", "status": "approved"}], "thanked": false, "created_at": 1721123262, "created_by": {"id": 5648448, "name": "Lê Thị Mỹ Linh", "full_name": "Lê Thị Mỹ Linh", "region": null, "avatar_url": "https://salt.tikicdn.com/cache/512x512/ts/avatar/d6/bb/80/4706e3ccb9eb3e7f140cfc26b95eaa09.png", "created_time": "2017-08-29 10:25:20", "group_id": 8, "purchased": true, "purchased_at": 1716607606, "contribute_info": {"id": 5648448, "name": "Lê Thị Mỹ Linh", "avatar": "https://salt.tikicdn.com/cache/512x512/ts/avatar/d6/bb/80/4706e3ccb9eb3e7f140cfc26b95eaa09.png", "summary": {"joined_time": "Đã tham gia 9 năm", "total_review": 35, "total_thank": 5}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 56609156, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 56609155, "timeline": {"review_created_date": "2024-07-16 16:47:42", "delivery_date": "2024-05-26 13:49:26", "current_date": "2026-09-07 23:39:10", "content": "Đã dùng 2 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 2 tháng."}, "comments": [{"id": 3226119, "review_id": 19928887, "commentator": "seller", "customer_id": 1, "fullname": "Tiki Trading", "avatar_url": "https://vcdn.tikicdn.com/ts/seller/d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg", "content": "Cảm ơn chị Linh đã tin tưởng Tiki và cho Tiki 5⭐️! Tiki yêu chị nhiều ❤️", "score": 0, "create_at": 1721195095, "badge": "https://salt.tikicdn.com/ts/review/05/6f/c0/d7462c4721ae3d6aabb2f51ff13fa44f.png", "status": 2, "is_reported": false}], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 6168041, "title": "Cực kì hài lòng", "content": "Công nhận là đỉnh. Mình phải khâm phục chị tác giả khi khéo léo kể lại câu chuyện Troy một cách vừa trung thành với Iliad với Thần thoại Hy Lạp và những dữ liệu nghiên cứu của những người cùng thời ghi chép lại cho đến ngày nay mà mình tìm hiểu được qua Wiki (như việc Achilles trong lúc đau khổ trước xác của Patroclus thì có buông lời trách móc cậu cũng được chị tác giả đưa vào có chọn lọc hơn). Đọc tác phẩm này của tác giả mình cảm thấy mọi chi tiết sự kiện và diễn biến tâm lý được chị nghiên cứu kỹ, sắp xếp, làm cho khớp và hợp tình hợp lý hơn thậm chí là đến mức mà mình thấy tuy là có sự hư cấu và can thiệp của thần linh nhưng đây mới đúng là những gì thật sự đã diễn ra. Phim Troy sản xuất năm 2004  đơn giản là xuyên tạc quá mức và không trung thành với những ghi chép và các tác phẩm cổ đại. Đọc mà mình cảm giác đang xem phim với rất nhiều đoạn thoại đáng nhớ. Mình thích nhất đoạn thoại giữa Patroclus và Briseis. Đọc mà thấy được cả câu thoại tiếng Anh hiện lên trong đầu và như thấy được diễn viên đang nói lên những câu thoại ấy. Cuốn sách này kiểu gì cũng sẽ được dựng thành phim sau này. Dù đã từng đọc và biết đến 2 tác phẩm kia nhưng quả thực tên các nhân vật khá dài và khó nhớ nên phải đọc một lúc mới định hình được các nhân vật trong câu chuyện. Tuy kể chuyện mượt mà mạch lạc nhưng nếu không tập trung thì cũng có thể thấy hơi rối và có gì đó mâu thuẫn giữa các tình tiết hay sự phát triển tính cách của các nhân vật, một phần cũng do tác giả không giải thích vội mà chỉ để lộ ra dần về sau. Đọc nó khiến mình không thể không liên tưởng đến phim truyền hình đình đám Spatarcus khi nó thành công trong việc cho người xem một góc nhìn mới về cái tạo nên một con người anh hùng hay một người vĩ đại, cái phi lý của chiến tranh và cái gọi là tình yêu thực sự là gì. Câu chuyện còn cho thấy những cái phù phiếm như cái đẹp và danh vọng có thể đưa ta đến những tai hoạ lớn thế nào ở khía cạnh cá nhân cũng như tập thể. Mình không thấy phải chê gì về chất lượng sách: sách dầy khổ to nhưng chữ in to rõ nét giấy nhẹ nên cầm đọc rất thoải mái và nhẹ. Gáy sách được đóng keo chắc chắn nên không bị bung. Bìa in nổi đẹp và cứng. Kèm theo cái kẹp sách rất hữu ích. Quyển phụ lục và phỏng vấn tác giả giúp mình nắm bắt câu chuyện và hiểu câu chuyện hơn. Tuy nhiên, mình thấy có một chỗ dịch hơi không được tự nhiên lắm như “Giờ con không còn dễ dàng từ bỏ như ngày xưa con đã từng.” Nên nếu được sau này mình sẽ tìm bản tiếng Anh đọc xem sao. Tóm lại đây không phải truyện đam mỹ mà còn hơn thế nữa. Nó thực sự xứng đáng nhận giải thưởng văn học và rất đáng đọc.", "status": "approved", "thank_count": 88, "score": 0.00431476, "new_score": 0.16798285, "customer_id": 1724984, "comment_count": 0, "rating": 5, "images": [{"id": 1368925, "full_path": "https://salt.tikicdn.com/ts/review/c4/fe/9d/5dae1ab807f713eca9dbb762a6928c2b.jpg", "status": "approved"}, {"id": 1368926, "full_path": "https://salt.tikicdn.com/ts/review/26/cc/a2/d1ba1a2f9f3fde26de5de309d4f4d237.jpg", "status": "approved"}, {"id": 1368927, "full_path": "https://salt.tikicdn.com/ts/review/ea/61/a0/5e2bd926603a55d82f7ff3e09a56448e.jpg", "status": "approved