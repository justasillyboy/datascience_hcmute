ng ngày tháng tuổi thơ của Ikal rồi khao khát được học đến cháy bỏng của Lingtang và Các Chiến Binh Cầu Vồng mới thấy đâu đó trên trái đất này vẫn còn rất nhiều số phận đến nghiệt ngã nhưng quan trọng là tinh thần vượt lên tất cả để vươn đến ước mơ. Tuy có hơi hụt hẫng khi kết truyện những thiên tài như Lingtang cuối cùng cũng đành phó mặc cho vòng xoay của cuộc đời vì miếng cơm manh áo nhưng vẫn rất cám ơn tác giả đã hoàn thành cuốn sách này. Đem đến cho đọc giả những câu chuyện rất ấn tượng về cuộc sống của những con người phi thường ở đảo Belitong. ❤️❤️❤️", "status": "approved", "thank_count": 1, "score": 0.00106657, "new_score": 0.14235989, "customer_id": 1562147, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1562575335, "created_by": {"id": 1562147, "name": "Nghĩa Hồ Trọng", "full_name": "Nghĩa Hồ Trọng", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2016-08-02 14:02:23", "group_id": 8, "purchased": true, "purchased_at": 1559790330, "contribute_info": {"id": 1562147, "name": "Nghĩa Hồ Trọng", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 10 năm", "total_review": 2, "total_thank": 1}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 974708, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 278275295, "timeline": {"review_created_date": "2019-07-08 15:42:15", "delivery_date": "2019-06-06 13:14:07", "current_date": "2026-09-08 23:20:29", "content": "Đã dùng 1 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 tháng."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 2262397, "title": "Một cuốn sách hay !", "content": "'' Chiến binh cầu vồng là câu chuyện có thật ở vùng quê nghèo Indonesia, nơi 10 đứa trẻ phải vật lộn với cuộc sống để được đến trường. Nhiều 