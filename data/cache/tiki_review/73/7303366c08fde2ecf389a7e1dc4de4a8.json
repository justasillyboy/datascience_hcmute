ating": 5, "images": [], "thanked": false, "created_at": 1586488798, "created_by": {"id": 495774, "name": "Thu Huyền", "full_name": "Thu Huyền", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2014-11-29 01:04:16", "group_id": 8, "purchased": true, "purchased_at": 1584457054, "contribute_info": {"id": 495774, "name": "Thu Huyền", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 12 năm", "total_review": 42, "total_thank": 6}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 974708, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 278275295, "timeline": {"review_created_date": "2020-04-10 10:19:58", "delivery_date": "2020-01-04 10:05:21", "current_date": "2026-09-08 23:20:29", "content": "Đã dùng 3 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 3 tháng."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 1998951, "title": "một tác phẩm hay nhất của Idonexia", "content": "tác phẩm là một câu truyện dài kể về sự nghèo khổ bao trùm đi những đứa trẻ tại bolitong-indonexi... chính cái nghèo đã khiến những đứa trẻ đầy thông minh và thiên tai (điển hình trong truyện là Liang-một cậu bé uyên thông tri thức và khao khát trở thành một giáo sư toán học) phải dừng bước trên con đường tri thức dẫn đến ước mơ của các em\n\"chiến binh cầu vồng\" còn là một tác phẩm kể về những người hết lòng vì nền giáo dục dù học biết họ chẳng có gì ngoài một sự nhiệt huyết dành cho sự nghiệp giáo dục nước nhà. Họ tình nguyện làm không lương và chấp nhận mọi thách thức từ xã hội uy quyền ủy lớn hiếp bé tại đất nước indonexia đương thời(điển hình trong truyện đó là cô Mus và thầy hiệu trưởng Hafan) \nĐặc biệt đây là tổng hợp những câu truyện có vui có buồn và có khi thật cảm động của 11 chiến binh cầu vồng-11 thành viên của lớp học và chắc chắn cái kết sẽ là một cái kết khiến bao người rơi nước mắt về cuộc đời đã đưa đẩy 11 chiến binh cầu vồng vào cái vòng lẫn quẩn của cuộc đời(có cả nước mắt hạnh phúc lẫn nước mắt buồn đau bạn nhé)", "status": "approved", "thank_count": 3, "score": 0.00100167, "new_score": 0.13894905, "customer_id": 7190932, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1546310642, "created_by": {"id": 7190932, "name": "Đặng Lê Viên", "full_name": "Đặng Lê Viên", "region": null, "avatar_url": "https://salt.tikicdn.com/cache/512x512/ts/avatar/ea/e7/a4/e2ab3b8a4d9f26f11bb18c7112fd8519.jpg", "created_time": "2018-05-26 12:41:58", "group_id": 8, "purchased": true, "purchased_at": 1543929833, "contribute_info": {"id": 7190932, "name": "Đặng Lê Viên", "avatar": "https://salt.tikicdn.com/cache/512x512/ts/avatar/ea/e7/a4/e2ab3b8a4d9f26f11bb18c7112fd8519.jpg", "summary": {"joined_time": "Đã tham gia 8 năm", "total_review": 2, "total_thank": 3}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 974708, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 278275295, "timeline": {"review_created_date": "2019-01-01 09:44:02", "delivery_date": "2018-12-11 13:27:50", "current_date": "2026-09-08 23:20:29", "content": "Đã dùng 1 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 tháng."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 1997188, "title": "Sách hay", "content": "bạn sẽ không biết được bạn tốt đến đâu khi biết được cuộc sống của những người trong tác phẩm, những giáo viên không lương, sự đối nghèo, sự ham học hỏi vươn lên , tài năng sẽ bị chôn vùi trong hoàn cảnh, gia đình, trách nhiệm, sự đối khổ... cuốn sách khá chân thật và ám ảnh t khi mỗi lần nhớ về 1 cậu bé chạy xe 40km bằng xe đạp bằng niềm đam mê tri thức. Cảm ơn chị Roise đã giới thiệu