": {"id": 1, "name": "Tiki Trading", "logo": "d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 184419723, "timeline": {"review_created_date": "2022-10-21 23:42:23", "delivery_date": "2022-10-18 14:44:39", "current_date": "2026-09-07 23:59:20", "content": "Đã dùng 3 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 3 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 20226405, "title": "Cực kì hài lòng", "content": "\"Lược sử loài ngoài\" là một cuốn sách khiến mình phải liên tục dừng lại để suy ngẫm. Tác giả dẫn dắt người đọc đi qua hành trình hàng trăm nghìn năm của loài người, từ những sinh vật nhỏ bé đến khi trở thành “kẻ thống trị” Trái Đất. Điều ấn tượng nhất là cách cuốn sách lý giải những khái niệm quen thuộc như tiền tệ, tôn giáo, quốc gia dưới góc nhìn rất mới mẻ và đôi khi khá táo bạo. Văn phong dễ đọc, nhiều ví dụ thú vị nên dù là sách lịch sử – khoa học vẫn không hề khô khan. Tuy nhiên, một số quan điểm có thể gây tranh cãi, đòi hỏi người đọc phải tự suy xét. Nếu bạn thích những cuốn sách mở rộng tư duy và đặt lại câu hỏi về thế giới mình đang sống, đây chắc chắn là lựa chọn đáng đọc.", "status": "approved", "thank_count": 0, "score": 0.17636684, "new_score": 0.18743683, "customer_id": 18383765, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1776059690, "created_by": {"id": 18383765, "name": "Mai Sam", "full_name": "Mai Sam", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2020-09-07 21:53:28", "group_id": 8, "purchased": true, "purchased_at": 1773208640, "contribute_info": {"id": 18383765, "name": "Mai Sam", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 6 năm", "total_review": 12, "total_thank": 2}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 184419726, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trad