urrent_date": "2026-09-08 23:21:52", "content": "Đã dùng 21 phút", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 21 phút."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 18876040, "title": "Cực kì hài lòng", "content": "Có những câu chuyện làm ta thấy vui vẻ, nhưng cũng có câu chuyện lặng lẽ lấy đi bao giọt nước mắt của người xem. Một câu chuyện về tuổi thơ của cậu bé, nhà rất nghèo nhưng tâm hồn không nghèo. Nơi cậu luôn toát ra những điều tốt đẹp nhất cho những người xung quanh, cả mầm cây ngọn cỏ. Mang 1 tâm hồn thiên sứ, cậu bé có thể giao tiếp với mọi thứ xung quanh, đặc biệt là cây cam ngọt, người bạn tri kỷ của cậu. Những nốt trầm trong câu chuyện là những lúc cậu giường như yếu đuối, gục ngã trước cuộc sống quá đỗi khó khăn, rồi cậu phải dần trưởng thành hơn, mạnh mẽ hơn bởi tình yêu thương của những thành viên trong gia đình và những người hàng xóm tốt bụng. Những ký ức trẻ thơ dần phai nhoà theo năm tháng, nhưng nó luôn được lưu lại trên những trang sách này. Yêu cây cam ngọt của tôi 🥰", "status": "approved", "thank_count": 0, "score": 33.33333333, "new_score": 0.16962068, "customer_id": 2219776, "comment_count": 0, "rating": 5, "images": [{"id": 4134976, "full_path": "https://salt.tikicdn.com/ts/review/0e/48/7f/bf0c88099634c65e7ba9be1120823f32.jpg", "status": "approved"}], "thanked": false, "created_at": 1677501082, "created_by": {"id": 2219776, "name": "Nguyễn Trần Anh", "full_name": "Nguyễn Trần Anh", "region": null, "avatar_url": "https://salt.tikicdn.com/cache/512x512/ts/avatar/a1/0d/54/6bd2b8328d2c2daf2558c5722812dbf8.png", "created_time": "2017-02-27 21:18:47", "group_id": 8, "purchased": true, "purchased_at": 1675654113, "contribute_info": {"id": 2219776, "name": "Nguyễn Trần Anh", "avatar": "https://salt.tikicdn.com/cache/512x512/ts/avatar/a1/0d/54/6bd2b8328d2c2daf2558c5722812dbf8.png", "summary": {"joined_time": "Đã tham gia 10 năm", "total_review": 12, "total_thank": 39}}}, "sugges