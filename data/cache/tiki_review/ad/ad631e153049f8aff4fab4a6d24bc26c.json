[], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 19827205, "title": "Hài lòng", "content": "Thiết kế miễn bàn nhưng chất lượng dịch thuật, dù biết Mai Sơn chuyển ngữ, chỉ biết nói là rất tệ. Bác có vẻ bối rối trong việc thống nhất hệ thống từ vựng (chỉ riêng với văn cảnh trong sách thôi chứ cần động chạm vào địa hạt chuyên ngành). Kết quả là nhiều đoạn, thậm chí nhiều câu, rất lủng củng: vế trước vừa diễn giải có phần máy móc còn lê thê không đáng, vế sau đã thấy phủ đầu bằng loạt từ vựng có tính khái quát cao và đòi hỏi độc giả phải có nền tảng triết học để hiểu. Rất buồn khi thấy tác phẩm duy nhất Jung dành cho đại chúng lại về Việt Nam theo cách này.", "status": "approved", "thank_count": 1, "score": 27.5, "new_score": 0.17390074, "customer_id": 108150, "comment_count": 1, "rating": 4, "images": [], "thanked": false, "created_at": 1711912440, "created_by": {"id": 108150, "name": "Bùi Hoàng", "full_name": "Bùi Hoàng", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2013-03-29 17:35:42", "group_id": 8, "purchased": true, "purchased_at": 1710401509, "contribute_info": {"id": 108150, "name": "Bùi Hoàng", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 14 năm", "total_review": 46, "total_thank": 25}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 210277882, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "21/ce/5c/b52d0b8576680dc3666474ae31b091ec.jpg"}, "product_id": 210277880, "timeline": {"review_created_date": "2024-04-01 02:14:00", "delivery_date": "2024-03-15 09:55:46", "current_date": "2026-09-07 23:47:18", "content": "Đã dùng 1 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 tháng."}, "comments": [{"id": 3172469, "review_id": 19827205, "commentator": "seller", "customer_id": 1, "fullname": "Tiki Trading", "avatar_url": "https://vcdn.tikicdn.com/ts/seller/d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg", "content": "Tiki cảm ơn những chia sẻ và góp ý từ anh. Thật tiếc khi nội dung sách chưa được như anh mong đợi. Rất hy vọng các tựa sách khác tại Tiki sẽ làm anh hài lòng hơn trong thời gian tới. Tiki cảm ơn anh Hoàng nhiều.", "score": 0, "create_at": 1712042098, "badge": "https://salt.tikicdn.com/ts/review/05/6f/c0/d7462c4721ae3d6aabb2f51ff13fa44f.png", "status": 2, "is_reported": false}], "vote_attributes": {"agree": ["chất lượng giấy tốt", "in ấn/màu sắc rõ nét"], "disagree": ["Nội dung sách hay, bổ ích và chính xác"]}, "delivery_rating": []}, {"id": 18966377, "title": "Hài lòng", "content": "Dịch thuật của dịch giả Mai Sơn dễ hiểu, bìa và giấy trang nhã. Cầm nhẹ nhàng. Lề hơi rộng, ảnh nhỏ. So với nguyên bản tiếng Anh \"Man and his symbols\" của Anchor Press (ISBN 0-385-***) thì in không đẹp bằng cả về màu, độ phân giải. Bản nước ngoài (có file pdf trên mạng) in ảnh tràn lề màu sắc tươi, hơn 300 trang. Bản CTY Nhã Nam xuất bản bố cục các trang gọn, song ảnh bị thu lại, màu hơi nhạt, giấy trắng, ảnh bé đi, giảm trải nghiệm của người đọc (số trang tăng lên thành 522 trang). \nVề nội dung thì cần nghiên cứu sâu hơn, mới đọc lướt nhưng cũng cảm nhận sơ sơ có nhiều giá trị trị thức, không chỉ là giải mã giấc mơ theo tác giả. Đã có một buổi giới thiệu do Cty Nhã Nam đã tổ chức (YouTube) nói về giá trị tác phẩm đem lại, cách tiếp cận...\nCuốn sách có lẽ rất hay, vì đã tái bản nhiều lần ở các nước. Cảm ơn Nhã Nam, chỉ tiếc là lần đầu ở Việt Nam với tôi có một số trải nghiệm chưa ưng ý. \nCarl G Jung là một tác giả, nhà khoa học có ảnh hưởng lớn về tâm lý học, các nghiên cứu của ông đã được ứng dụng trong điều trị tâm lý. Sách do ông viết có cách tiếp cận, vào đề rất gần gũi với độc giả (chưa bàn đến những từ ngữ học thuật chuyên ngành) kể cả bản tiếng Anh.", "status": "approved", "thank_count": 1, "score": 8.01587302, "new_score": 0.16694003, "customer_id": 8288502, "comment_count": 0, "rating": 4, "images": [], "thanked": false, "created_at": 1678955448, "created_by": {"id": 8288502, "name": "Bùi Nguyên Phương", "full_name": "Bùi Nguyên Phương", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2018-10-08 18:27:49", "group_id": 8, "purchased": true, "purchased_at": 1678087722, "contribute_info": {"id": 8288502, "name": "Bùi Nguyên Phương", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 8 năm", "total_review": 152, "total_thank": 26}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 210277882, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 210277880, "timeline": {"review_created_date": "2023-03-16 15:30:48", "delivery_date": "2023-03-07 18:07:04", "current_date": "2026-09-07 23:47:18", "content": "Đã dùng 9 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 9 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 20158737, "title": "Hài lòng", "content": "ok cho mọi người hay ngủ mơ", "status": "approved", "thank_count": 0, "score": 0.25542784, "new_score": 0.16502545, "customer_id": 30192990, "comment_count": 0, "rating": 4, "images": [{"id": 4412629, "full_path": "https://salt.tikicdn.com/ts/review/27/21/78/f2f2768c5d50eace914b0a2ce178ec7d.jpg", "status": "approved"}], "thanked": false, "created_at": 1755173065, "created_by": {"id": 30192990, "name": "Diên Thuận", "full_name": "Diên Thuận", "region": null, "avatar_url": "https://salt.tikicdn.com/cache/512x512/ts/avatar/4f/93/a9/44b367f81c8903a8af438dfeee7beb66.png", "created_time": "2024-11-02 09:26:39", "group_id": 8, "purchased": true, "purchased_at": 1755077298, "contribute_info": {"id": 30192990, "name": "Diên Thuận", "avatar": "https://salt.tikicdn.com/cache/512x512/ts/avatar/4f/93/a9/44b367f81c8903a8af438dfeee7beb66.png", "s