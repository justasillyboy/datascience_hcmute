ting": []}, {"id": 15699499, "title": "Cực kì hài lòng", "content": "Quả thực đây là cuốn sách theo mình là có lượng kiến thức về tâm lý học khá đồ sộ. Cuốn sách như đúng tên gọi của nó “Hiểu hết về tâm lý học”-sẽ bàn về mọi khía cạnh của tâm lý học. Từ các học thuyết đến các phương pháp trị liệu, từ các vấn đề cá nhân đến những ứng dụng thực tế. Trong sách cũng có một phần tổng hợp quá trình phát triển của tâm lý học khiến cho chúng ta có cái nhìn tổng quát nhất về lịch sử tâm lý học.\n\nCuốn sách với lượng kiến thức khủng khiến mình như bơi trong biển tri thức vậy nên mình không lựa chọn cách đọc truyền thống là đọc từ đầu đến cuối. Mình chỉ là cảm thấy thích chương sách, học phần nào thì sẽ đọc nó trước. Lật một trang sách bất kì là chúng ta đã có thể đón nhận một kiến thức vô cùng hấp dẫn rồi. Nhưng để có thể thấu hiểu một nội dung nào đó thì thiết nghĩ chúng ta cần phải tìm tòi và đọc chuyên sâu hơn vì trong sách chứa rất nhiều nội dung khác nhau, chỉ có thể khách quan các học phần mà sẽ không thể đi sâu hơn được.", "status": "approved", "thank_count": 2, "score": 0.60402685, "new_score": 0.1695671, "customer_id": 13081591, "comment_count": 0, "rating": 5, "images": [{"id": 3300975, "full_path": "https://salt.tikicdn.com/ts/review/59/30/f5/3d93f250c54d8599040baf6b5735031c.jpg", "status": "approved"}, {"id": 3300976, "full_path": "https://salt.tikicdn.com/ts/review/a4/0e/fb/a706f65df6ca78e33c7d6271c16be949.jpg", "status": "approved"}, {"id": 3300977, "full_path": "https://salt.tikicdn.com/ts/review/c0/ee/5d/bda73cb4d656ea9ebd6a05b0aeed4a62.jpg", "status": "approved"}], "thanked": false, "created_at": 1648723848, "created_by": {"id": 13081591, "name": "Trần Vũ Thu Hải", "full_name": "Trần Vũ Thu Hải", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2019-07-25 18:21:26", "group_id": 8, "purchased": true, "purchased_at": 1646870269, "contribute_info": {"id": 13081591, "name": "Trần Vũ Thu Hải", "avatar": "//tiki.vn/assets/img/avata