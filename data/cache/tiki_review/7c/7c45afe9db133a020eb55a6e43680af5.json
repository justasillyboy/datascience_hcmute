{"stars": {"1": {"count": 3, "percent": 1}, "2": {"count": 3, "percent": 1}, "3": {"count": 19, "percent": 4}, "4": {"count": 69, "percent": 14}, "5": {"count": 378, "percent": 80}}, "rating_average": 4.7, "reviews_count": 472, "review_photo": {"total": 20, "total_photo": 29}, "data": [{"id": 2098866, "title": "Giao hành nhanh, bảo vệ thông tin sản phẩm tốt", "content": "Tôi rất hài lòng về tiki lên đơn hàng nhanh chóng, đóng hộp ko ghi tên sản phẩm chỉ ghi tên người nhận, địa chỉ nhận nhàm giúp người mua yên tâm kín đáo tế nhị... Tiki còn cẩn thận đóng gói thêm màng xốp hơi để sản phẩm không bị xốc mạnh khi vận chuyển. Tôi đã từng mua nhiều sản phẩm của tiki phân phối đều rất hài lòng, không có vấn đề gì. Tôi mua đúng dịp Tiki khuyến mãi giảm giá ngày hội sinh nhật 9 tuổi của Tiki. Lần sau tôi nhất định mua thêm bên Tiki. Cảm ơn Tiki đã hỗ trợ và giao hàng nhanh...", "status": "approved", "thank_count": 16, "score": 0.00421511, "new_score": 0.15551318, "customer_id": 1670877, "comment_count": 0, "rating": 5, "images": [{"id": 391906, "full_path": "https://salt.tikicdn.com/ts/review/45/eb/d5/346a656c7b62c8c50fd30b5e5e49a3c1.jpg", "status": "approved"}, {"id": 391907, "full_path": "https://salt.tikicdn.com/ts/review/b8/ec/f9/1950cdab0720d3469b3bb38777de969c.jpg", "status": "approved"}, {"id": 391908, "full_path": "https://salt.tikicdn.com/ts/review/48/4e/65/b8afab02ac250d51800f322804f6b5c7.jpg", "status": "approved"}, {"id": 391909, "full_path": "https://salt.tikicdn.com/ts/review/ee/4a/02/55907957c23f78bda498aa37b120e3da.jpg", "status": "approved"}, {"id": 391910, "full_path": "https://salt.tikicdn.com/ts/review/bc/54/ee/bcfdca5d4cacdfd71ee30eb5f1e39f8c.jpg", "status": "approved"}], "thanked": false, "created_at": 1552967757, "created_by": {"id": 1670877, "name": "Binh", "full_name": "Binh", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2016-09-06 08:17:40", "group_id": 8, "purchased": true, "purchased_at": 1552808876, "contribute