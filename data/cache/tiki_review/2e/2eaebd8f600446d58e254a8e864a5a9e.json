{"stars": {"1": {"count": 3, "percent": 1}, "2": {"count": 1, "percent": 1}, "3": {"count": 3, "percent": 1}, "4": {"count": 31, "percent": 6}, "5": {"count": 502, "percent": 91}}, "rating_average": 4.9, "reviews_count": 540, "review_photo": {"total": 57, "total_photo": 74}, "data": [{"id": 18644969, "title": "Cực kì hài lòng", "content": "Nội dung hấp dẫn. Giao hàng nhanh.\r\nGóp ý Tiki Trading nên học hỏi dùng tấm nệm màu trắng giống Fahasaha để bảo vệ sách trước ghi cho vào hộp đóng gói!", "status": "approved", "thank_count": 3, "score": 0.0085588, "new_score": 0.17033924, "customer_id": 10977904, "comment_count": 0, "rating": 5, "images": [{"id": 4083399, "full_path": "https://salt.tikicdn.com/ts/review/4a/d2/0b/a8d1def8baadf076596616e806e42fd9.jpg", "status": "approved"}, {"id": 4083400, "full_path": "https://salt.tikicdn.com/ts/review/eb/ea/b9/603a89472026178f1235dd7552cf7a1f.jpg", "status": "approved"}, {"id": 4083401, "full_path": "https://salt.tikicdn.com/ts/review/cb/38/5d/a5d7200500ff86f75de8e9dd50ed291c.jpg", "status": "approved"}, {"id": 4083402, "full_path": "https://salt.tikicdn.com/ts/review/3a/4b/74/4bae75328cb4ce9240cb9c3ee0ca4abc.jpg", "status": "approved"}, {"id": 4083403, "full_path": "https://salt.tikicdn.com/ts/review/30/4d/b7/d83e4b67d523135e52565b7ca27ea3b1.jpg", "status": "approved"}], "thanked": false, "created_at": 1673785969, "created_by": {"id": 10977904, "name": "Thangnguyen", "full_name": "Thangnguyen", "region": null, "avatar_url": "https://s120.avatar.talk.zdn.vn/e/9/1/a/8/120/08d7fff1d5a0abc700eabf6a89fcd3ef.jpg", "created_time": "2019-02-21 15:55:25", "group_id": 8, "purchased": true, "purchased_at": 1697432939, "contribute_info": {"id": 10977904, "name": "Thangnguyen", "avatar": "https://s120.avatar.talk.zdn.vn/e/9/1/a/8/120/08d7fff1d5a0abc700eabf6a89fcd3ef.jpg", "summary": {"joined_time": "Đã tham gia 8 năm", "total_review": 169, "total_thank": 19}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 79672198, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "21/ce/5c/b52d0b8576680dc3666474ae31b091ec.jpg"}, "product_id": 79672197, "timeline": {"review_created_date": "2023-01-15 19:32:49", "delivery_date": "2023-01-15 13:30:46", "current_date": "2026-09-08 12:55:20", "content": "Đã dùng 6 giờ", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 6 giờ."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 13397799, "title": "Cực kì hài lòng", "content": "Cuốn sách tuy nhỏ bé, chỉ mất có vài tiếng ngắn ngủi để đọc nhưng lại khiến mình có được nhận thức rõ ràng hơn về sự may mắn. Cảm giác giống như được khai sáng một điều gì đấy mới mẻ vậy. Mình biết và tin rằng nó không chỉ thay đổi mình mà còn thấy đổi cả những người đọc nó nữa.\n \nĐọc xong mình biết được rằng may mắn cũng có hai loại. Một là may mắn từ trên trời rơi xuống, nghĩa là không làm mà cũng có ăn. Loại này thì thường kém bền, có tới 90% những người trúng xổ số đã phá sản hay quay về tình cảnh như trước trong chưa đầy mười năm kể từ khi trúng vé số. Hai là may mắn do chính chúng ta tạo. Có phải nhiều người sẽ thắc mắc tại sao lại như vậy đúng không?\n \n“Tình yêu không tự đến, cô đơn không tự đi”-may mắn cũng như vậy. Có nhiều người nhìn vào thành quả của ta và nói rằng: “Bạn thật may mắn quá đi”, hay chính chúng ta cũng lầm tưởng những gì mình đạt được đều do may mắn từ trên trời ban xuống. Nhưng ngẫm kĩ lại không phải là tất cả đều do sự cố gắng, nỗ lực, kiên trì của ta mà có hay sao?\n \nChỉ khi nhận ra điều này ta mới thấy trân trọng, yêu thương và ghi nhận chính bản thân mình để từ đó ta lạc quan, vui tươi hơn khi nhận ra giá trị mà mình đang tạo ra. Bằng lối văn ấn tượng, tác giả đã viết ra một câu chuyện thật kì bí, có sắc thái gợi nhớ đến những nhà giả kim, hiền triết xa xưa, dẫn dắt người đọc bước vào cuộc hành trình tìm kiếm cỏ bốn lá-biểu tượng cho sự may mắn đầy bí ẩn và lôi cuốn.\n \nHãy đọc và cảm nhận nếu bạn còn những thắc mắc như: “May mắn bắt nguồn từ đâu?”, “Làm thế nào để gặp được may mắn trong cuộc sống?”.... vì trong cuốn sách nhỏ mà có võ này, mọi nghi vấn đều được giải đáp. Có câu nói rất hay trong sách khiến mình tâm đắc: “Chúa không chơi xúc xắc với con người, may mắn do chính con người tạo ra.”", "status": "approved", "thank_count": 22, "score": 0.00369383, "new_score": 0.16748592, "customer_id": 13081591, "comment_count": 0, "rating": 5, "images": [{"id": 2796339, "full_path": "https://salt.tikicdn.com/ts/review/05/d4/72/37c752274c3df681491425f3acf7786b.jpg", "status": "approved"}, {"id": 2796340, "full_path": "https://salt.tikicdn.com/ts/review/74/5f/0e/0cbd246935d47fcfaa348b0f38b5db6a.jpg", "status": "approved"}, {"id": 2796341, "full_path": "https://salt.tikicdn.com/ts/review/5f/f2/4a/031476b2fbfab35d83eb81b59ee6c82d.jpg", "status": "approved"}], "thanked": false, "created_at": 1637716490, "created_by": {"id": 13081591, "name": "Trần Vũ Thu Hải", "full_name": "Trần Vũ Thu Hải", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2019-07-25 18:21:26", "group_id": 8, "purchased": true, "purchased_at": 1637119145, "contribute_info": {"id": 13081591, "name": "Trần Vũ Thu Hải", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 7 năm", "total_review": 11, "total_thank": 54}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 79672198, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 79672197, "timeline": {"review_created_date": "2021-11-24 08:14:50", "delivery_date": "2021-11-17 12:31:51", "current_date": "2026-09-08 12:55:20", "content": "Đã dùng 7 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 7 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 18037778, "title": "Cực kì h