: 5, "images": [], "thanked": false, "created_at": 1572576908, "created_by": {"id": 1219217, "name": "Hiệp Nguyễn", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "purchased": true, "purchased_at": 1568454587, "contribute_info": {"id": 1219217, "name": "Hiệp Nguyễn", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 11 năm", "total_review": 15, "total_thank": 2}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 750581, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 750578, "timeline": {"review_created_date": "2019-11-01 09:55:08", "delivery_date": "2019-09-20 07:31:33", "current_date": "2026-09-08 23:44:30", "content": "Đã dùng 1 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 tháng."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 2553371, "title": "Khi Hơi Thở Hóa Thinh Không", "content": "Mình thuộc team \"mít ướt\" nên khi đọc quyển này khóc không dưới 5 bận nhưng vẫn thích đọc.\n- Paul là một người rất văn minh, nhân văn và đáng được trân trọng hơn bao giờ hết.\n- Qua các trang sách của Paul ta không chỉ hiểu được sự phá của cái gọi là tế bào ung thư và quan trọng hơn hết đó là cái tâm người làm ngành y không chỉ ở chỗ kỹ thuật giỏi  để chữa bệnh cho bệnh nhân mà còn ở đạo đức của người hành nghề đối với bệnh nhân và thân nhân của họ.\n- Đối diện với cái chết là điều khủng khiếp nhất không phải ai ai cũng có được cách hành xử tốt đẹp như anh. Cầu mong anh được an lạc ở thế giới mới.", "status": "approved", "thank_count": 2, "score": 0.0031464, "new_score": 0.14432362, "customer_id": 1781790, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1571815548, "created_by": {"id": 1781790, "name": "Đặng Lệ Uyển", "full_name": "Đặng Lệ Uyển", "re