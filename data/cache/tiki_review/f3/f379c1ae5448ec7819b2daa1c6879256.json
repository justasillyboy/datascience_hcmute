y_rating": []}, {"id": 19905516, "title": "Cực kì hài lòng", "content": "Thói quen con người bắt người từ tín hiệu> thèm muốn > phần thưởng > thoả mãn. \r\nTừ đó để duy trì thói quen tốt cần phải tăng phần thưởng và thoả mãn, làm cho nó dễ xảy ra, để hạn chế thói quen xấu cần phải khiến phần thưởng và sự thoả mãn, làm cho nó khó xảy ra\r\nVí dụ như xem film, nhắn tin, lướt *** giúp ta thoả mãn tức thời ==> để làm cho nó khó xảy ra phải ngưng sử dụng điện thoại ==> tạo phần thưởng cho việc ngưng sử dụng điện thoại ví dụ như mỗi ngày không sử dụng điện thoại bạn bỏ 1 viên sỏi vào hộp không sử dụng điện thoại, bạn sẽ tháy vui khi bỏ mỗi viên sỏi mỗi ngày và một ngày nào đó hộp không sử dụng điện thoại bỗng đầy sỏi bạn sẽ cảm thấy thoả mãn\r\nCảm ơn tác giả James Clear đã chia sẻ về hành vi, thói quen của con người đến với độc giả thông qua sự nổ lực và kinh nghiệm của ông và những người hỗ trợ ông.", "status": "approved", "thank_count": 0, "score": 27.77777778, "new_score": 0.17533433, "customer_id": 29928390, "comment_count": 1, "rating": 5, "images": [], "thanked": false, "created_at": 1718757744, "created_by": {"id": 29928390, "name": "Apple User", "full_name": "Apple User", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2024-05-06 12:30:28", "group_id": 8, "purchased": true, "purchased_at": 1715758824, "contribute_info": {"id": 29928390, "name": "Apple User", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 2 năm", "total_review": 4, "total_thank": 1}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 170708234, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "21/ce/5c/b52d0b8576680dc3666474ae31b091ec.jpg"}, "product_id": 170708233, "timeline": {"review_created_date": "2024-06-19 07:42:24", "delivery_date": "2024-05-16 08:56:08", "current_date": "2026-09-07 23:38:18", "content": "Đã dùng 1 tháng", "explain": "Khi viết đán