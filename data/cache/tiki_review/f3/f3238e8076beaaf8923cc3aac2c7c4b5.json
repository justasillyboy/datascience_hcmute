ts/img/avatar.png", "created_time": "2021-01-31 00:49:45", "group_id": 8, "purchased": true, "purchased_at": 1709307846, "contribute_info": {"id": 20127477, "name": "châu lưu", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 6 năm", "total_review": 129, "total_thank": 7}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 10861844, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "21/ce/5c/b52d0b8576680dc3666474ae31b091ec.jpg"}, "product_id": 630777, "timeline": {"review_created_date": "2024-03-04 20:18:28", "delivery_date": "2024-03-04 13:22:14", "current_date": "2026-09-08 00:45:41", "content": "Đã dùng 7 giờ", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 7 giờ."}, "comments": [{"id": 3151699, "review_id": 19793634, "commentator": "seller", "customer_id": 1, "fullname": "Tiki Trading", "avatar_url": "https://vcdn.tikicdn.com/ts/seller/d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg", "content": "Tiki rất vui khi nhận được đánh giá 5⭐️từ bạn. Hy vọng bạn sẽ tiếp tục ủng hộ Tiki nha!", "score": 0, "create_at": 1709629439, "badge": "https://salt.tikicdn.com/ts/review/05/6f/c0/d7462c4721ae3d6aabb2f51ff13fa44f.png", "status": 2, "is_reported": false}], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 2300995, "title": "Cực kì hài lòng", "content": "Ôi cái dung tích kinh khủng khiếp luôn á.Cuộc đời mình hơn 17 nồi bánh chứng rồi mà chưa bao giờ mình thấy loại kem chống nắng nào to như vậy luôn.Nhìn hình tưởng nhỏ nhận hàng hết hồn luôn.Mình mua lại và thấy chai tận 70g mà loại kia có 30g hồi mình mua loại cũ thì tận 78k luôn mà này 70g mà có 120k.Rẻ kinh luôn ấy.Về chất lượng là không nói nhiều 5*.Đi biển hay đi chơi xa thoa lên là trắng á kiểu lên tone nhẹ(vì này là kem chống nắng vật lí mà).Mình còn 3 loại khác nữa của Sunplay là mình thành collector's sunplay luôn ấy ^^.Riêng mình thấy em này chống nắng rất rất tốt lên tone một chút cũng khá ổn.Sữa hơi đặc tí nhưng dễ tán.Một điểm trừ là em này rất nặng mặt! Nếu mà chỉ dùng sữa rửa mặt thôi thì chưa hẳn đã sạch được em này đâu cho dù có dùng all clear double W của Senka đi nữa mình cảm thấy vẫn rất là chưa sạch.Ngoài điểm này ra thì siêu tốt luôn.Ai hoạt động hè tình nguyện cắm trại đồ đó thoa lên là dùng gần nửa ngày rồi.Đỡ tốn công phải thoa lại trừ khi bị đổ mồ hôi nhiều hoặc đi bơi thì mình mới thoa lại thôi.Mình review em này trong my collection thôi nên mấy loại khác thì mỗi loại mình sẽ review kĩ hơn.Nhưng hiện tại mình vẫn chuộng nhất là sunplay clear white.Đơn giản là kết cấu như nước luôn thoa lên chỗ nào thấm liền chỗ đó.Kiềm dầu tốt( mình da dầu) + lên tone nhẹ về dưỡng trắng thì không rõ mình dùng nhiều sản phẩm dưỡng trắng trong đó có Melano *** của hãng nên da sáng lên.Nói chung là nên sắm đủ để thích nghi trong 1 năm luôn nha mọi người.Mình da dầu mụn nên xài hết hoàn toàn em sunplay acne clear rồi,còn clear white còn 1/5 thôi.Em acne clear kiềm dầu tốt + ngừa mụn mình dùng hết rồi mà không thâý giảm gì mấy.Luôn tin dùng SUNPLAY!!!", "status": "approved", "thank_count": 32, "score": 0.00251261, "new_score": 0.14571834, "customer_id": 7615999, "comment_count": 0, "rating": 5, "images": [{"id": 482172, "full_path": "https://salt.tikicdn.com/ts/review/66/97/49/71b82773d0b8814e76e41f557ae2bf3d.jpg", "status": "approved"}], "thanked": false, "created_at": 1562484753, "created_by": {"id": 7615999, "name": "Hoàng Triều", "full_name": "Hoàng Triều", "region": null, "avatar_url": "https://platform-lookaside.fbsbx.com/platform/profilepic/?asid=274168983171102&height=200&width=200&ext=1536378190&hash=AeStJ9tMuXwYcxhS", "created_time": "2018-08-09 10:44:16", "group_id": 8, "purchased": true, "purchased_at": 1562039635, "contribute_info": {"id": 7615999, "name": "Hoàng Triều", "avatar": "https://platform-lookaside.fbsbx.com/platform/profilepic/?asid=274168983171102&height=200&width=200&ext=1536378190&hash=AeStJ9tMuXwYcxhS", 