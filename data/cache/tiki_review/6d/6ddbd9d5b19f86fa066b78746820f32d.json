ions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 1002143, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 997535, "timeline": {"review_created_date": "2022-03-08 11:13:18", "delivery_date": "2022-03-08 11:02:09", "current_date": "2026-09-07 23:42:53", "content": "Đã dùng 11 phút", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 11 phút."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 14611895, "title": "Cực kì hài lòng", "content": "Mình đặt TikiNow, hàng được giao nhanh nên sách không bị vấn đề, phần dưới bìa ngoài thì hơn hằn và móp nhưng không sao, sách vẫn bình thường. Sách giao thì còn nguyên seal luôn. Font chữ khá dễ đọc, chất giấy trơn hơn giấy bình thường nên khá nhẹ và sờ khá thích.", "status": "approved", "thank_count": 1, "score": 0.00353894, "new_score": 0.17056335, "customer_id": 21989390, "comment_count": 0, "rating": 5, "images": [{"id": 3061560, "full_path": "https://salt.tikicdn.com/ts/review/89/2f/b1/b266af24fa7f501fefa01b2edbd82946.jpg", "status": "approved"}, {"id": 3061561, "full_path": "https://salt.tikicdn.com/ts/review/47/af/d9/462cde74d1fe986a6504887194450d03.jpg", "status": "approved"}, {"id": 3061562, "full_path": "https://salt.tikicdn.com/ts/review/d3/09/dd/af84dab212f3bd3b99be8de63a4c05ae.jpg", "status": "approved"}, {"id": 3061563, "full_path": "https://salt.tikicdn.com/ts/review/85/2b/fb/52ee279f7d2f6fd82e42fd4cd21f9162.jpg", "status": "approved"}], "thanked": false, "created_at": 1642766306, "created_by": {"id": 21989390, "name": "le dpkh", "full_name": "le dpkh", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2021-05-31 11:36:33", "group_id": 8, "purchased": true, "purchased_at": 1642755082, "contribute_info": {"id": 21989390, "name": "le dpkh", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 5 năm", "total_review": 1, "total_thank": 1}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 1002143, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 997535, "timeline": {"review_created_date": "2022-01-21 18:58:26", "delivery_date": "2022-01-21 16:54:59", "current_date": "2026-09-07 23:42:53", "content": "Đã dùng 2 giờ", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 2 giờ."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 18185778, "title": "Cực kì hài lòng", "content": "+ Tiki giao hàng rất nhanh, sách còn nguyên màng co bên ngoài nên khi giao đến không gặp hư hại gì. \r\n+ Nội dung sách: \r\n   Câu chuyện là mối tình lãng mạn nhưng đầy khắc khoải giữa chàng thiếu niên 17 tuổi - Elio với vị khách trọ, hơn cậu tới 7 tuổi - Oliver giữa khung cảnh mùa hè nước Ý tràn ngập ánh nắng ấm áp, cổ kính và rất đỗi nên thơ với hồ nước trong xanh, thảm cỏ rộng lớn, hay khu vườn đầy trái đào, mơ chín ửng và những triền đồi ngập hướng dương. Cuộc tình mùa hè của Oliver và Elio diễn ra thật vội vã, gấp gáp, kéo dài vỏn vẹn chỉ trong 6 tuần. Họ đã lao vào nhau như con thiêu thân bay vào biển lửa, mê đắm trong những cảm xúc dâng trào như thể đây mới là tình đầu của họ, yêu như chưa từng được yêu! Tác giả thật tài tình khi đã thể hiện thật tốt những xúc cảm trong tình yêu của những con người trẻ tuổi là phải thế: dạt dào, điên cuồng và thẳm sâu...\r\n\r\n   Với Elio, ngăn ánh sáng chiếu vào phòng là một tội ác, nhất là khi Elio không thể có được thứ ánh nắng đó suốt đời. Điều này cũng tương tự như việc cậu không thể có Oliver đến trọn đời. Phải chăng vì thế mà Elio thầm cầu nguyện: “Hãy để mùa hè đừng bao giờ kết thúc, hãy để anh ấy đừng bao giờ ra đi, hãy để tiếng nhạc cứ vang lên mãi mãi”. Thế nhưng theo vòng quay đều đặn, không ngừng của bánh xe thời gian, mùa hè nồng nhiệt trôi qua, Oliver đã ra khỏi căn nhà và đi ra hẳn cuộc đời Elio, nhưng trái tim họ dường như vẫn nán lại bên nhau. Mà trái tim sẽ không bao giờ bị “hoả thiêu trên giàn lửa”. \r\n\r\n   Và khi gấp lại những trang sách, tôi chợt nhận ra rằng, chuyện tình giữa 2 chàng trai ấy hoá ra cũng chẳng khác nào một giấc mộng đêm hè, vừa ngắn ngủi lại vừa nuối tiếc....\r\n\r\n   Với \"*** me by your name\", không tồn tại tình yêu vĩnh cửu mà chỉ có những giây phút vĩnh cửu của tình yêu!", "status": "approved", "thank_count": 5, "score": 0.01340372, "new_score": 0.17372284, "customer_id": 16777696, "comment_count": 0, "rating": 5, "images": [{"id": 3989250, "full_path": "https://salt.tikicdn.com/ts/review/38/03/31/081b55f3d7d20b8a88a6266552efca0e.jpg", "status": "approved"}, {"id": 3989251, "full_path": "https://salt.tikicdn.com/ts/review/1a/e7/e0/a2fe9c7a0624a34fb741e3412e92c254.jpg", "status": "approved"}, {"id": 3989252, "full_path": "https://salt.tikicdn.com/ts/review/3f/02/6b/3c09d21c262c641c0b809a847b829b1e.jpg", "status": "approved"}], "thanked": false, "created_at": 1668226997, "created_by": {"id": 16777696, "name": "Tuyết Phượng ", "full_name": "Tuyết Phượng ", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2020-03-12 17:26:35", "group_id": 8, "purchased": true, "purchased_at": 1668052957, "contribute_info": {"id": 16777696, "name": "Tuyết Phượng ", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 7 năm", "total_review": 13, "total_thank": 34}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 1002143, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "21/ce/5c/b52d0b8576680dc3666474ae31b091ec.jpg"}, "product_id": 997535, "timeline": {"review_created_date": "2022-11-12 11:23:17", "delivery_date": "2022-11-12 09:56:29", "current_date": "2026-09-07 23:42:53", "content": "Đã dùng 1 giờ", "explain": "Khi viết đánh giá, kh