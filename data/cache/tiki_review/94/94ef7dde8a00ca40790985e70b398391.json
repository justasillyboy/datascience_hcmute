{"stars": {"1": {"count": 1, "percent": 1}, "2": {"count": 1, "percent": 1}, "3": {"count": 5, "percent": 2}, "4": {"count": 22, "percent": 9}, "5": {"count": 205, "percent": 87}}, "rating_average": 4.8, "reviews_count": 234, "review_photo": {"total": 35, "total_photo": 55}, "data": [{"id": 20252179, "title": "Cực kì hài lòng", "content": "Vô thức con người là cái bí ẩn vì nó nằm ngoài sự kiểm soát của ý thức nhưng lại chi phối rất nhiều hành vi của chúng ta. Thấy được sự tương giao giữa chúng ta và vô thức là rất quan trọng để ta hiểu chính mình. Giấc mơ và các biểu tượng thể hiện nhiều điều mà vô thức muốn nói  với chúng ta. Đây là phần đặc sắc của tâm lý họ Jung. Sách đã cố gắng trình bày nguyên bản gốc với bố cục hợp lý", "status": "approved", "thank_count": 0, "score": 33.33333333, "new_score": 0.19257895, "customer_id": 15609890, "comment_count": 0, "rating": 5, "images": [{"id": 4430368, "full_path": "https://salt.tikicdn.com/ts/review/6f/ed/78/e5915376c6889c206f66893df1f907d4.jpg", "status": "approved"}], "thanked": false, "created_at": 1786202065, "created_by": {"id": 15609890, "name": "Tran Thuc", "full_name": "Tran Thuc", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2019-12-22 11:10:32", "group_id": 8, "purchased": true, "purchased_at": 1785886435, "contribute_info": {"id": 15609890, "name": "Tran Thuc", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 7 năm", "total_review": 9, "total_thank": 3}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 210277882, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 210277880, "timeline": {"review_created_date": "2026-08-08 22:14:25", "delivery_date": "2026-08-05 10:16:35", "current_date": "2026-09-07 23:47:20", "content": "Đã dùng 4 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 4 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": [{"question": "Thời gian giao hàng?", "option": "Giao đúng hẹn"}, {"question": "Thái độ của shipper?", "option": "Lịch sự"}, {"question": "Giờ giao hàng?", "option": "Có hẹn giờ trước"}, {"question": "Cách đóng gói sản phẩm?", "option": "Cẩn thận"}]}, {"id": 19411693, "title": "Cực kì hài lòng", "content": "Bản Dịch Rất Tệ\r\n\r\nĐánh giá 5 sao cho TiKi nhưng 1 sao cho cuốn sách này vì dịch quá tệ. Mình thấy của NXB Nhã Nam nên mua mà không suy nghĩ tìm hiểu quá nhiều nhưng đọc thì ôi thôi; không những dịch thiếu mạch lạc, còn dùng từ khó hiểu và sai chính tả nữa.", "status": "approved", "thank_count": 24, "score": 0.00380675, "new_score": 0.17403548, "customer_id": 491673, "comment_count": 2, "rating": 5, "images": [{"id": 4261081, "full_path": "https://salt.tikicdn.com/ts/review/d2/3a/0b/4a412e599ab36696eaf44c0f8accf282.jpg", "status": "approved"}, {"id": 4261082, "full_path": "https://salt.tikicdn.com/ts/review/c2/fc/31/4ae91f0369f7dea8d3c3853831b491f1.jpg", "status": "approved"}], "thanked": false, "created_at": 1690391215, "created_by": {"id": 491673, "name": "Bùi Thị Phương Liên", "full_name": "Bùi Thị Phương Liên", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2014-11-25 00:38:18", "group_id": 8, "purchased": true, "purchased_at": 1686027495, "contribute_info": {"id": 491673, "name": "Bùi Thị Phương Liên", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 12 năm", "total_review": 11, "total_thank": 43}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 210277882, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 210277880, "timeline": {"review_created_date": "2023-07-27 00:06:55", "delivery_date": "2023-