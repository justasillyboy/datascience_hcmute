": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 3285550, "title": "Cuốn sách dành cho thế hệ trẻ", "content": "Sách của bác Phan vốn không cần phải giới thiệu. Vẫn giọng văn bình dị kèm theo một câu chuyện dẫn xuyên suốt như thường lệ. Với nỗi niềm của người đi trước về việc băn khoăn của thế hệ trẻ trước con đường tương lai. \nHọc cái gì? Làm nghề gì? Sống như thể nào? để thành công, để hạnh phúc.\nCuốn sách dành cho những bạn trẻ còn đang băn khoăn trước ngưỡng cửa cuộc đời. Cũng dành cho những bạn đang vật lộn với cuộc sống ngày qua ngày, không ước mơ, không hạnh phúc.\nKhông phải làm nghề gì mà là làm như thế nào. Yêu đời, yêu người, yêu cuộc sống, trân trọng các giá trị. Cứ vô tư cho đi, xã hội sẽ không bạc đãi, sẽ ôm ấp cho mình đủ cơm ăn áo mặc. Sống vui, sống khỏe, sống có ích, còn gì tuyệt vời hơn nữa nhỉ?", "status": "approved", "thank_count": 0, "score": 0.2027575, "new_score": 0.14719807, "customer_id": 409555, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1585540443, "created_by": {"id": 409555, "name": "lê phương", "full_name": "lê phương", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "purchased": true, "purchased_at": 1584054604, "contribute_info": {"id": 409555, "name": "lê phương", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 12 năm", "total_review": 36, "total_thank": 25}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 32490133, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 32490132, "timeline": {"review_created_date": "2020-03-30 10:54:03", "delivery_date": "2020-03-13 11:47:41", "current_date": "2026-09-07 23:52:00", "content": "Đã dùng 1 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 tháng."}, "comments": [], "vote_at