{"stars": {"1": {"count": 2, "percent": 1}, "2": {"count": 3, "percent": 1}, "3": {"count": 2, "percent": 1}, "4": {"count": 48, "percent": 7}, "5": {"count": 569, "percent": 90}}, "rating_average": 4.9, "reviews_count": 624, "review_photo": {"total": 87, "total_photo": 115}, "data": [{"id": 14487873, "title": "Cực kì hài lòng", "content": "Tiki ship nhanh sách đến sớm. Rất vui vì mình đã dùng bookcare. Sách rất hay cho những ai chạy bộ hoặc đang bền bỉ chạy trên một con đường nào đó. Không chỉ về tinh thần thể thao, bác Haruki chia sẻ về những triết lý sống thông qua những cuốc chạy. Như một lời tâm sự từ thế hệ đi trước, các bạn trẻ nên đọc để thấy được góc nhìn của người từng trải và có được chiêm nghiệm cho riêng mình. Mọi người cũng nên trải nghiệm bộ môn chạy bộ, một vòng công viên, dọc cung đường biển là đủ để hiểu hơn về cuốn sách", "status": "approved", "thank_count": 20, "score": 0.00594622, "new_score": 0.17142972, "customer_id": 22573116, "comment_count": 0, "rating": 5, "images": [{"id": 3033690, "full_path": "https://salt.tikicdn.com/ts/review/64/c1/50/c9a06c7dfa46e8824a7f4c9620d1aaac.jpg", "status": "approved"}, {"id": 3033691, "full_path": "https://salt.tikicdn.com/ts/review/0e/0e/93/d37e9a886e6466a109ba2ce08d349e2f.jpg", "status": "approved"}, {"id": 3033692, "full_path": "https://salt.tikicdn.com/ts/review/31/d5/68/8a6378446d4dd195675416a4d224dea8.jpg", "status": "approved"}, {"id": 3033693, "full_path": "https://salt.tikicdn.com/ts/review/d2/4f/34/de4eb96a017066fc6dc776fb60da9bc8.jpg", "status": "approved"}], "thanked": false, "created_at": 1642300501, "created_by": {"id": 22573116, "name": "Phuong Nam", "full_name": "Phuong Nam", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2021-07-09 22:55:21", "group_id": 8, "purchased": true, "purchased_at": 1635130797, "contribute_info": {"id": 22573116, "name": "Phuong Nam", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 5 năm", "total_review": 50, "total_thank": 23}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 120219395, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "21/ce/5c/b52d0b8576680dc3666474ae31b091ec.jpg"}, "product_id": 120219394, "timeline": {"review_created_date": "2022-01-16 09:35:01", "delivery_date": "2021-10-30 11:55:06", "current_date": "2026-09-08 13:08:26", "content": "Đã dùng 3 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 3 tháng."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 20074612, "title": "Cực kì hài lòng", "content": "10 điểm cộng không có nhưng . Quyển đầu tiên đọc của tác giả , dù Rừng Na Uy rất nổi tiếng nhưng mình vẫn chưa đọc . Một quyển sách đề cập đến chuyện vận động , thể thao , cụ thể là đi bộ và một chút về ba môn phối hợp , nhưng không hề nhàm chán , thích lối sống mà tác giả đã chọn , nó rất hưởng thụ , kỉ luật và lành mạnh . Bên cạnh đó là những suy nghĩ , có chút triết lí về cuộc sống . Đọc thấy thư thả và suy ngẫm . Quyển này đọc xong thấy thư giãn hơn cả quyển Yêu những điều không hoàn hảo nữa . Bạn nào cần chút bình yên và tí động lực cuộc sống thì nên mua đọc nhé.", "status": "approved", "thank_count": 0, "score": 33.33333333, "new_score": 0.18251577, "customer_id": 1713089, "comment_count": 2, "rating": 5, "images": [{"id": 4395277, "full_path": "https://salt.tikicdn.com/ts/review/19/63/e9/3bf3038278ea653fe65b50788fa00409.jpg", "status": "approved"}], "thanked": false, "created_at": 1738555703, "created_by": {"id": 1713089, "name": "Anh Truc Anh", "full_name": "Anh Truc Anh", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2016-09-21 10:43:35", "group_id": 8, "purchased": true, "purchased_at": 1737256560, "contribute_info": {"id": 1713089, "name": "Anh Truc Anh", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 10 năm", "total_review": 115, "total_thank": 96}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 120219395, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 120219394, "timeline": {"review_created_date": "2025-02-03 11:08:23", "delivery_date": "2025-01-23 15:41:31", "current_date": "2026-09-08 13:08:26", "content": "Đã dùng 11 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 11 ngày."}, "comments": [{"id": 3304478, "review_id": 20074612, "commentator": "seller", "customer_id": 1, "fullname": "Tiki Trading", "avatar_url": "https://vcdn.tikicdn.com/ts/seller/d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg", "content": "Cảm ơn bạn đã tin tưởng Tiki và cho Tiki 5⭐️! Thật tuyệt vời khi Tiki có một khách hàng là bạn ❤️", "score": 0, "create_at": 1738928168, "badge": "https://salt.tikicdn.com/ts/review/05/6f/c0/d7462c4721ae3d6aabb2f51ff13fa44f.png", "status": 2, "is_reported": false}, {"id": 3303805, "review_id": 20074612, "commentator": "seller", "customer_id": 1, "fullname": "Tiki Trading", "avatar_url": "https://vcdn.tikicdn.com/ts/seller/d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg", "content": "Cảm ơn bạn đã tin tưởng Tiki và cho Tiki 5⭐️! Tiki yêu bạn nhiều ❤️", "score": 0, "create_at": 1738901319, "badge": "https://salt.tikicdn.com/ts/review/05/6f/c0/d7462c4721ae3d6aabb2f51ff13fa44f.png", "status": 2, "is_reported": false}], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 18886384, "title": "Cực kì hài lòng", "content": "Nếu bạn đang muốn tìm 1quyển sách tiếp thêm động lực sống, nhưng không giáo điều, không nặng nề, không to tác, không hướng hẹn suông thì có lẽ đây là lựa chọn thích hợp. Quyển sách chỉ đơn giản ghi lại trải nghiệm và suy nghĩ của tác giả trong quá trình chạy, lúc tham gia các cuộc thi marathon....nhưng qua đó ta có thể thấy nó không chỉ đúng khi chạy bộ mà còn đúng trong cuộc sống. Đan xen trong đó tác giả cũng nói đến những suy nghĩ và kinh nghiệm của bản thân với công việc tiểu thuyết gia.\r\n1 điều khiến tôi khá thích thú là tôi nhận ra rằng dù có là những người thành đạt, nổi tiếng, giàu có thì thật ra họ vẫn luôn có những suy nghĩ giống hệt chúng ta mà thôi. Vậy điều gì khiến họ khá chúng ta, tài năng, dũng cảm, quyết tâm, kiên trì, ...tự mình khám phá xem 😁\r\nSau khi đọc xong quyển sách không biết bạn có cảm thấy muốn bắt đầu chơi 1môn thể thao nào đó không? Không nhất thiết phải chạy bộ, bất kỳ môn nào cũng được chỉ cần bạn thích và phù hợp. Tôi nhớ tác giả đã viết nhiều người chạy không phải vì sống lâu hơn mà chỉ để tận hưởng cuộc sống. Đó là điều mà tôi muốn bây giờ.", "status": "approved", "thank_count": 18, "score": 0.00603201, "new_score": 0.17287638, "customer_id": 452351, "comment_count": 0, "rating": 5, "images": [{"id": 4137604, "full_path": "https://salt.tikicdn.com/ts/review/32/96/6f/705f90bf2bdfdc942907755829c87e43.jpg", "status": "approved"}, {"id": 4137605, "full_path": "https://salt.tikicdn.com/ts/review/5f/68/b7/31d4cd42bbc8372c050ad3853d6bb62b.jpg", "status": "approved"}], "thanked": false, "created_at": 1677673694, "created_by": {"id": 452351, "name": "Lê Ngọc Anh", "full_name": "Lê Ngọc Anh", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2014-10-17 09:54:54", "group_id": 8, "purchased": true, "purchased_at": 1674784625, "contribute_info": {"id": 452351, "name": "Lê Ngọc Anh", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 12 năm", "total_review": 15, "total_thank": 18}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 120219395, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 120219394, "timeline": {"review_created_date": "2023-03-01 19:28:14", "delivery_date": "2023-01-29 13:44:25", "current_date": "20