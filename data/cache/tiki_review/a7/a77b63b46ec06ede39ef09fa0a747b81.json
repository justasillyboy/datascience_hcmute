8, "commentator": "customer", "customer_id": 1267988, "fullname": "Phạm Thị Huyền", "avatar_url": "https://tiki.vn/assets/img/avatar.png", "content": "đúng là bạn ngoại lệ chứ hàng này được khuyến cáo ko nên sử dụng .vào kênh 14 coi nha bạn .chất tẩy mạnh lắm đó", "score": 0, "create_at": 1513392960, "badge": "", "status": 1, "is_reported": false}], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 1056486, "title": "Sữa rửa mặt tốt cho da dầu và mụn", "content": "Mình đã thử khá nhiều loại sửa rửa mặt nhưng chim ưng nhất là em này. Da mình thuộc da dầu, dễ bị mụn. Sau khi rửa mặt xong sẽ cảm thấy da rất khô thoáng, dễ chịu, có tác dụng làm trắng da tức thời (rửa mặt xong da sáng lên luôn ý, nhưng chỉ được một thời gian thôi nhưng rửa mặt xong nhìn da mình thay đổi luôn thấy rất thích ý) :)", "status": "approved", "thank_count": 1, "score": 0.00393845, "new_score": 0.13185234, "customer_id": 73478, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1512825091, "created_by": {"id": 73478, "name": "Đỗ Thảo Lan", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "purchased": true, "purchased_at": 1510469021, "contribute_info": {"id": 73478, "name": "Đỗ Thảo Lan", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 14 năm", "total_review": 39, "total_thank": 22}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 304132, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 568830, "timeline": {"review_created_date": "2017-12-09 20:11:31", "delivery_date": "2017-11-17 17:50:14", "current_date": "2026-09-08 13:54:59", "content": "Đã dùng 1 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 tháng."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": [