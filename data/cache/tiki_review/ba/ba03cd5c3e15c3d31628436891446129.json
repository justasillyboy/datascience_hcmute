ct_id": 91120169, "timeline": {"review_created_date": "2023-12-13 11:08:18", "delivery_date": "2023-12-13 10:58:33", "current_date": "2026-09-08 13:02:12", "content": "Đã dùng 10 phút", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 10 phút."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": [{"question": "Thời gian giao hàng?", "option": "Giao đúng hẹn"}, {"question": "Thái độ của shipper?", "option": "Lịch sự"}, {"question": "Giờ giao hàng?", "option": "Có hẹn giờ trước"}, {"question": "Cách đóng gói sản phẩm?", "option": "Cẩn thận"}]}, {"id": 12124989, "title": "Cực kì hài lòng", "content": "Bạn là một người hay nổi giận nhưng không biết vì sao? Bạn có mọi thứ trong tay nhưng vẫn không thấy hạnh phúc? Hay bạn không có một cuộc sống tinh thần lành mạnh\bbởi luôn bị dằn vặt bởi những điều nhỏ nhặt? Có lẽ bạn không biết rằng trong mình đang tồn tại một đứa trẻ từng bị tổn thương, chính sự tổn thương thời thơ ấu đã gây ảnh hưởng và tác động rất lớn đến cuộc sống của bạn dù cho bạn đã trưởng thành.\n\nĐây là cuốn sách tuyệt vời chứa đựng những nguyên nhân về sang chấn tâm lý tuổi thơ và cách thức chữa lành cho những tâm hồn bị tổn thương.\n\nNội dung của sách được biên tập rất rõ ràng theo từng mục bao gồm những hội chứng tâm lý mà một người có đứa trẻ bị tổn thương sẽ mắc phải. Sau đó là dẫn dắt độc giả qua từng giai đoạn tuổi phát triển và những tổn thương có thể xảy ra trong độ tuổi này. Xuyên suốt hành trình, tác giả đề cập đến nhìều kiến thức về sự phát triển của cơ thể người, cấu tạo của bộ não và những hành vi phản ứng liên quan. \n\nNếu bạn là một người đã và đang chịu tổn thương, bạn cũng có thể tự\btìm hiểu nỗi đau của bản thân thông qua các bảng câu hỏi và các bài trắc nghiệm và thực hành những bài tập chữa lành trong mỗi chương.\n\nTác giả là một nhà tâm lý học nên tất cả thông tin ông cung cấp đều rất xác thực và bổ ích. Đặc biệt hơn nữa, ông cũng là người từng có trải nghiệm về một tuổi thơ bị sáng chấn, thiếu thốn tình thương nên có sự đồng cảm nhất định và những tổn thương này. Ngoài ra, nhờ có khối lượng kiến thức lớn về thần học cũng như triết học nên kiến thức trong cuốn sách mang tính \"thiền\" chữa lành cao.\n\nCuốn sách này dành cho những ai đang phải trải qua nỗi đau tinh thần, đang nuôi dưỡng những đứa trẻ bị tổn thương trong tâm trí, những người làm giáo dục và cả các bậc cha mẹ,...\n\nTiki no.1, sách mới & sạch & đẹp, dịch những vẫn giao nhanh.", "status": "approved", "thank_count": 6, "score": 0.00487024, "new_score": 0.15987789, "customer_id": 7168186, "comment_count": 0, "rating": 5, "images": [{"id": 2490689, "full_path": "https://salt.tikicdn.com/ts/review/0c/47/4a/35efe8a4f4e3aa906453d665317a162c.jpg", "status": "approved"}], "thanked": false, "created_at": 1631025669, "created_by": {"id": 7168186, "name": "Harley Nguyễn", "full_name": "Harley Nguyễn", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2018-05-22 19:29:13", "group_id": 8, "purchased": true, "purchased_at": 1628511705, "contribute_info": {"id": 7168186, "name": "Lucy H", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 8 năm", "total_review": 126, "total_thank": 503}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 91120170, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 91120169, "timeline": {"review_created_date": "2021-09-07 21:41:09", "delivery_date": "2021-08-13 08:46:57", "current_date": "2026-09-08 13:02:12", "content": "Đã dùng 1 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 tháng."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 12404820, "title": "Cực kì hài lòng", "content": "Hài lòng!\nGiao hàng nhanh hơn dự kiến, hộp đựng bị rách nhưng không ảnh hưởng tới sách