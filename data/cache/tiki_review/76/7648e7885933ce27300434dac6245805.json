ơi nhỏ nên sẽ tốn thời gian hơn, bù lại cho kích thước nhỏ gọn của sản phẩm. \n6/ Ưu điểm: gọn nhẹ, tay cầm có đồ bọc nên rất êm tay.", "status": "approved", "thank_count": 6, "score": 0.00422355, "new_score": 0.14678511, "customer_id": 5447915, "comment_count": 0, "rating": 4, "images": [], "thanked": false, "created_at": 1583239596, "created_by": {"id": 5447915, "name": "Ramos Joseph Chau", "full_name": "Ramos Joseph Chau", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2017-07-07 20:02:30", "purchased": true, "purchased_at": 1583078790, "contribute_info": {"id": 5447915, "name": "Ramos Joseph Chau", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 9 năm", "total_review": 18, "total_thank": 22}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 2130485, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 2119169, "timeline": {"review_created_date": "2020-03-03 19:46:36", "delivery_date": "2020-03-03 15:08:51", "current_date": "2026-09-08 00:10:49", "content": "Đã dùng 5 giờ", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 5 giờ."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 20181786, "title": "Hài lòng", "content": "", "status": "approved", "thank_count": 0, "score": 27.77777778, "new_score": 0.16081985, "customer_id": 22328949, "comment_count": 0, "rating": 4, "images": [], "thanked": false, "created_at": 1760512548, "created_by": {"id": 22328949, "name": "Vũ Đình Tới", "full_name": "Vũ Đình Tới", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2021-06-23 07:37:31", "group_id": 8, "purchased": true, "purchased_at": 1760430398, "contribute_info": {"id": 22328949, "name": "Vũ Đình Tới", "avatar": "//tiki.vn/assets/img/avatar.png",