{"stars": {"1": {"count": 3, "percent": 1}, "2": {"count": 0, "percent": 0}, "3": {"count": 3, "percent": 1}, "4": {"count": 9, "percent": 5}, "5": {"count": 196, "percent": 93}}, "rating_average": 4.9, "reviews_count": 211, "review_photo": {"total": 41, "total_photo": 62}, "data": [{"id": 20216563, "title": "Cực kì hài lòng", "content": "Hàng về nhanh, sách vô cùng đẹp, seal căng bóng, nhưng bị móp hơi nặng góc tập 1, nhưng mua với giá này thì quá ổn rồi, mình thấy nhiều bạn mua sách cũng bị trường hợp như thế này, mình mong các bạn sẽ cải thiện, đây là một tác phẩm mình vô cùng yêu thích, có lẽ sẽ quay lại mua tập 3, cảm ơn và mong bên đội ngũ khắc phục tình trạng này ạ. Vì giá trị của sách không những là nội dung, mà còn là bìa ấn phẩm, dàn trang, bookmark, chất lượng giấy,.. và hơn cả là thái độ và sự tôn trọng của đội ngũ dành cho khách hàng và những người hâm mộ cuốn sách này ạ, Các bạn ấy cũng như mình, cũng hy vọng nhận về một tác phẩm trọn vẹn để trải nghiệm. Nên mình mong đội ngũ sẽ cải thiện vấn đề này hơn.", "status": "approved", "thank_count": 1, "score": 0.03549481, "new_score": 0.20169961, "customer_id": 30618237, "comment_count": 0, "rating": 5, "images": [{"id": 4422884, "full_path": "https://salt.tikicdn.com/ts/review/e5/9d/ae/67346a1871b35a5206419dc8f2f4afc5.jpg", "status": "approved"}, {"id": 4422885, "full_path": "https://salt.tikicdn.com/ts/review/24/27/39/f51e32909c01baf03cd7f8d8518f9b0b.jpg", "status": "approved"}, {"id": 4422886, "full_path": "https://salt.tikicdn.com/ts/review/74/32/4a/6ccb3df244df6d9075bfd9b6d9047b1f.jpg", "status": "approved"}, {"id": 4422887, "full_path": "https://salt.tikicdn.com/ts/review/f6/42/36/ea0e3bb40f17e336bca91fa15fd70ee9.jpg", "status": "approved"}, {"id": 4422888, "full_path": "https://salt.tikicdn.com/ts/review/58/62/b5/13692f8ac9016192775d9c27f53b2f92.jpg", "status": "approved"}], "thanked": false, "created_at": 1772511513, "created_by": {"id": 30618237, "name": "Bảo Ly", "full_name": "Bảo Ly", "region": nu