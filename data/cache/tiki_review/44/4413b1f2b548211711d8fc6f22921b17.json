x512/ts/avatar/28/32/6e/c4ae0aa5f0b071d96d490f6df2d799f4.png", "created_time": "2021-01-31 20:44:37", "purchased": true, "purchased_at": 1628434220, "contribute_info": {"id": 20139850, "name": "Phuong Linh", "avatar": "https://salt.tikicdn.com/cache/512x512/ts/avatar/28/32/6e/c4ae0aa5f0b071d96d490f6df2d799f4.png", "summary": {"joined_time": "Đã tham gia 6 năm", "total_review": 3, "total_thank": 1}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 3304877, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 3304875, "timeline": {"review_created_date": "2021-11-01 17:12:04", "delivery_date": "2021-08-15 12:01:03", "current_date": "2026-09-08 23:20:09", "content": "Đã dùng 3 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 3 tháng."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 4532653, "title": "Sách hay và chặt chẽ ??", "content": "Rất hay !!!\nMình thích những quyển sách có cốt truyện đan xen giữa quá khứ và hiện tại. Và quyển sách này của Keigo không những làm được điều đó, mà mọi chi tiết trong truyện đều logic, tất cả các nhân vật cứ ngỡ là có những câu chuyện khác nhau, song lại liên kết với nhau theo nhiều cách đặc biệt.\nVì sự liên kết đầy thú vị này mà khi đọc xong mình phải viết ra giấy liền các nhân vật đã liên quan tới nhau như thế nào hehe ?\nMà người dịch sách cũng ổn nữa, đọc ko bị sượng như một số sách Nhật được phiên dịch.\n\nÀ về phần chất lượng sách thì mình mua sách nhiều ở Tiki rùi, sách mới và chất lượng, giá lại rẻ, giao hàng cũng nhanh nữa. Cảm ơn Tiki!", "status": "approved", "thank_count": 1, "score": 0.13258821, "new_score": 0.15280899, "customer_id": 887672, "comment_count": 0, "rating": 5, "images": [{"id": 1139817, "full_path": "https://salt.tikicdn.com/ts/review/33/de/33/ad56c20a45f9366147025e4b7d907