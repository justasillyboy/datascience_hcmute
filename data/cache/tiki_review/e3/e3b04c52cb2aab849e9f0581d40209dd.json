fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 12377498, "timeline": {"review_created_date": "2022-03-09 19:30:47", "delivery_date": "2022-03-09 15:04:37", "current_date": "2026-09-07 23:52:09", "content": "Đã dùng 4 giờ", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 4 giờ."}, "comments": [{"id": 3041279, "review_id": 15336845, "commentator": "customer", "customer_id": 6715250, "fullname": "Nguyễn Phương Quỳnh", "avatar_url": "https://tiki.vn/assets/img/avatar.png", "content": "Quyển này bìa gập nên nó không có bao sách như các quyển khác bác ạ :3", "score": 0, "create_at": 1693832930, "badge": "", "status": 2, "is_reported": false}], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 19973596, "title": "Cực kì hài lòng", "content": "Cảm xúc khi đọc xong làm con người ta hụt hẫng và mang trong mình nỗi đau đáu, rằng vì cớ gì một người lại phải chịu quá nhiều nghiệt ngã.\r\n\r\nKết thúc không hạnh phúc chút nào, nhưng có lẽ đó là điều mà giúp người làm bố như bố cá gai cảm thấy yên lòng nhất.\r\nKỳ tích đã xảy ra, Daum (cá gai con) đã được cứu sống một cách thần kỳ mà người ta hay gọi là kỳ tích. Tuy nhiên, bố cá gai - người sống một đời vì cá gai con, cả thế giới chỉ quanh quẩn cùng con và làm mọi điều để có thể cứu con trở thành một đứa trẻ bình thường - thì ngược lại, người đã ra đi mãi mãi. Dẫu vậy, đây vẫn chưa phải là phân đoạn đau lòng nhất trong cuộc đời bố cá. \r\n\r\nBố con cá gai phải xa nhau, nhưng mãi đến phút cuối cùng bố cá đã giằng xé tâm can để cố gắng lạnh lùng mà không ôm cá gai con của mình lần cuối. \r\nCá gai con đã mãi đi xa bố mà theo mẹ về Pháp, dù có bao nhiêu cố gắng làm thoả yêu cầu của bố. Rằng phải tỏ vẻ thân thiện với mẹ, phải nghe lời mẹ, phải ngoan với mẹ, cá con đã làm tất cả những điều bố dặn chỉ để có một cơ hội cuối cùng rằng bố sẽ thay đổi ý định mà giữ cá con lại.\r\n\r\nBố cá gai thật là ngốc, và nếu không làm thế thì liệu còn phương án nào khác tốt hơn cho cá bố không?\r\nLiệu tình yêu có thể làm con người ta hy sinh đến mức nào?", "status": "approved", "thank_count": 0, "score": 27.77777778, "new_score": 0.17680327, "customer_id": 29627474, "comment_count": 1, "rating": 5, "images": [], "thanked": false, "created_at": 1725712758, "created_by": {"id": 29627474, "name": "Apple User", "full_name": "Apple User", "region": null, "avatar_url": "https://salt.tikicdn.com/cache/512x512/ts/avatar/97/1e/56/996165b113ec4a0e5c70a7ced3a99260.png", "created_time": "2023-11-27 10:03:34", "group_id": 8, "purchased": true, "purchased_at": 1725206693, "contribute_info": {"id": 29627474, "name": "Apple User", "avatar": "https://salt.tikicdn.com/cache/512x512/ts/avatar/97/1e/56/996165b113ec4a0e5c70a7ced3a99260.png", "summary": {"joined_time": "Đã tham gia 3 năm", "total_review": 3, "total_thank": 0}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 12377499, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 12377498, "timeline": {"review_created_date": "2024-09-07 19:39:18", "delivery_date": "2024-09-05 14:00:42", "current_date": "2026-09-07 23:52:09", "content": "Đã dùng 2 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 2 ngày."}, "comments": [{"id": 3248731, "review_id": 19973596, "commentator": "seller", "customer_id": 1, "fullname": "Tiki Trading", "avatar_url": "https://vcdn.tikicdn.com/ts/seller/d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg", "content": "Cảm ơn bạn đã tin tưởng Tiki trong suốt thời gian qua! Thật tuyệt vời khi Tiki có một khách hàng là bạn ❤️.", "score": 0, "create_at": 1725770911, "badge": "https://salt.tikicdn.com/ts/review/05/6f/c0/d7462c4721ae3d6aabb2f51ff13fa44f.png", "status": 2, "is_reported": false}], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 20231763, "title": "Cực kì hài lòng", "content": "Sách đc đóng gói cẩn thận \r\nNội dung