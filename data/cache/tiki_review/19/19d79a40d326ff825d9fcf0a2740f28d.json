uộc trốn chạy sang Pakistan, ông cho nó vào chiếc hộp, để vào ngực áo nơi cạnh tim đó là lòng yêu nước, khi ông nổi khùng lên trước đề nghị của tên lính Nga với người phụ nữ đạo hồi đang thút thít vì đó là sự đòi hỏi không phải là của con người, không tự trọng đó là tình người, là cái tôi lương thiện của gã đàn ông chân chính… Nếu có thể tôi chắc sẽ vẫn đọc lại cuốn sách này vài lần nữa!", "status": "approved", "thank_count": 11, "score": 0.00544137, "new_score": 0.15301686, "customer_id": 6443950, "comment_count": 1, "rating": 5, "images": [{"id": 1146922, "full_path": "https://salt.tikicdn.com/ts/review/03/bc/ff/6296b737de1e1162d845e3db266e250d.jpg", "status": "approved"}], "thanked": false, "created_at": 1598253050, "created_by": {"id": 6443950, "name": "best handsome", "full_name": "best handsome", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2018-02-02 13:15:53", "group_id": 8, "purchased": true, "purchased_at": 1597123601, "contribute_info": {"id": 6443950, "name": "best handsome", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 9 năm", "total_review": 11, "total_thank": 16}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 4781791, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 4780917, "timeline": {"review_created_date": "2020-08-24 14:10:50", "delivery_date": "2020-08-15 11:34:52", "current_date": "2026-09-08 23:17:28", "content": "Đã dùng 9 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 9 ngày."}, "comments": [{"id": 779182, "review_id": 4592905, "commentator": "customer", "customer_id": 589625, "fullname": "đinh ngân", "avatar_url": "https://tiki.vn/assets/img/avatar.png", "content