{"stars": {"1": {"count": 54, "percent": 1}, "2": {"count": 43, "percent": 1}, "3": {"count": 101, "percent": 1}, "4": {"count": 937, "percent": 7}, "5": {"count": 12393, "percent": 90}}, "rating_average": 4.9, "reviews_count": 13528, "review_photo": {"total": 2114, "total_photo": 3050}, "data": [{"id": 14057261, "title": "Hài lòng", "content": "Nội dung thì chưa đọc nhưng muốn đánh giá về cách gói hàng của tiki dạo này rất tệ. Ko hề có bọc bong bóng hay gì để giữ sách, trong khi ship thì hộp móp mèo làm sách bị gãy rất nhiều. Nhìn cuốn sách bị vậy thật sự rát xót và khó chịu. Nếu cách gói hàng của tiki vẫn như vậy khiến cuốn sách tới tay khách hàng không được nguyên vẹn thì chắc lần sau mình sẽ suy nghĩ có nên đặt trên tiki nữa hay không ấy. Mong tiki chú trọng khâu gói hàng hơn nữa.", "status": "approved", "thank_count": 0, "score": 38.88888889, "new_score": 0.16478597, "customer_id": 11924206, "comment_count": 0, "rating": 4, "images": [{"id": 2939804, "full_path": "https://salt.tikicdn.com/ts/review/2f/cf/53/db02be6ea30bc6da7affd60d7ed55cf9.jpg", "status": "approved"}, {"id": 2939805, "full_path": "https://salt.tikicdn.com/ts/review/de/3e/6b/ed28ad380ed6605981b732ba5ced5620.jpg", "status": "approved"}], "thanked": false, "created_at": 1640405913, "created_by": {"id": 11924206, "name": "Trần Phương Uyên", "full_name": "Trần Phương Uyên", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2019-05-01 12:55:38", "group_id": 8, "purchased": true, "purchased_at": 1639938154, "contribute_info": {"id": 11924206, "name": "Trần Phương Uyên", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 8 năm", "total_review": 1, "total_thank": 0}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 74021318, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_