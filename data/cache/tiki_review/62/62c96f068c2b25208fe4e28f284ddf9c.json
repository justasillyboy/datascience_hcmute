pg", "status": "approved"}, {"id": 1522423, "full_path": "https://salt.tikicdn.com/ts/review/98/f9/eb/be0165a0826b8ae44e381d88871dcabf.jpg", "status": "approved"}], "thanked": false, "created_at": 1611737729, "created_by": {"id": 19976975, "name": "Nguyen Jamie", "full_name": "Nguyen Jamie", "region": null, "avatar_url": "https://graph.facebook.com/v3.3/222600149495801/picture?type=large&return_ssl_resources=1", "created_time": "2021-01-21 07:30:36", "group_id": 8, "purchased": true, "purchased_at": 1611553398, "contribute_info": {"id": 19976975, "name": "Nguyen Jamie", "avatar": "https://graph.facebook.com/v3.3/222600149495801/picture?type=large&return_ssl_resources=1", "summary": {"joined_time": "Đã tham gia 6 năm", "total_review": 16, "total_thank": 21}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 68585577, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 68585576, "timeline": {"review_created_date": "2021-01-27 15:55:29", "delivery_date": "2021-01-26 13:07:33", "current_date": "2026-09-08 13:08:59", "content": "Đã dùng 1 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 ngày."}, "comments": [{"id": 948097, "review_id": 7293751, "commentator": "tikicare", "customer_id": 0, "fullname": "Tiki Care", "avatar_url": "https://salt.tikicdn.com/ts/ta/21/ce/5c/f3809056f0195db1a6295a50ac68ee0e.jpg", "content": "Mến chào bạn, Tiki đã nhận được nhận xét từ bạn đồng thời rất cảm ơn bạn đã dành thời gian chia sẻ cảm nhận về sản phẩm này cùng Tiki. Do mỗi người đọc sẽ có suy nghĩ và cảm nhận về nội dung sách theo các khía cạnh khác nhau, do vậy Tiki xin phép được ghi nhận những chia sẻ vừa qua từ bạn và rất mong sẽ sớm có các sản phẩm tiếp theo với nội dung phù hợp đến bạn hơn. Mến chúc bạn một ngày thật nhiều niềm vui. Các trường hợp về thông tin sản phẩm/đơn hàng bạn vui lòng liên hệ