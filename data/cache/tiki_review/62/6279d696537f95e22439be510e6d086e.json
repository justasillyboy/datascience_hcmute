ượng của sách, loại giấy này giá cao hơn giấy trắng và thời gian bảo quản cũng lâu hơn, sách trên Amazon cũng phổ biến với loại giấy này.", "score": 0, "create_at": 1557507252, "badge": "", "status": 1, "is_reported": false}], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 8254229, "title": "Rảnh hẳn đọc vì dày 700p", "content": "Như tóm tắt lại lịch sử kinh tế những năm 2000, công nghệ và ngôn ngữ chung (English) là 2 thứ quan trọng để làm việc và hợp tác xuyên quốc gia. Bây giờ đọc thì hơi trễ vì sách viết cũng được hơn 15 năm rồi.", "status": "approved", "thank_count": 0, "score": 27.77777778, "new_score": 0.14812435, "customer_id": 785450, "comment_count": 0, "rating": 3, "images": [], "thanked": false, "created_at": 1615177946, "created_by": {"id": 785450, "name": "Phan Terry", "full_name": "Phan Terry", "region": null, "avatar_url": "https://salt.tikicdn.com/cache/512x512/ts/avatar/e5/20/cc/b8f06e79ea7f1af8bbe51f0d370bbc7c.png", "created_time": "2015-08-31 09:14:34", "purchased": true, "purchased_at": 1605070030, "contribute_info": {"id": 785450, "name": "Terry Huân", "avatar": "https://salt.tikicdn.com/cache/512x512/ts/avatar/e5/20/cc/b8f06e79ea7f1af8bbe51f0d370bbc7c.png", "summary": {"joined_time": "Đã tham gia 11 năm", "total_review": 12, "total_thank": 9}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 7982627, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 7982626, "timeline": {"review_created_date": "2021-03-08 11:32:26", "delivery_date": "2020-11-12 12:49:05", "current_date": "2026-09-08 13:03:29", "content": "Đã dùng 4 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 4 tháng."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 9856426, "title": "Hài lòng", "content": "sách hơi cũ