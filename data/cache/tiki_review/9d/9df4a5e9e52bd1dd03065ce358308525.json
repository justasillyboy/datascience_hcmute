/ce/5c/b52d0b8576680dc3666474ae31b091ec.jpg"}, "product_id": 68585576, "timeline": {"review_created_date": "2023-01-04 23:19:36", "delivery_date": "2022-10-17 10:44:21", "current_date": "2026-09-08 13:08:56", "content": "Đã dùng 3 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 3 tháng."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 11699015, "title": "Rất không hài lòng", "content": "Đùa chứ gói hàng ko cẩn thận được chút, trong quá trình vận chuyển hàng kiểu gì chả quăng quật, chả ném qua ném lại hàng? Khách hàng biết điều đó ko, biết thừa ấy chứ. Nên khi mở gói hàng ra ko thấy có cái chống sốc là bực rồi. hay các bạn nghĩ sách thì nó ko vỡ đc? muốn ném thế nào thì ném?", "status": "approved", "thank_count": 5, "score": 0.02169554, "new_score": 0.16232839, "customer_id": 7900137, "comment_count": 0, "rating": 1, "images": [{"id": 2393990, "full_path": "https://salt.tikicdn.com/ts/review/ce/e5/14/04e8d7b80573deaf264d1f2127fef506.jpg", "status": "approved"}, {"id": 2393991, "full_path": "https://salt.tikicdn.com/ts/review/6f/97/9f/15874e06d99d91036e450aac2d72c2e4.jpg", "status": "approved"}], "thanked": false, "created_at": 1628481942, "created_by": {"id": 7900137, "name": "Nguyễn Đình Thực", "full_name": "Nguyễn Đình Thực", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2018-09-02 00:15:59", "group_id": 8, "purchased": true, "purchased_at": 1628362715, "contribute_info": {"id": 7900137, "name": "Nguyễn Đình Thực", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 8 năm", "total_review": 10, "total_thank": 8}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 68585577, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 68585576, "timeline": {"review_created_da