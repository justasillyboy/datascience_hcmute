{"stars": {"1": {"count": 0, "percent": 0}, "2": {"count": 0, "percent": 0}, "3": {"count": 0, "percent": 0}, "4": {"count": 0, "percent": 0}, "5": {"count": 18, "percent": 100}}, "rating_average": 5, "reviews_count": 18, "review_photo": {"total": 2, "total_photo": 3}, "data": [{"id": 20252541, "title": "Cực kì hài lòng", "content": "Sách mới nguyên seal.\r\nGiao rất hàng nhanh.\r\nGiá rất tốt.\r\nRất hài lòng.\r\n\r\nGiống như loài cá gai bố cô độc dành trọn đời và hơi thở cuối cùng để bảo vệ con rồi lặng lẽ ra đi, người cha đã hóa thành mây gió, âm thầm dõi theo và che chở cho Daum trên mọi nẻo đường cuộc đời.\r\nKhi thấu hiểu trọn vẹn tình phụ tử thiêng liêng ấy, Daum học được cách tha thứ, buông bỏ giận hờn, dũng cảm đối mặt với quá khứ để mở lòng yêu thương chính mình và thế giới.", "status": "approved", "thank_count": 0, "score": 0.12898471, "new_score": 0.19560753, "customer_id": 30721836, "comment_count": 0, "rating": 5, "images": [{"id": 4431520, "full_path": "https://salt.tikicdn.com/ts/review/65/e2/2b/a9782231c26111f0d87a4c0d872149cb.jpg", "status": "approved"}, {"id": 4431521, "full_path": "https://salt.tikicdn.com/ts/review/75/50/db/cbd0101aadb87e97ed64e3028685b4d4.jpg", "status": "approved"}], "thanked": false, "created_at": 1786337342, "created_by": {"id": 30721836, "name": "C N", "full_name": "C N", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2026-07-18 08:56:57", "group_id": 8, "purchased": true, "purchased_at": 1786184120, "contribute_info": {"id": 30721836, "name": "C N", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 2 tháng", "total_review": 4, "total_thank": 0}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 279063978, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 279063977, "timeline": {"review