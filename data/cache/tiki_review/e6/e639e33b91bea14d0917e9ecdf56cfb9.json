ôn, tiện cực kỳ. Rất rất là khoái và không tả được khi cầm, hơi buồn vì hết màu trắng nhưng nghĩ lại xài trắng có lẽ dễ bám bẩn hơn. Cực kỳ thích cái này ý.", "status": "approved", "thank_count": 8, "score": 0.00158978, "new_score": 0.1245949, "customer_id": 557371, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1478059948, "created_by": {"id": 557371, "name": "Bùi Thị Mỹ Vân", "full_name": "Bùi Thị Mỹ Vân", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2015-02-08 21:25:16", "purchased": true, "purchased_at": 1477968227, "contribute_info": {"id": 557371, "name": "Bùi Thị Mỹ Vân", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 12 năm", "total_review": 54, "total_thank": 349}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 122012, "is_photo": false, "content_id": 488308, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 122012, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 16724372, "title": "Cực kì hài lòng", "content": "", "status": "approved", "thank_count": 0, "score": 27.77777778, "new_score": 0.13859951, "customer_id": 22555733, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1655305457, "created_by": {"id": 22555733, "name": "thành nguyễn", "full_name": "thành nguyễn", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2021-07-08 21:41:20", "group_id": 8, "purchased": true, "purchased_at": 1651126410, "contribute_info": {"id": 22555733, "name": "thành nguyễn", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 5 năm", "total_review": 12, "total_thank": 0}}}, "suggestions": ["Chất lượng tốt"], "attributes": ["Mua từ nhà bán Tiki Trading", "Màu Đen"], "product_a