hiều từ vựng mới. Bìa sách thiết kế khá tốt, giấy tốt, không quá mỏng, nội dụng thì khỏi bàn cãi vì sách Collins hầu như là rất hay. Một cuốn sách rất đáng mua cho những ai có niềm đam mê anh văn và có khả năng tự học tốt.\r\nTiki giao hàng lại rất nhanh, uy tín , sách không bị hư hỏng chổ nào. Mình rất vừa ý và đang chuẩn bị mua thêm cuốn khác của Collins để luyện thi\r\n", "status": "approved", "thank_count": 9, "score": 0.0010083, "new_score": 0.11962851, "customer_id": 313333, "comment_count": 0, "rating": 4, "images": [], "thanked": false, "created_at": 1454487877, "created_by": {"id": 313333, "name": "lê nguyễn phúc khang", "full_name": "lê nguyễn phúc khang", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2014-03-22 09:32:30", "group_id": 8, "purchased": false, "purchased_at": null, "contribute_info": {"id": 313333, "name": "lê nguyễn phúc khang", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 13 năm", "total_review": 18, "total_thank": 10}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 107975, "is_photo": false, "content_id": 377810, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 405634, "timeline": {"review_created_date": "2016-02-03 15:24:37", "delivery_date": "2016-02-03 14:40:18", "current_date": "2026-09-08 13:07:17", "content": "Đã dùng 1 giờ", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 giờ."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 11375330, "title": "Hài lòng", "content": "Hài lòng", "status": "approved", "thank_count": 0, "score": 27.77777778, "new_score": 0.13327708, "customer_id": 12247326, "comment_count": 0, "rating": 4, "images": [], "thanked": false, "created_at": 1626948769, "created_by": {"id": 12247326, "name": "Lương Vũ", "full_name": "