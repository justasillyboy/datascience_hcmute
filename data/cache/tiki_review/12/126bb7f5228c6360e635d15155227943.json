a mục đích sống của loài người, một góc nhìn đầy lạc quan về cuộc sống bệnh nhân nơi bệnh viện. Đây là cuốn sách thứ 2 khiến tôi cảm thấy xúc động.", "status": "approved", "thank_count": 1, "score": 0.00473392, "new_score": 0.13367321, "customer_id": 556441, "comment_count": 0, "rating": 4, "images": [], "thanked": false, "created_at": 1521446439, "created_by": {"id": 556441, "name": "Nguyễn Đức Trung", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "purchased": true, "purchased_at": 1512851179, "contribute_info": {"id": 556441, "name": "Nguyễn Đức Trung", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 12 năm", "total_review": 19, "total_thank": 35}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 750581, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 750578, "timeline": {"review_created_date": "2018-03-19 15:00:39", "delivery_date": "2017-12-11 16:40:17", "current_date": "2026-09-08 13:03:53", "content": "Đã dùng 3 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 3 tháng."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 1266410, "title": "Ý nghĩa của cuộc đời", "content": "Hơi bất ngờ trong hoàn cảnh khó khăn tác giả lung lay vào niềm tin vào ông Trời, và buồn cho tác giả khi cuộc đời không như là mơ...nhưng đọc thấy được ý nghĩa của những việc làm mình yêu thích, lúc khó khăn gia đình là chổ dựa cuối cùng, đỉnh cao của sự nghiệp không bằng tình cảm của gia đình", "status": "approved", "thank_count": 1, "score": 0.0046281, "new_score": 0.13346938, "customer_id": 5451821, "comment_count": 0, "rating": 4, "images": [], "thanked": false, "created_at": 1520481357, "created_by": {"id": 5451821, "name": "Nguyen truong Giang", "region": null, "avatar_url": "//tiki.vn/assets/i