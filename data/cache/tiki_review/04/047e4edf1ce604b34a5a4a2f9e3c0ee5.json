{"stars": {"1": {"count": 1, "percent": 12}, "2": {"count": 0, "percent": 0}, "3": {"count": 0, "percent": 0}, "4": {"count": 0, "percent": 0}, "5": {"count": 7, "percent": 88}}, "rating_average": 4.5, "reviews_count": 8, "review_photo": {"total": 3, "total_photo": 6}, "data": [{"id": 20019318, "title": "Cực kì hài lòng", "content": "Mình nhận được hàng nhanh hơn so với dự kiến. Hộp mực đúng loại, hàng đóng gói chỉnh chu, chất lượng mực in rõ nét, đồng đều, không lem mực, mực bền, gôm tẩy không ảnh hưởng chữ. So với giá đem hộp mực đi bơm thì mua hộp mới ngang giá, vậy nên mình thấy mua mới lợi hơn.", "status": "approved", "thank_count": 0, "score": 44.44444444, "new_score": 0.18675352, "customer_id": 468300, "comment_count": 1, "rating": 5, "images": [{"id": 4385539, "full_path": "https://salt.tikicdn.com/ts/review/df/08/ab/291bcaca89a301497c4331872a845fdf.jpg", "status": "approved"}, {"id": 4385540, "full_path": "https://salt.tikicdn.com/ts/review/a0/a6/5b/73858fcf226402449262c3890bb67a98.jpg", "status": "approved"}, {"id": 4385541, "full_path": "https://salt.tikicdn.com/ts/review/4f/da/cf/90f67438e95d2c41946573717f7e9963.jpg", "status": "approved"}], "thanked": false, "created_at": 1730211959, "created_by": {"id": 468300, "name": "Nguyễn Phương Yến Nhi", "full_name": "Nguyễn Phương Yến Nhi", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2014-11-04 14:05:29", "group_id": 8, "purchased": true, "purchased_at": 1729929980, "contribute_info": {"id": 468300, "name": "Nguyễn Phương Yến Nhi", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 12 năm", "total_review": 81, "total_thank": 28}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Danh Shop"], "product_attributes": [], "spid": 87393333, "is_photo": true, "seller": {"id": 133440, "name": "Danh Shop", "logo": "ba/d6/3a/6354d3044f7aaaf51eb767b03fe320b1.jpg"}, "product_id": 87393332, "timeline": {"review_created_date": "2024-10-29 21:25:59", "delivery_date": "2024-10-29 16:17:47", "current_date": "2026-09-08 12:29:48", "content": "Đã dùng 5 giờ", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 5 giờ."}, "comments": [{"id": 3279864, "review_id": 20019318, "commentator": "seller", "customer_id": 133440, "fullname": "Danh Shop", "avatar_url": "https://vcdn.tikicdn.com/ts/seller/ba/d6/3a/6354d3044f7aaaf51eb767b03fe320b1.jpg", "content": "Danhshop cảm ơn bạn đã tin tưởng và ủng hộ shop ạ!", "score": 0, "create_at": 1731294054, "badge": "https://salt.tikicdn.com/ts/review/05/6f/c0/d7462c4721ae3d6aabb2f51ff13fa44f.png", "status": 2, "is_reported": false}], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 18447294, "title": "Cực kì hài lòng", "content": "Trước dùng hộp mực 12A của Saha thấy ok nên lần này chọn tiếp hộp mực saha cho máy brother. In 500 trang thấy khá ổn. Nhìn qua ko khác mấy hàng chính hãng nhưng nhìn kĩ vẫn kém hàng chính hãng về độ nét, sự sắc nét của nét chữ. Tuy nhiên với giá 130k so với 450k của chính hãng thì là quá tốt rồi. \r\nMặc dù hộp mực chính hãng còn mực nhưnh vẫn dùng hộp này in chính vì có lỗ đổ mực thuận tiện khi đổ mực hơn. \r\nMột điểm khá hay của máy brother là gần như ko có mực thải nên chỉ việc đổ mực và dùng, ít khi phải quan tâm đến mực thải như máy của canon, nhất là canon 2900 rất nhanh đầy mực thải, một sự lãng phí và gây ô nhiễm môi trường. Hơn nữa cụm trống và hộp mực tách rời nên có thay thế không cần bỏ hết. Hỏng bộ phận nào thay bộ phận đó.\r\nVề độ bền thì tạm thời mới dùng nên chưa thể đánh giá. Hi vọng in được tầm  4 lần đổ mực là ok. \r\nMột điều mình thấy khá lạ là canon 2900 giá giờ cũng 4 triệu, in chậm và ồn. Trong khi máy brother giá cũng tương đương, khá bền, in nhanh, in đc hai mặt nhưnh người ta vẫn mua 2900 khá nhiều.", "status": "approved", "thank_count": 0, "score": 27.77777778, "new_score": 0.16530931, "customer_id": 148734, "comment_count": 1, "rating": 5, "images": [], "thanked": false, "created_at": 167129