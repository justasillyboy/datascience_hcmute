ô bị hội Shota cướp trước khi 3 đứa vào tiệm Namiya.\n- Hồi 10,11: 13/9/2012 của hội Shota, tiếp nối thới gian của hồi 1 và giải thích lý do 3 đứa vào cướp nhà Harumi.", "score": 0, "create_at": 1665942118, "badge": "https://salt.tikicdn.com/ts/reviews/1a/c6/8e/aed2b9016c8a2840ea0d9268605c8d3c.png", "status": 2, "is_reported": false}, {"id": 2389258, "review_id": 15371123, "commentator": "customer", "customer_id": 6200321, "fullname": "NGOC NHU NGUYEN", "avatar_url": "https://tiki.vn/assets/img/avatar.png", "content": "Nếu bạn đọc được bình luận này mình mong bạn rep giúp nhé. Mình vừa đọc xong quyển này, quả thật là rất lôi cuốn, nhưng có 1 điểm mình vẫn chưa thông từ chỗ 3 người bạn tư vấn cho *** nhỏ lạc lối, về mặc thời gian mình chưa nắm bắt được. Cám ơn bạn nhé.", "score": 0, "create_at": 1653739699, "badge": "https://salt.tikicdn.com/ts/reviews/b0/77/a5/1dc3901bd48bfc65a51760dc051ebbdb.png", "status": 2, "is_reported": false}], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}], "paging": {"total": 4402, "per_page": 20, "current_page": 2, "last_page": 221, "from": 21, "to": 40}, "sort_options": [[{"label": "Hữu ích", "value": "score|desc"}, {"label": "Mới nhất", "value": "id|desc"}, {"label": "Có hình ảnh", "value": "has_image"}], [{"label": "Tất cả khách hàng", "value": "customer|all"}, {"label": "Khách đã mua hàng", "value": "bought"}], [{"label": "Tất cả sao", "value": "stars|all"}, {"label": "5 sao", "value": "stars|5"}, {"label": "4 sao", "value": "stars|4"}, {"label": "3 sao", "value": "stars|3"}, {"label": "2 sao", "value": "stars|2"}, {"label": "1 sao", "value": "stars|1"}, {"label": "Hài lòng", "value": "stars|4|5"}, {"label": "Chưa hài lòng", "value": "stars|1|2|3"}]], "exclude_image": false, "attribute_vote_summary": {"product_id": 3304875, "seller_id": 1, "number_of_vote_to_show": 20, "votes": [{"attribute_id": "mui_sach_thom_de_chiu", "attribute_name": "Mùi sách thơm, dễ chịu", "total_vote": 11, "agree": 10, "disagree": 0, 