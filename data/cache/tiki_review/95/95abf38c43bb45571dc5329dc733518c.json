oduct_attributes": [], "spid": 3304877, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 3304875, "timeline": {"review_created_date": "2020-10-28 07:51:22", "delivery_date": "2020-10-27 15:59:04", "current_date": "2026-09-08 12:44:46", "content": "Đã dùng 1 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 3387796, "title": "Hài lòng", "content": "Cuốn sách là cuộc du hành ngược thời gian trở về quá khứ của 3 chàng trai sau một lần đang trốn chạy sau khi ăn trộm. Câu chuyện được diễn ra tại một tiệm tạp hóa tên là \"Namiya\".\nVới mình đây là một cuốn sách hay, điều đó không thể phủ nhận. Nó lôi cuốn mình khiến mình phải đọc liền tù tì để xem điều gì sẽ xảy ra tiếp theo. Nhưng nó lại không phải cuốn sách khiến mình sẽ đọc lại nhiều lần. Nhưng điều kì diệu là khi ngồi đây và viết những dòng này, tức là đã cách rất nhiều tháng khi mình đọc xong. Thế nhưng, những chi tiết trong câu chuyện vẫn in sâu trong mình và cứ được hiện ra từ từ.\nĐiều mình thích nhất trong cuốn sách này, và có lẽ mình đã áp dụng nó vài lần.\n\"Khi có ai đó xin bạn lời khuyên, thì khi đó thật ra họ đã có câu trả lời rồi. Họ chỉ hỏi ý kiến để mong có thể nhận được sự đồng cảm của người khác. Vì vậy, điều bạn cần làm là trả lời một cách thật lòng, còn lại quyết định là do họ, bạn sẽ chẳng thể ép buộc.", "status": "approved", "thank_count": 6, "score": 0.00231892, "new_score": 0.14751539, "customer_id": 1177314, "comment_count": 0, "rating": 4, "images": [], "thanked": false, "created_at": 1586696834, "created_by": {"id": 1177314, "name": "Đặng thị Huệ", "full_name": "Đặng thị Huệ", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2016-02-22 15:27:34", "group_id": 8, "purchased": true, "purchased_at": 1567576038, "contribute_in