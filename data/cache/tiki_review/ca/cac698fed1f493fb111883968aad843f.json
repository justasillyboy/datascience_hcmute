o (như mình) đọc chỉ có quắn quéo vì quá cute. Lâu lâu đọc vài quyển như thế này cảm thấy như được gột rửa những muộn phiền trong tâm hồn, đắm chìm trong một thế giới tươi mới, bình yên và tràn ngập yêu thương, rất có giá trị chữa lành. \r\nVấn đề ở đây là khâu đóng gói và giao hàng quá tệ. Sách cứ thế mà để vào hộp không bao bọc thậm chí không có nổi cái màng nilon. Lúc mình nhận hàng thì cái hộp rách toát, lòi cả sách bên trong ra. Cũng may là không quyển nào bị hư hại quá nhiều, chỉ móp góc tí thôi. Đây là cái vấn đề muôn thuở của tiki rồi mà sao mãi chẳng tìm được cách khắc phục vậy nhỉ. Làm vậy khiến mình cảm thấy tiki không tôn trọng khách hàng.", "status": "approved", "thank_count": 0, "score": 0, "new_score": 0, "customer_id": 27199719, "comment_count": 0, "rating": 3, "images": [], "thanked": false, "created_at": 1675526533, "created_by": {"id": 27199719, "name": "Vân Hai Hai", "full_name": "Vân Hai Hai", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2022-03-28 22:03:01", "group_id": 8, "purchased": true, "purchased_at": 1674487266, "contribute_info": {"id": 27199719, "name": "Vân Hai Hai", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 5 năm", "total_review": 20, "total_thank": 0}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading", "Năm tái bản 2019"], "product_attributes": ["Năm tái bản: 2019"], "spid": 19792257, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 276833162, "timeline": {"review_created_date": "2023-02-04 23:02:13", "delivery_date": "2023-01-29 14:15:50", "current_date": "2026-09-07 23:50:00", "content": "Đã dùng 6 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 6 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}], "paging": {"total": 28, "per_page": 20, "current_page": 2, "last_page": 2, "from": 21, "to