ew/f6/d9/ce/771d3525701adcbb452ec8ca7ae33190.jpg", "status": "approved"}], "thanked": false, "created_at": 1669877095, "created_by": {"id": 705078, "name": "Mai Bích Thùy", "full_name": "Mai Bích Thùy", "region": null, "avatar_url": "https://salt.tikicdn.com/cache/512x512/ts/avatar/d6/33/55/efb8e4d71d430d40070ce60a3537140b.png", "created_time": "2015-07-16 11:58:27", "group_id": 8, "purchased": true, "purchased_at": 1669828841, "contribute_info": {"id": 705078, "name": "Mai Bích Thùy", "avatar": "https://salt.tikicdn.com/cache/512x512/ts/avatar/d6/33/55/efb8e4d71d430d40070ce60a3537140b.png", "summary": {"joined_time": "Đã tham gia 11 năm", "total_review": 45, "total_thank": 13}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 15267828, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "21/ce/5c/b52d0b8576680dc3666474ae31b091ec.jpg"}, "product_id": 15267827, "timeline": {"review_created_date": "2022-12-01 13:44:55", "delivery_date": "2022-12-01 08:55:40", "current_date": "2026-09-07 23:57:33", "content": "Đã dùng 5 giờ", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 5 giờ."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 9730083, "title": "Cực kì hài lòng", "content": "Nói 1 chút về cuốn sách này, có thể nói em í là cuốn sách viết về trẻ con nhưng chưa chắc người lớn có thể hiểu hết được. \nCon người, họ chen nhau trên những chuyến tàu nhanh, nhưng họ chẳng biết mình tìm kiếm cái gì nữa. Thế là họ mới cuống lên rồi chạy quanh...\nCon người đem trồng năm nghìn trong cùng 1 khu vườn... và họ chẳng tìm thấy ở đó điều mà họ vẫn đi tìm...\nDẫu là ngôi nhà, các vì sao hay sa mạc đi nữa, điều khiến chúng đẹp thì con mắt thường chẳng nhìn thấy được!\nCậu sẽ phải chịu trách nhiệm vĩnh viễn đối với những gì cậu đã thuần hoá vì người ta chỉ nhìn rõ được bằng trái tim. Con mắt thường luôn mù loà trước điều cốt tử. \nNgười ta chỉ hiểu những thứ mà người ta thuần hoá thôi. Con người chẳng có thời gian để hiểu thứ gì cả. Họ mua đồ đạc tất thảy được làm ra ở chỗ các lái buôn. Nhưng vì chẳng có ai là lái buôn bè bạn trên đời, nên con người mới ko có bạn nữa. \nEm bé này về độ nổi tiếng thì ko phải bàn cãi, được tặng lâu rồi mà h mới có thời gian để tìm hiểu em í. Em í đã chính thức thuần hoá được mình...\nSáng t7 với những nổi buồn, niềm vui và cách tư duy của em đã làm bản thân mình chựng lại. Đúng là mình cũng đang chen nhau trên những chuyến tàu với lịch học và lịch trực dày cui nhưng cảm ơn em đã cho mình biết mình đang tìm kiếm điều gì ?\nCảm ơn Tiki đã mang em tới cho mình ko chút tì vết nhé ?", "status": "approved", "thank_count": 0, "score": 38.88888889, "new_score": 0.16069824, "customer_id": 1328517, "comment_count": 0, "rating": 5, "images": [{"id": 1975251, "full_path": "https://salt.tikicdn.com/ts/review/56/12/e2/978f1e193fd7f2b2a8bbeb585c14720f.jpg", "status": "approved"}, {"id": 1975252, "full_path": "https://salt.tikicdn.com/ts/review/9f/a6/b5/d989bbe08a1bb984ed76a86c6fbe0b75.jpg", "status": "approved"}], "thanked": false, "created_at": 1621051640, "created_by": {"id": 1328517, "name": "Kiều Như", "full_name": "Kiều Như", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2016-04-26 11:24:35", "purchased": true, "purchased_at": 1616915670, "contribute_info": {"id": 1328517, "name": "Kiều Như", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 11 năm", "total_review": 86, "total_thank": 57}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 15267828, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 15267827, "timeline": {"review_created_date": "2021-05-15 11:07:20", "delivery_date": "2021-03-30 09:57:09", "current_date": "2026-09-07 23:57:33", "content": "Đã dù