{"stars": {"1": {"count": 17, "percent": 1}, "2": {"count": 20, "percent": 1}, "3": {"count": 46, "percent": 1}, "4": {"count": 291, "percent": 8}, "5": {"count": 3156, "percent": 89}}, "rating_average": 4.9, "reviews_count": 3530, "review_photo": {"total": 537, "total_photo": 842}, "data": [{"id": 19977939, "title": "Cực kì hài lòng", "content": "Dù trải qua 7749 cái bão nhm sách vẫn đẹp lắm nha. Không trầy xước chỗ nào hết trơn áaa", "status": "approved", "thank_count": 0, "score": 44.44444444, "new_score": 0.17008912, "customer_id": 30117295, "comment_count": 1, "rating": 5, "images": [{"id": 4376377, "full_path": "https://salt.tikicdn.com/ts/review/13/10/63/5a24ecddcd8483ae883b2ca60548f011.jpg", "status": "approved"}, {"id": 4376378, "full_path": "https://salt.tikicdn.com/ts/review/36/b1/58/cfcf53201812f6778e6536fe6f577c6f.jpg", "status": "approved"}, {"id": 4376379, "full_path": "https://salt.tikicdn.com/ts/review/b4/41/8e/fa13cc7cb4d5b06b93f2602541e3cfd2.jpg", "status": "approved"}], "thanked": false, "created_at": 1726119277, "created_by": {"id": 30117295, "name": "Bảo Ann", "full_name": "Bảo Ann", "region": null, "avatar_url": "https://salt.tikicdn.com/cache/512x512/ts/avatar/10/00/74/4aaaa6921a7bc21a437f55aecac53e31.png", "created_time": "2024-09-09 18:09:45", "group_id": 8, "purchased": true, "purchased_at": 1725899399, "contribute_info": {"id": 30117295, "name": "Bảo Ann", "avatar": "https://salt.tikicdn.com/cache/512x512/ts/avatar/10/00/74/4aaaa6921a7bc21a437f55aecac53e31.png", "summary": {"joined_time": "Đã tham gia 2 năm", "total_review": 1, "total_thank": 0}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 15267828, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 15267827, "timeline": {"review_created_date": "2024-09-12 12:34:37", "delivery_date": "2024-09-12 11:26:03", "current_date": "2026-09-07 23:57:32", "content": "Đã dùng 1 giờ", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 giờ."}, "comments": [{"id": 3251196, "review_id": 19977939, "commentator": "seller", "customer_id": 1, "fullname": "Tiki Trading", "avatar_url": "https://vcdn.tikicdn.com/ts/seller/d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg", "content": "Tiki rất vui khi nhận được đánh giá 5⭐️từ bạn An. Hy vọng bạn sẽ tiếp tục ủng hộ Tiki nha!", "score": 0, "create_at": 1726220196, "badge": "https://salt.tikicdn.com/ts/review/05/6f/c0/d7462c4721ae3d6aabb2f51ff13fa44f.png", "status": 2, "is_reported": false}], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": [{"question": "Thời gian giao hàng?", "option": "Giao đúng hẹn"}, {"question": "Thái độ của shipper?", "option": "Lịch sự"}, {"question": "Giờ giao hàng?", "option": "Có hẹn giờ trước"}, {"question": "Cách đóng gói sản phẩm?", "option": "Cẩu thả"}]}, {"id": 19100448, "title": "Cực kì hài lòng", "content": "Quyển sách nhỏ cho tâm hồn già cỗi\r\n\r\nTôi đọc quyển này lần đầu khi học Trung học hay Đại học gì đó với cái đầu đầy logic của người lớn vì vậy có lẽ chẳng hiểu mấy về những gì được tác giả viết. Một câu chuyện với ngôn ngữ kỳ lạ dành cho trẻ con và những điều phi logic (nhất là cái kết lãng nhách).\r\nMãi sau này, thỉnh thoảng tôi đọc được một vài đoạn trích dẫn ngắn ngắn của quyển này mới cảm thấy nó sâu sắc hơn những gì mà cậu chàng thanh niên tuổi đôi mươi nghĩ rất nhiều. Phải chăng khi đã bước qua tuổi trung niên, người ta mới có thể nhận ra những chân lý nhẹ nhàng mà chàng hoàng tử ấy muốn truyền đạt?\r\nHôm nay nhận được sách đặt mua và tôi vừa đọc vừa nghiền ngẫm cả quyển sách trong khoảng hai giờ. Hai giờ sống trong thế giới có Hoàng tử bé rồi trở lại cuộc hiện sinh đầy đau đớn, quằn quại đến mức điên dại khôn ngần của mình.\r\nHoàng tử bé - có lẽ là một ảo tượng cận tử của người phi công - nhà văn ấy trong nhiều ngày mắc kẹt trong sa mạc. Hoàng tử bé vừa là đứa trẻ vĩnh cửu trong vô thức vừa là hiền nhân dẫn dắt tác giả trong cả cõi vô thức và hữu thức. Hoàng tử bé nhắc nhở về những chân lý mà những người lớn đã quên mất: chúng ta đều từng là những đứa trẻ và khi lớn lên cuộc sống đã làm băng hoại tâm hồn vốn dĩ tròn trịa ấy. Hoàng tử bé và con cáo dạy chúng ta về tình yêu, về sự thuần hoá, về tình bạn.\r\nBông hồng đã thuần hoá Hoàng tử bé cũng như Hoàng tử bé đã thuần hoá bông hoa ấy, và vì vậy bông hoa ấy đã trở nên độc nhất trong trái tim cậu. Bông hoa đỏng đảnh, đỏm dáng và gây phiền cho cậu rất nhiều nên cả hai quyết định rời xa nhau. Có những sự rời xa là mãi mãi và cậu chỉ có thể quay lại hành tinh ấy khi không còn cái vỏ (thân xác). \r\nHoàng tử bé và con cáo, Hoàng tử bé và tác giả cũng trong những mối quan hệ thuần hoá nhau để rồi cánh đồng lúa mỳ cũng trở nên có ý nghĩa với con cáo - loài động vật chẳng bao giờ ăn lúa mỳ; để rồi hàng triệu vì sao sẽ trở nên ý nghĩa với tác giả vì có Hoàng tử bé nơi đó.\r\nHoàng tử bé phải chết vì tác giả đã sửa xong động cơ máy bay, tác giả phải trở về với cõi thực từ cõi mộng. Nhưng Hoàng tử bé và bông hồng và con cừu sẽ sống mãi như nghịch lý con mèo trong hộp (khi người ta chưa mở hộp ra).\r\nAnh Thụy \r\nBa Xuyên, 14/02/2023", "status": "approved", "thank_count": 0, "score": 33.33333333, "new_score": 0.17050855, "customer_id": 13988205, "comment_count": 0, "rating": 5, "images": [{"id": 4189689, "full_path": "https://salt.tikicdn.com/ts/review/70/be/ba/b253470bf59be526e4fabbd283e9049b.jpg", "status": "approved"}], "thanked": false, "created_at": 1681704891, "created_by": {"id": 13988205, "name": "Trương Thuận Lợi", "full_name": "Trương Thuận Lợi", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2019-09-13 12:19:36", "group_id": 8, "purchased": true, "purchased_at": 1676232106, "contribute_info": {"id": 13988205, "name": "Trương Thuận Lợi", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 7 năm", "total_review": 101, "total_thank": 205}}}, "suggestions":