.1455936, "customer_id": 6811751, "comment_count": 1, "rating": 1, "images": [{"id": 649997, "full_path": "https://salt.tikicdn.com/ts/review/2f/9a/c9/f19ca2ad8835eecb3d1574defdf8ce7e.jpg", "status": "approved"}, {"id": 649998, "full_path": "https://salt.tikicdn.com/ts/review/fe/37/09/a026f24b28a03a63f054a3375506505c.jpg", "status": "approved"}], "thanked": false, "created_at": 1573208988, "created_by": {"id": 6811751, "name": "Phạm Thị Ánh Tuyết", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "purchased": true, "purchased_at": 1572940708, "contribute_info": {"id": 6811751, "name": "Phạm Thị Ánh Tuyết", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 9 năm", "total_review": 2, "total_thank": 0}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 4781791, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 4780917, "timeline": {"review_created_date": "2019-11-08 17:29:48", "delivery_date": "2019-11-07 07:10:34", "current_date": "2026-09-07 23:39:45", "content": "Đã dùng 1 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 ngày."}, "comments": [{"id": 424590, "review_id": 2613234, "commentator": "tikicare", "customer_id": 0, "fullname": "Tiki Care", "avatar_url": "https://salt.tikicdn.com/ts/ta/21/ce/5c/f3809056f0195db1a6295a50ac68ee0e.jpg", "content": "Chào bạn, Tiki đã nhận được thông tin đánh giá và rất tiếc vì sự bất tiện trong lần mua sắm này. Đối với những trường hợp phát sinh lỗi ngoại quan (lỗi hình thức bên ngoài quan sát được bằng mắt, không phải lỗi kỹ thuật), bạn vui lòng liên hệ Tiki trong vòng 48h kể từ khi nhận hàng thành công để được hỗ trợ nhanh nhất. Trường hợp của bạn đã quá thời gian quy định (nhận hàng thành công lúc 10:40 ngày 06/11/2019 và bạn phản hồi thông tin đến Tiki lúc 17:30 ngày 08/11/2019) nên Tiki chưa thể hỗ trợ bạn được, mong bạn thông cảm. Tiki xin phép ghi nhận và sẽ cố gắng cải thiện hơn về chất lượng dịch vụ, hy vọng sẽ phục vụ bạn tốt hơn trong đơn hàng tiếp theo. Cảm ơn bạn đã quan tâm và ủng hộ Tiki. Trong trường hợp bạn cần hỗ trợ thêm từ Tiki, bạn có thể liên hệ hộp thư hotro@tiki.vn hoặc hotline 1900-6035. Trân trọng.", "score": 0, "create_at": 1573628787, "badge": "https://salt.tikicdn.com/ts/review/05/6f/c0/d7462c4721ae3d6aabb2f51ff13fa44f.png", "status": 1, "is_reported": false}], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 15807479, "title": "Rất không hài lòng", "content": "Rất thất vọng ạ. Như một quyển sách cũ. Keo dính lên sách và bị gập như thế :(((.", "status": "approved", "thank_count": 0, "score": 5.18518519, "new_score": 0.15046323, "customer_id": 15835833, "comment_count": 0, "rating": 1, "images": [{"id": 3332172, "full_path": "https://salt.tikicdn.com/ts/review/90/60/8a/e6a0402b049e80dbc9049789cfdbebc4.jpg", "status": "approved"}, {"id": 3332173, "full_path": "https://salt.tikicdn.com/ts/review/04/35/74/1394236e3aba827d42d2d7e61920bfcc.jpg", "status": "approved"}], "thanked": false, "created_at": 1649294197, "created_by": {"id": 15835833, "name": " Thúy Lâm ", "full_name": " Thúy Lâm ", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2020-01-05 15:23:02", "group_id": 8, "purchased": true, "purchased_at": 1649073526, "contribute_info": {"id": 15835833, "name": " Thúy Lâm ", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 7 năm", "total_review": 43, "total_thank": 0}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 4781791, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 4780917, "timeline": {"review_created_date": "2022-04-07 08:16:37", "delivery_date": "20