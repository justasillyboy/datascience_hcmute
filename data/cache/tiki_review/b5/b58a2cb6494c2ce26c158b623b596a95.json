 ?\nMình cũng có mua thử sp sữa chống nắng cùng loại, cả 2 đều ổn nhé ?\nƯu điểm: giá thành phù hợp, dễ sử dụng, tiện đem theo, tiệp màu da, không bị nặng da, dễ tẩy trang.\nNhược điểm: hơi ra dầu sau 2h sử dụng.", "status": "approved", "thank_count": 31, "score": 0.00391857, "new_score": 0.15904515, "customer_id": 90460, "comment_count": 9, "rating": 5, "images": [{"id": 1127774, "full_path": "https://salt.tikicdn.com/ts/review/7f/c8/76/021f8197ff37f25ba223b28ef7ad081a.jpg", "status": "approved"}, {"id": 1127775, "full_path": "https://salt.tikicdn.com/ts/review/cb/fb/e7/157964a3ca2c06fc12f50697253e17d4.jpg", "status": "approved"}, {"id": 1127776, "full_path": "https://salt.tikicdn.com/ts/review/75/23/88/f4bb75187ce94f8c63c83d57fab48925.jpg", "status": "approved"}], "thanked": false, "created_at": 1597232821, "created_by": {"id": 90460, "name": "Chi Lê", "full_name": "Chi Lê", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2013-01-29 13:42:15", "group_id": 8, "purchased": true, "purchased_at": 1595163854, "rank": 5, "badge": "Bút mới nổi", "badge_icon": "https://salt.tikicdn.com/assets/img/review-badge/badge-5.png", "contribute_info": {"id": 90460, "name": "Chi Lê", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 14 năm", "total_review": 177, "total_thank": 378}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 10863050, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "21/ce/5c/b52d0b8576680dc3666474ae31b091ec.jpg"}, "product_id": 8959289, "timeline": {"review_created_date": "2020-08-12 18:47:01", "delivery_date": "2020-01-18 09:16:09", "current_date": "2026-09-08 00:49:44", "content": "Đã dùng 1 năm", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 năm."}, "comments": [{"id": 2941827, "review_id": 4434071, "commentator": "customer", "customer_id": 28352239, "fullname": "Phan Thị Trúc Đào", "avatar_url": "htt