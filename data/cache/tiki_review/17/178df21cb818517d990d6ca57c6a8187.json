{"stars": {"1": {"count": 22, "percent": 1}, "2": {"count": 12, "percent": 1}, "3": {"count": 24, "percent": 1}, "4": {"count": 99, "percent": 9}, "5": {"count": 1055, "percent": 88}}, "rating_average": 4.8, "reviews_count": 1212, "review_photo": {"total": 238, "total_photo": 384}, "data": [{"id": 19092901, "title": "Cực kì hài lòng", "content": "Sách mua giá sale nên ko có bookmark, lúc nhận hàng còn nguyên vẹn, mình không quan trọng hình thức nên với giá này thì rất oke rồi.\r\n\r\nVề nội dung: \r\nÁM ẢNH THỰC SỰ. Đọc xong hoài nghi về nhân sinh. Tự hỏi một người có tuổi thơ đầy tổn thương thì có thể lạnh lùng đến mức độ nào. Tất cả cũng chỉ vì 2 chữ “tồn tại”. Trong đó bao gồm danh vọng và dục vọng. Hai từ “tha thứ” không bao giờ có trong tiềm thức của người chịu tổn thương. Thực sự họ không bao giờ quên được đâu.", "status": "approved", "thank_count": 1, "score": 0.00467593, "new_score": 0.16748348, "customer_id": 787057, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1681528496, "created_by": {"id": 787057, "name": "nguyen thu trang", "full_name": "nguyen thu trang", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2015-08-31 18:29:45", "group_id": 8, "purchased": true, "purchased_at": 1670116601, "contribute_info": {"id": 787057, "name": "nguyen thu trang", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 11 năm", "total_review": 22, "total_thank": 30}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 103379149, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 103379147, "timeline": {"review_created_date": "2023-04-15 10:14:56", "delivery_date": "2022-12-05 12:07:37", "current_date": "2026-09-08 12:55:11", "content": "Đã dùng 4 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 4 tháng."}, "comments": [], "vo