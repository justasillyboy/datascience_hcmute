g": 5, "images": [{"id": 1178356, "full_path": "https://salt.tikicdn.com/ts/review/1e/1d/e4/c787488749d9bb49d9139c4a9c5cd8f9.jpg", "status": "approved"}], "thanked": false, "created_at": 1599725273, "created_by": {"id": 6123197, "name": "Nguyễn Thị Nga", "full_name": "Nguyễn Thị Nga", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "purchased": true, "purchased_at": 1597151815, "contribute_info": {"id": 6123197, "name": "Nguyễn Thị Nga", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 9 năm", "total_review": 29, "total_thank": 0}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 12377499, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 12377498, "timeline": {"review_created_date": "2020-09-10 15:07:53", "delivery_date": "2020-08-13 17:26:22", "current_date": "2026-09-08 23:29:05", "content": "Đã dùng 1 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 tháng."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 4532429, "title": "Cực kì hài lòng", "content": "4/5\nLuôn có những câu chuyện mãi được yêu thương, mãi được trân trọng vì sự nhân văn của nó.\nTrầm tư và lặng lẽ, mãnh liệt và đầy yêu thương, đau đớn và đầy nước mắt, qua từng con chữ được chắt ra từ những dòng cảm xúc ấy, Cho Chang In đã thành công khi kéo người đọc bước vào mảnh đất thiêng liêng nhất trên thế gian này – mảnh đất của tình phụ tử hiếm hoi ít khi được khai thác. Nhưng nơi đây lại cực kỳ nhiệm màu và đầy nước mắt.\nQuyết định đọc lại sau khi dnf 2 tháng trước và...\nĐÂY MỘT CUỐN SÁCH TUYỆT VỜI!!\nCuốn sách tựa một chuyến rollercoaster lên xuống theo cảm xúc.\nDaum, cậu con trai mạnh mẽ. Mang mình căn bệnh máu trắng nhưng cậu là người luôn tích cực hy vọng và tích cực sống. Những xúc cảm quen thuộc của những cậu bé tuổi ấu thơ: thích một bạn nữ, ghen tị với bạn khác,... Nhưng trong Daum là một con ng mạnh mẽ hơn bất kỳ ai. Và cậu cũng là ng yêu bố hơn bất kỳ ai.\nNgười bố cá gai. Khác hẳn với các khuôn mẫu của các ông bố thông thường. Park In Seok ở đây tần tảo, cam chịu, yêu con hơn bản thân mình. Ông không thể theo đam mê mình và phải đi vất vả xin việc để kiếm bài đồng bạc trả viện phí cho con trai. Đam mê vẫn nơi ấy nhưng nó có thể đã bị tàn lụi bởi căn bệnh quái ác ấy. Và làm tàn lụi luôn cả cuộc sống của ông.\nĐây là một cuốn sách cực kỳ đỉnh cao. Cảm xúc của mình đi từ quắn kéo từ những giai đoạn đầu trước khi mẹ cậu xuất hiện của cậu bé Daum, lúc cậu còn có thể yêu thương, lúc còn có thể khóc, còn có thể cười với bố. Đến những lúc phải nghẹn ngào vì tình yêu của người bố, người phải ém lại đam mê to lớn để ông có thể chăm lo cho con. Nước mắt ông rơi khi kết tựa một cú đấm mạnh mẽ vào tim các độc giả. Chỉ hơi tiếc rằng....\nCuốn sách vẫn có vài điểm yếu khác lớn khiến mình gần như ko khóc khi ending. Nhân vật khá một màu và được xây dựng tính cách rất kém. Trừ người bố thì đã đc đào sâu thì còn lại khá một màu.\nHy vọng sau này reread thì sẽ khóc.\nNhưng đây vẫn là một cuốn sách cực kỳ nhân văn về tình cha con hiếm hoi mà ta nên tìm đọc một lần.", "status": "approved", "thank_count": 3, "score": 0.01323057, "new_score": 0.14983308, "customer_id": 15748060, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1597843696, "created_by": {"id": 15748060, "name": "Trần Đình Triết", "full_name": "Trần Đình Triết", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2019-12-30 22:00:20", "purchased": true, "purchased_at": 1579357601, "contribute_info": {"id": 15748060, "name": "Trần Đình Triết", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 7 năm", "total_review": 12, "total_thank": 3}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes":