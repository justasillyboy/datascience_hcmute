{"stars": {"1": {"count": 10, "percent": 1}, "2": {"count": 15, "percent": 1}, "3": {"count": 21, "percent": 1}, "4": {"count": 90, "percent": 9}, "5": {"count": 940, "percent": 88}}, "rating_average": 4.8, "reviews_count": 1076, "review_photo": {"total": 184, "total_photo": 291}, "data": [{"id": 4281531, "title": "Bình thường", "content": "Hàng đóng gói ko chắc chắn, sách bóp méo và bị bong nilon. Nếu đặt tikinow mà đóng ko chắc chắn thế này thì mình ko hài lòng.đề nghị tiki xem lại việc đóng gói.", "status": "approved", "thank_count": 0, "score": 50, "new_score": 0.15179426, "customer_id": 14334865, "comment_count": 0, "rating": 3, "images": [{"id": 1109946, "full_path": "https://salt.tikicdn.com/ts/review/15/e0/7e/96a0526ec7767627f69ffa379d196df5.jpg", "status": "approved"}, {"id": 1109947, "full_path": "https://salt.tikicdn.com/ts/review/a5/79/b5/ac79a0618faba9562add095ee96e9ec5.jpg", "status": "approved"}, {"id": 1109948, "full_path": "https://salt.tikicdn.com/ts/review/2b/fa/41/9e360fdc7a18d2f7b3819fa09b0469e6.jpg", "status": "approved"}, {"id": 1109949, "full_path": "https://salt.tikicdn.com/ts/review/d5/3c/c0/539d07154bcecb858b459b1fc60579ff.jpg", "status": "approved"}], "thanked": false, "created_at": 1596254433, "created_by": {"id": 14334865, "name": "Phuong Nguyen", "full_name": "Phuong Nguyen", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "purchased": true, "purchased_at": 1596125548, "contribute_info": {"id": 14334865, "name": "Phuong Nguyen", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 7 năm", "total_review": 4, "total_thank": 0}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 22383812, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 22383811, "timeline": {"review_created_date": "2020-08-01 11:00:33", "delivery_date": "2020-07-31 10:58:21", "current_date": "2026-09-08 12:56:27", "content": "Đã dùng 1 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 2945070, "title": "Sách có ý nghĩa động viên, không có book care", "content": "Về dịch vụ giao hàng của Tiki: Giao hàng đúng thời gian. Nhưng lỗi về dịch vụ bookcare - Trong hệ thống đã báo bọc (đã có trừ số bookcare), nhưng khi giao đến tay mình lại là không bọc. Nên trừ 1 sao.\n\nVề nội dung: Cuốn sách dễ đọc nhưng 448 trang với khổ 24.2 x 16.4 cm nên cũng tốn 4 buổi tối mới hoàn thành. Tuy hành văn và mạch truyện không đặc sắc, thậm chí là hơi dài dòng và chán ở phần đầu, nhưng đây là một cuốn sách mang ý nghĩa động viên tốt.\n\n      Cuốn sách này không nhấn mạnh nhiều về đời sống phu nhân tổng thống, mà là một cuốn tự truyện về sự sinh ra và lớn lên của một người phụ nữ hiện đại có chủ kiến, có hoài bão và quyết tâm khẳng định bản thân mạnh mẽ. Một người phụ nữ rất thật với những mâu thuẫn và khó khăn trong cân bằng giữa điều mình muốn làm và điều xã hội kỳ vọng, giữa vừa phát triển sự nghiệp với chăm sóc cho gia đình.\n\n      Cuốn sách là lời thôi thúc vươn lên đối với những người thuộc nhóm yếu thế trong xã hội - phụ nữ, người da màu, người sống trong khu vực kém phát triển. Thông điệp mà Michelle luôn nhắc đi nhắc chúng ta không thể lựa chọn nơi chúng ta sinh ra, không thể thay đổi ngay lập tức điều kiện sống hiện tại; Nhưng với quyết tâm học tập, hướng đến nền giáo dục tốt hơn, nồng nhiệt vận động những người cùng chí hướng, tận dụng mọi điều kiện mà chúng ta có, thì dần dần - tương lai tươi sáng hơn, bình đẳng hơn cho mọi người sẽ không còn là viễn cảnh quá xa vời.", "status": "approved", "thank_count": 0, "score": 0.00749232, "new_score": 0.15219721, "customer_id": 264366, "comment_count": 0, "rating": 3, "images": [{"id": 790861, "full_path": "https://salt.tikicdn.com/ts/review/d8/f3/ce/bb1749266915dc