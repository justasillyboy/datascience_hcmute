iki giao hàng nhanh, sách mới còn nguyên bọc nilon, chữ và ảnh in sắc nét, sách dày nhưng cầm nhẹ tay.", "status": "approved", "thank_count": 0, "score": 44.44444444, "new_score": 0.14973635, "customer_id": 1513317, "comment_count": 0, "rating": 5, "images": [{"id": 2248555, "full_path": "https://salt.tikicdn.com/ts/review/1a/8c/5e/73a6526df9760b0bfb00bcacf8a6bff4.jpg", "status": "approved"}, {"id": 2248556, "full_path": "https://salt.tikicdn.com/ts/review/df/37/96/5197616cbff78fdd39347c017619deeb.jpg", "status": "approved"}, {"id": 2248557, "full_path": "https://salt.tikicdn.com/ts/review/80/50/fc/437e1fd858f2dfdb748e7a502173ed18.jpg", "status": "approved"}], "thanked": false, "created_at": 1625651145, "created_by": {"id": 1513317, "name": "nguyen thu thao", "full_name": "nguyen thu thao", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2016-07-16 19:01:33", "purchased": true, "purchased_at": 1625634264, "contribute_info": {"id": 1513317, "name": "nguyen thu thao", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 10 năm", "total_review": 34, "total_thank": 7}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 59511812, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 59511811, "timeline": {"review_created_date": "2021-07-07 16:45:45", "delivery_date": "2021-07-07 16:17:26", "current_date": "2026-09-07 23:39:02", "content": "Đã dùng 28 phút", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 28 phút."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 9851129, "title": "Cực kì hài lòng", "content": "Lại là 1 cuốn sách rất hay nữa của tác giả Nguyên Phong. 1 khi cầm cuốn sách lên thì rất khó để bỏ xuống. Nội dung xoay quanh thời Ai Cập cổ đại, những triết lý trong sách cũng gần giống kinh Lăng Nghiêm của Phật giáo.", "status": "approved", "thank_count": 1, "score": 0.01144208, "new_score": 0.15313944, "customer_id": 516468, "comment_count": 0, "rating": 5, "images": [{"id": 2541446, "full_path": "https://salt.tikicdn.com/ts/review/04/e6/46/13f916dd3e34a4f603333547749cbae6.jpg", "status": "approved"}], "thanked": false, "created_at": 1621504764, "created_by": {"id": 516468, "name": "Kiet Nguyen", "full_name": "Kiet Nguyen", "region": null, "avatar_url": "https://salt.tikicdn.com/cache/256x256/ts/avatar/63/c2/55/fcaa26ff5dbdb558426d116ab10cc0b4.png", "created_time": "2014-12-20 21:52:04", "group_id": 8, "purchased": true, "purchased_at": 1618585939, "contribute_info": {"id": 516468, "name": "Kiet Nguyen", "avatar": "https://salt.tikicdn.com/cache/256x256/ts/avatar/63/c2/55/fcaa26ff5dbdb558426d116ab10cc0b4.png", "summary": {"joined_time": "Đã tham gia 12 năm", "total_review": 29, "total_thank": 5}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 59511812, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 59511811, "timeline": {"review_created_date": "2021-05-20 16:59:24", "delivery_date": "2021-04-18 10:39:29", "current_date": "2026-09-07 23:39:02", "content": "Đã dùng 1 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 tháng."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 10343918, "title": "Cực kì hài lòng", "content": "Tuyệt vời. Quyển sách phóng tác dựa trên lịch sử nhưng mang đến những thông tin vô cùng hữu ích. Dấu chân trên cát - Nguyên Phong. Thú vị và hay. Là câu chuyện phóng tác dựa trên lịch sử khảo cổ học của Ai Cập, kể về 1 triều đại khác lạ của Pharaon đầu tiên - ko thích chiến tranh xâm lấn, ko thích giáo phái tu sĩ tôn thờ thần linh - bằng chứng bằng các khai quật khảo cổ ghi lại. Pharaon hướng thiện nghĩ cho dân và muốn thay đổi nền Giáo dục tư tưởng Ai Cập thời đó, nhưng tiếc là ko thực hiện dc thì Ngài chết - nhưng có 1 truyền nhân cùng tư tưởng đã lĩnh hội tinh thần đó, dc hấp thụ các kiến thức chiêm tinh, y học và tôn giáo đã qua Hy Lạp để truyền dạy và bảo lưu nền Văn hoá Ai Cập (theo sách thì Chàng trai này là Thầy của các bậc hiền Triết và Triết gia vĩ đại như Ariston...). Đọc để hiểu về nền văn hoá Ai Cập xưa. Phía cuối sách có ghi lại bằng chứng khai quật của các nhà Khảo cổ liên quan đến các thời đại Pharaon - ghi niên đại, thời gian trị vị và hưng thịnh hay suy thoái của các vị này. Trc đây Ai Cập có chữ viết với nền văn hoá bậc nhất đặc sắc có từ hàng ngàn năm TCN, biết rèn vũ khí, nấu lỏng kim loại và sử dụng Toán học để xây dựng Kim Tự Tháp hay chiêm tinh rất phát triển. Nhưng vì Pharaon thích xâm lăng, mở rộng lãnh thổ, rồi đảo chính bởi nhiều thế lực quân sự. Trải qua nhiều thời gian bị đô hộ bới Ba Tư, Ả rập, Sybria, sau này là Anh Pháp. Và bị văn hoá Ả rập ăn sâu ở thế hệ sau nên Chữ viết bị đốt bỏ, nhiều kiến thức lưu truyền bị đốt hay làm mất bởi các đất nc đô hộ nên Chữ viết sau này k ai đọc dc, kể cả ng Ai Cập giờ cũng sử dụng Chữ viết Ả rập và đồng hoá với văn hoá của Đất nước này. Sau này Napoleong của Hy Lạp xâm chiếm đất nc này (là người thế hệ sau của các Triết gia vĩ đại, mà là ng Pharaon đã cho qua Hy Lạp sau đó mở các Trường GD và truyền bá rất mạnh về Ai Cập và tinh thần của ông Pharaon hướng thiện tại Hy Lạp - ông này hiểu rất rõ về văn hoá tôn giáo của Ai Cập do dc lĩnh hội yêu cầu khai quật và Phục hưng chữ viết Ai Cập để tìm hiểu kỹ hơn về lịch sử Ai Cập ở các lăng mộ đã khai quật thì lúc đó lịch sử mới bắt đầu hé màn. Và sau nhiều nước xâm chiếm và đô hộ, làm nô lệ thì Napoleong là ng đầu tiên xâm chiến, nhưng dc Ai Cập xem như là người đã giải phóng họ khỏi ách nô lệ của các quốc gia trc đó. Nếu muốn tìm hiểu về Ai Cập và nền văn minh lâu đời của nó thì đọc cho biết nhé.", "status": "approved", "thank_count": 6, "score": 0.00921055, "new_score": 0.15526653, "customer_id": 12273250, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1623396752, "created_by": {"id": 12273250, "name": "Duyen Nguyen", "full_name": "Duyen Nguyen", "region": null, "avatar_url": "https://s120.avatar.talk.zdn.vn/c/5/1/5/40/120/2e1f68cd1275217faf7344bd8e461eca.jpg", "created_time": "2019-05-28 14:18:09", "group_id": 8, "purchased": true, "purchased_at": 1623137452, "contribute_info": {"id": 12273250, "name": "Duyen Nguyen", "avatar": "https://s120.avatar.talk.zdn.vn/c/5/1/5/40/120/2e1f68cd1275217faf7344bd8e461eca.jpg", "summary": {"joined_time": "Đã tham gia 7 năm", "total_review": 63, "total_thank": 43}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 59511812, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 59511811, "timeline": {"review_created_date": "2021-06-11 14:32:32", "delivery_date": "2021-06-09 10:15:20", "current_date": "2026-09-07 23:39:02", "content": "Đã dùng 2 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 2 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 9126053, "title": "Cực kì hài lòng", "conten