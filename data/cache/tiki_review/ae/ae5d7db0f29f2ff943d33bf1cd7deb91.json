{"stars": {"1": {"count": 2, "percent": 1}, "2": {"count": 3, "percent": 1}, "3": {"count": 2, "percent": 1}, "4": {"count": 13, "percent": 5}, "5": {"count": 213, "percent": 92}}, "rating_average": 4.9, "reviews_count": 233, "review_photo": {"total": 28, "total_photo": 43}, "data": [{"id": 18925051, "title": "Cực kì hài lòng", "content": "Tác phẩm ra đời cũng lâu nên lối viết có hơi xưa một chút, nhưng đó lại là cái độc đáo của sách\r\nNội dung sách viết khá thực dụng, có phầm hơi thô, sự thật mất lòng mà.\r\nSách truyền tải một ý rất hay theo lời trích của Dorothy Dix: \"Hôn nhân là vấn đề quan trọng còn hơn vấn đề sinh tử. Nhưng phần đông họ cưới hỏi nhau không hiểu tại sao\"", "status": "approved", "thank_count": 1, "score": 0.04050926, "new_score": 0.17579111, "customer_id": 23800859, "comment_count": 0, "rating": 5, "images": [{"id": 4146806, "full_path": "https://salt.tikicdn.com/ts/review/8f/e9/8d/12fd411bf72ea90b3f66348dbc8b3f29.jpg", "status": "approved"}, {"id": 4146807, "full_path": "https://salt.tikicdn.com/ts/review/e7/b2/c3/ff7add00da7677f19c4c3b9e19725d22.jpg", "status": "approved"}, {"id": 4146808, "full_path": "https://salt.tikicdn.com/ts/review/19/a1/06/2276c3f1963d28c6332b36a47b099258.jpg", "status": "approved"}], "thanked": false, "created_at": 1678250331, "created_by": {"id": 23800859, "name": "Nguyễn Quang Nhật", "full_name": "Nguyễn Quang Nhật", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2021-09-26 23:49:54", "group_id": 8, "purchased": true, "purchased_at": 1678084547, "contribute_info": {"id": 23800859, "name": "Nguyễn Quang Nhật", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 5 năm", "total_review": 26, "total_thank": 11}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 87391040, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6