avatar": "https://platform-lookaside.fbsbx.com/platform/profilepic/?asid=1065489720289723&height=200&width=200&ext=1556551735&hash=AeSaDuSHXeW1wUZY", "summary": {"joined_time": "Đã tham gia 8 năm", "total_review": 24, "total_thank": 0}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 633134, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 633125, "timeline": {"review_created_date": "2025-08-03 09:39:55", "delivery_date": "2025-07-31 13:14:39", "current_date": "2026-09-07 23:43:06", "content": "Đã dùng 3 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 3 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": [{"question": "Thời gian giao hàng?", "option": "Giao đúng hẹn"}, {"question": "Thái độ của shipper?", "option": "Lịch sự"}, {"question": "Giờ giao hàng?", "option": "Có hẹn giờ trước"}, {"question": "Cách đóng gói sản phẩm?", "option": "Cẩn thận"}]}, {"id": 1291258, "title": "Chất lượng tốt, nội dung tạm", "content": "Một cuốn sách mà khi cầm trên tay chỉ muốn thốt lên rằng thật đáng tiền. Đây là ấn bản “Lĩnh Nam chích quái” đầu tiên và duy nhất ở Việt Nam có tranh minh họa màu đẹp, độc và lạ\n\nLĩnh Nam Chích Quái viết về những truyền thuyết của Việt Nam. Về nội dung thì có lẽ là do dung lượng dành cho đầu tư tranh vẽ minh họa rất nhiều nên nội dung không thật sự xuất sắc, đơn thuần kể lại những câu chuyện mà chúng ta đã đọc từ lâu như Con Rồng cháu Tiên, sự tích Bánh chưng bánh dây, sự tích dưa hấu, truyện Mị Châu Trọng Thủy,... Thình thoảng cũng có những câu chuyện lạ như Hà Ô Lôi... Cuốn sách như đưa chúng ta lạc vào thế giới tuổi thơ khi còn là những em bé thích nghe kể chuyện. Nhìn chung, toàn bộ tập truyện vẫn thấm nhuần một tinh thần nhân đạo chủ nghĩa của văn học dân gian. Có thể ít nhiều thấy được ở đó thái độ yêu ghét của nhân dân: yêu chính nghĩa, ghét phi nghĩa, yêu điều thiện, ghét điều ác, đề cao những mối quan hệ tốt đẹp thủy chung giữa người với người.\n\nHình thức của cuốn sách rất đẹp, tranh minh họa sinh động nhưng nhiều tranh còn lấy ý tưởng từ Trung Quốc (có hình nhìn như Tần Thủy Hoàng), màu sắc đẹp, có tranh art nhìn hơi kinh dị ví dụ như tranh Thánh Gióng.\n\nNếu gia đình có con nhỏ thì nên mua cho nó xem :D vì thật sự rất đẹp, nhìn chung mua về sưu tầm cũng được. Giá cả thì hơi đắt đỏ nhưng vì bìa cứng và tranh minh họa màu nên cũng tạm được. Đối với những người thật sự thích thần thoại thì nên đọc Truyền kỳ mạn lục hơn.", "status": "approved", "thank_count": 3, "score": 0.00327024, "new_score": 0.13965769, "customer_id": 613881, "comment_count": 1, "rating": 4, "images": [{"id": 119130, "full_path": "https://salt.tikicdn.com/ts/review/d8/8c/ae/cd15cd7bfce352233269c7c2ae227ac3.jpg", "status": "approved"}, {"id": 119134, "full_path": "https://salt.tikicdn.com/ts/review/ae/89/66/b098599d80f336e468dea3352fcfa224.jpg", "status": "approved"}], "thanked": false, "created_at": 1521257749, "created_by": {"id": 613881, "name": "Linh Lee", "full_name": "Linh Lee", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "purchased": true, "purchased_at": 1516716670, "contribute_info": {"id": 613881, "name": "Linh Lee", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 12 năm", "total_review": 22, "total_thank": 114}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 633134, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 633125, "timeline": {"review_created_date": "2018-03-17 10:35:49", "delivery_date": "2018-01-31 17:26:38", "current_date": "2026-09-07 23:43:06", "content": "Đã dùng 2 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 2 tháng."}, "comments": [{"id": 378447, "review_id"