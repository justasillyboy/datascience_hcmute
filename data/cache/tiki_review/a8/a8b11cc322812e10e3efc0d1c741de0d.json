{"stars": {"1": {"count": 4, "percent": 1}, "2": {"count": 0, "percent": 0}, "3": {"count": 11, "percent": 2}, "4": {"count": 90, "percent": 18}, "5": {"count": 389, "percent": 79}}, "rating_average": 4.7, "reviews_count": 494, "review_photo": {"total": 51, "total_photo": 93}, "data": [{"id": 6232719, "title": "Cực kì hài lòng", "content": "The item was received in about three days after purchase. The product doesn’t look as shiny as advertised, and it feels lighter than expected. Aesthetic aside, the item seems to be working well. Laser pointer function is very strong with a very long range. You must hold the button to maintain the laser. The rest of the buttons are use to control powerpoint. It comes with a storage bag and 1 AAA battery. The instruction booklet only comes in Chinese mandarin. So if you don’t know mandarin it will take a bit of time figuring out, it’s fairly easy to figure out. Or to save time you can visit Vson’s website. They have english instructions on there. The laser doesn’t seem to work on LG smart tv.", "status": "approved", "thank_count": 4, "score": 0.00318281, "new_score": 0.16399882, "customer_id": 6213637, "comment_count": 0, "rating": 5, "images": [{"id": 2582527, "full_path": "https://salt.tikicdn.com/ts/review/25/1e/3d/757649f9ff240e51e7f24f533f30a33a.jpg", "status": "approved"}, {"id": 2582528, "full_path": "https://salt.tikicdn.com/ts/review/42/ea/19/02ef7bf5d7663d811fbf9746e269921a.jpg", "status": "approved"}, {"id": 2582529, "full_path": "https://salt.tikicdn.com/ts/review/ac/a1/35/f8d4e2dab180c637a849a7a17930ba41.jpg", "status": "approved"}, {"id": 2582530, "full_path": "https://salt.tikicdn.com/ts/review/be/55/db/59441e9a65361fb4420d8fbb22f159a4.jpg", "status": "approved"}], "thanked": false, "created_at": 1608039993, "created_by": {"id": 6213637, "name": "Van Hoang", "full_name": "Van Hoang", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2017-12-14 15:06:37", "group_id": 8, "purchased": tru