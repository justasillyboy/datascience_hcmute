{"stars": {"1": {"count": 12, "percent": 1}, "2": {"count": 8, "percent": 1}, "3": {"count": 15, "percent": 3}, "4": {"count": 94, "percent": 15}, "5": {"count": 503, "percent": 80}}, "rating_average": 4.7, "reviews_count": 632, "review_photo": {"total": 100, "total_photo": 166}, "data": [{"id": 14203403, "title": "Hài lòng", "content": "Máy in 2 mặt, sắc nét. \nMuốn in đẹp, đậm hơn nữa thì vào phần printer setting để chỉnh. Dùng với máy window thì ổn chứ với MacOs thì hơi tù vì phải in qua phần mềm của hãng chứ không in trực tiếp qua Airprint được.", "status": "approved", "thank_count": 0, "score": 38.88888889, "new_score": 0.1599196, "customer_id": 1061828, "comment_count": 0, "rating": 4, "images": [{"id": 2972394, "full_path": "https://salt.tikicdn.com/ts/review/b3/f1/75/aac91da13a32d92cd5bcfbad8173c32c.jpg", "status": "approved"}, {"id": 2972395, "full_path": "https://salt.tikicdn.com/ts/review/42/ac/de/c22c5b69b4c1d1247325b54452087010.jpg", "status": "approved"}], "thanked": false, "created_at": 1641038626, "created_by": {"id": 1061828, "name": "Nhung Nguyễn", "full_name": "Nhung Nguyễn", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2015-12-18 21:18:37", "group_id": 8, "purchased": true, "purchased_at": 1640959660, "contribute_info": {"id": 1061828, "name": "Nhung Nguyễn", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 11 năm", "total_review": 27, "total_thank": 1}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 167503, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 459201, "timeline": {"review_created_date": "2022-01-01 19:03:46", "delivery_date": "2022-01-01 09:10:57", "current_date": "2026-09-07 22:52:11", "content": "Đã dùng 10 giờ", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 10 giờ."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 1854010, "title": "máy in tốt in nhanh", "content": "đặt 5h hôm trước sáng 11h30 hàng đã tới. Quá nhanh quá nguy hiểm. Tính mua lại con canon 2900 nhưng k in dc 2 mặt. nên chọn em brother này đánh giá sơ :\nNhược điểm:\n-máy hơi nóng. \n-Dòng brother này linh kiện thay cho hao mòn gấp đôi các dòng khác và mực giá còn khá cao.\n-Chổ ra giấy nsx nên cho cái lẫy to hơn để giấy thì sẽ tuyệt hơn.^^\n-Phần mềm quản lý máy hơi không được thông minh. Ít tùy chọn. \nƯu điểm\n-In quá nhanh gấp 3 lần con 2900\n- In 2 mặt quá tiện\n-Máy có làn da đen nên ít sợ dơ\n-Khay giấy lớn đê tha hổ giấy trữ\n-Có chổ mở rút giấy nếu chẳng mai máy bị kẹt giấy.\n-Bình mực lớn \nNói chung hơn 2 triệu lú là quá tốt in nhanh lẹ mực đẹp hơn các tiệm photo.(Chắc tại mực zin)\nPhù hợp cho các văn phòng nhỏ và làm việc thường xuyên in ấn. Tốc độ in rất nhanh. Độ phân giải đạt chuẩn nên in đẹp.", "status": "approved", "thank_count": 25, "score": 0.00503108, "new_score": 0.14669037, "customer_id": 8287534, "comment_count": 1, "rating": 4, "images": [{"id": 298622, "full_path": "https://salt.tikicdn.com/ts/review/4b/52/4f/31d54bf81d0f4898b8869cb3e9a1ff26.jpg", "status": "approved"}, {"id": 298626, "full_path": "https://salt.tikicdn.com/ts/review/25/a8/e6/fb4e65c5894389363948727d5cdca444.jpg", "status": "approved"}, {"id": 298630, "full_path": "https://salt.tikicdn.com/ts/review/96/ad/45/1a95d797c44c780b8ea4ee99d232f2e8.jpg", "status": "approved"}], "thanked": false, "created_at": 1539084142, "created_by": {"id": 8287534, "name": "Nguyễn Đinh Trường Định", "full_name": "Nguyễn Đinh Trường Định", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2018-10-08 17:08:36", "purchased": true, "purchased_at": 1538993994, "contribute_info": {"id": 8287534, "name": "Nguyễn Đinh Trường Định", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 8 năm", "total_review": 1, "total_thank": 25}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 167503, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 459201, "timeline": {"review_created_date": "2018-10-09 18:22:22", "delivery_date": "2018-10-09 15:37:33", "current_date": "2026-09-07 22:52:11", "content": "Đã dùng 3 giờ", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 3 giờ."}, "comments": [{"id": 375377, "review_id": 1854010, "commentator": "customer", "customer_id": 12846075, "fullname": "Công ty An Phong", "avatar_url": "https://tiki.vn/assets/img/avatar.png", "content": "Cám ơn bạn đã mua hàng từ gian hàng An Phong trên Tiki", "score": 0, "create_at": 1568733428, "badge": "", "status": 1, "is_reported": false}], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 15681539, "title": "Hài lòng", "content": "Máy đẹp, rất dễ sử dụng. Lúc đầu mình ưng loại này vì chức năng in 2 mặt tự động (mình gà mờ lắm, xem hướng dẫn lật in 2 mặt thủ công mà thấy rắc rối với mất công quá nên mua loại in 2 mặt tự động cho tiện). Tuy nhiên, sau khi mua về rồi in thử và tìm hiểu thì mới biết chức năng in 2 mặt tự động chỉ áp dụng cho khổ giấy A4, còn A5 vẫn phải lật thủ công nên mình hơi bất ngờ (lần đầu mình tự bỏ tiền mua máy in nên không biết luôn á). Các bạn nào mua thì nhớ lưu ý trước khi mua nha, không thì lúc in ra cái mắt chữ O mồm chữ A giống mình luôn ;-; Còn về các chất lượng in, thời gian in thì rất ok, thân máy chắc chắn, để trong phòng khá đẹp. Thiết kế chống kẹt giấy cũng rất hiệu quả. Vote 4 sao vì lúc giao hàng, anh shipper đặt máy mình xuống khá mạnh, tuy là không bị hỏng hóc gì nhưng mà hàng hóa như máy in như vầy cũng phải cẩn thận chứ.", "status": "approved", "thank_count": 1, "score": 0.00755909, "new_score": 0.16053594, "customer_id": 10703910, "comment_count": 0,