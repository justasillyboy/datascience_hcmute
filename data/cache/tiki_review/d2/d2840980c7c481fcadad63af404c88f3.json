 cài thêm phần mềm ủa Brother để quảng lý dễ dàng và tốt hơn. Cài đặt vào máy PC - có thể quản lý qua mạng lan/wlan mà không cần cắm dây từ máy.\n+ chất lượng in tốt, rõ nét, không nhòe\n+ khay giấy đựng được rất nhiều giấy", "status": "approved", "thank_count": 12, "score": 0.00608888, "new_score": 0.14930917, "customer_id": 1993096, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1594844718, "created_by": {"id": 1993096, "name": "Nguyễn Viết Công Hậu", "full_name": "Nguyễn Viết Công Hậu", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2016-12-19 01:22:21", "purchased": true, "purchased_at": 1594404361, "contribute_info": {"id": 1993096, "name": "Nguyễn Viết Công Hậu", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 10 năm", "total_review": 21, "total_thank": 56}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 763750, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 763675, "timeline": {"review_created_date": "2020-07-16 03:25:18", "delivery_date": "2020-07-11 12:47:02", "current_date": "2026-09-07 22:52:00", "content": "Đã dùng 5 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 5 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 20192523, "title": "Cực kì hài lòng", "content": "", "status": "approved", "thank_count": 0, "score": 27.77777778, "new_score": 0.16151306, "customer_id": 7620865, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1763794706, "created_by": {"id": 7620865, "name": "Thủy Lê", "full_name": "Thủy Lê", "region": null, "avatar_url": "https://lh3.googleusercontent.com/-WrYiRZg2r1o/AAAAAAAAAAI/AAAAAAAAAAA/AAnnY7rdYynhcVLBkz4XHyO7jj86dGhtOQ/mo/photo.jpg", "created_time": "20