m đi làm thuê là bán thời gian 8 tiếng, làm dàn trải với năng suất đều đều là phổ biến.\r\n\r\nNhưng dù sao thì đây quả thực vẫn là cuốn sách rất hữu ích dành cho cả nhân viên và nhà quản lý tham khảo.", "status": "approved", "thank_count": 0, "score": 38.88888889, "new_score": 0.16911875, "customer_id": 5906305, "comment_count": 1, "rating": 5, "images": [{"id": 3811813, "full_path": "https://salt.tikicdn.com/ts/review/5d/62/3f/b948583e76a1a916aa95676d2f4a1973.jpg", "status": "approved"}, {"id": 3811814, "full_path": "https://salt.tikicdn.com/ts/review/17/01/e7/82b4ec002d183a8e3f5fa316732e1f47.jpg", "status": "approved"}], "thanked": false, "created_at": 1660920398, "created_by": {"id": 5906305, "name": "Linh Nguyễn", "full_name": "Linh Nguyễn", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2017-10-11 13:57:24", "group_id": 8, "purchased": true, "purchased_at": 1657170980, "contribute_info": {"id": 5906305, "name": "Linh Nguyễn", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 9 năm", "total_review": 16, "total_thank": 15}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 67991603, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 67991602, "timeline": {"review_created_date": "2022-08-19 21:46:38", "delivery_date": "2022-07-08 11:48:55", "current_date": "2026-09-08 12:55:51", "content": "Đã dùng 1 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 tháng."}, "comments": [{"id": 2596003, "review_id": 17465831, "commentator": "customer", "customer_id": 5906305, "fullname": "Linh Nguyễn", "avatar_url": "https://tiki.vn/assets/img/avatar.png", "content": "Ủa có mấy ảnh mà ko tải đc ảnh nào dị😅", "score": 0, "create_at": 1660920542, "badge": "https://salt.tikicdn.com/ts/reviews/1a/c6/8e/aed2b9016c8a2840ea0d926860