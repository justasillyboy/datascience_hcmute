d", "thank_count": 9, "score": 0.00347173, "new_score": 0.14195746, "customer_id": 10035506, "comment_count": 2, "rating": 4, "images": [{"id": 353643, "full_path": "https://salt.tikicdn.com/ts/review/55/a6/e2/d7d4f610984943806ad1ee907791d034.jpg", "status": "approved"}], "thanked": false, "created_at": 1546005076, "created_by": {"id": 10035506, "name": "Bradwell Dalziel", "full_name": "Bradwell Dalziel", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2018-12-27 13:19:47", "purchased": true, "purchased_at": 1545892015, "contribute_info": {"id": 10035506, "name": "Bradwell Dalziel", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 8 năm", "total_review": 1, "total_thank": 9}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 1002143, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 997535, "timeline": {"review_created_date": "2018-12-28 20:51:16", "delivery_date": "2018-12-28 16:14:11", "current_date": "2026-09-07 23:42:58", "content": "Đã dùng 5 giờ", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 5 giờ."}, "comments": [{"id": 1183838, "review_id": 1995779, "commentator": "customer", "customer_id": 11966249, "fullname": "Phan Bá Hưng", "avatar_url": "https://platform-lookaside.fbsbx.com/platform/profilepic/?asid=366568664202666&height=200&width=200&ext=1559572889&hash=AeRaIbJzy8GKeFMd", "content": "bản dịch bị lược bỏ rất nhiều cảnh làm nên tên tuổi của bộ phim và mình rất thất vọng về điều đó-k hiểu nổi sao luôn", "score": 0, "create_at": 1621464370, "badge": "https://salt.tikicdn.com/ts/reviews/b0/77/a5/1dc3901bd48bfc65a51760dc051ebbdb.png", "status": 1, "is_reported": false}, {"id": 617287, "review_id": 1995779, "commentator": "customer", "customer_id": 9121167, "fullname": "Phương Nhyy", "avatar_url": "https://tiki.vn/assets/img/avatar.png", "content": "mình so sánh thử một vái trang đầu của bản eng và bản viet thì thấy một số từ nhiều nghĩa bị người dịch hiểu sai, nếu có cơ hội bẹn nên đọc thử cả bản eng nữa nhé", "score": 0, "create_at": 1588260011, "badge": "", "status": 1, "is_reported": false}], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 2641273, "title": "Nội dung tuyệt vời", "content": "Sau khi xem phim mình đã quyết định mua quyển này, vì chuyện tình trong phim quá đẹp, dũng cảm và chân thật - rất “người”. \nNội dung thì phải gọi là xuất sắc, lối hành văn và cách diễn đạt của tác giả cực kì sâu xa và đôi lúc phải ngừng lại và ngẫm nghĩ một lát mới thật sự liên hệ và cảm nhận được hết cảm xúc và nội tâm của nhân vật.\nTâm lí của Elio - nhân vật chính, dưới tài năng của mình, tác giả đã phác họa mạch cảm xúc đa chiều, phức tạp, mâu thuẫn và hết sức đẹp đẽ của tình yêu anh dành cho Oliver. Tất cả những dè chừng, những câu hỏi, những giận dỗi của Elio, được miêu tả chi tiết đến mức chính bản thân mình phải thốt lên rằng “Đây chính là cảm xúc của người đang yêu và chính mình cũng đã từng trải qua”, chắc hẳn ai cũng đã từng trải qua. Vì vậy mà mình nói nó rất “người”.\nTuy ngôn ngữ diễn đạt vô cùng “đỉnh” nhưng bản dịch hơi khó hiểu, khiến mình phải đọc đi đọc lại vài lần mới hiểu được ý văn.\nĐây là quyển sách mà chắc chắn mình sẽ đọc lại. Một mối tình mùa hè rất đẹp, rất mãnh liệt.", "status": "approved", "thank_count": 0, "score": 0.00449515, "new_score": 0.14470752, "customer_id": 1491003, "comment_count": 0, "rating": 4, "images": [], "thanked": false, "created_at": 1573748392, "created_by": {"id": 1491003, "name": "Trần Ngọc Hân", "full_name": "Trần Ngọc Hân", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2016-07-07 21:02:10", "purchased": true, "purchased_at": 1573489745, "contribute_info": {"id": 1491003, "name": "Trần Ngọc Hân", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joi