{"stars": {"1": {"count": 23, "percent": 1}, "2": {"count": 18, "percent": 1}, "3": {"count": 60, "percent": 1}, "4": {"count": 298, "percent": 9}, "5": {"count": 3178, "percent": 88}}, "rating_average": 4.8, "reviews_count": 3577, "review_photo": {"total": 702, "total_photo": 1069}, "data": [{"id": 16415734, "title": "Cực kì hài lòng", "content": "Cuốn sách bất ngờ. Một câu chuyện trinh thám dù người đọc đã biết thủ phạm là ai, nhưng tác giả vẫn đủ khôn khéo để dẫn dắt người đọc phải tò mò về sự chuyển biến của các nhân vật và cái kết của câu truyện.", "status": "approved", "thank_count": 0, "score": 27.77777778, "new_score": 0.15721897, "customer_id": 41720, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1653188050, "created_by": {"id": 41720, "name": "Bà Bông Bán CaFe", "full_name": "Bà Bông Bán CaFe", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2012-06-02 21:10:06", "group_id": 8, "purchased": true, "purchased_at": 1652232538, "contribute_info": {"id": 41720, "name": "Bà Bông Bán CaFe", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 15 năm", "total_review": 50, "total_thank": 27}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 17336365, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 17336364, "timeline": {"review_created_date": "2022-05-22 09:54:10", "delivery_date": "2022-05-15 10:12:25", "current_date": "2026-09-08 23:38:10", "content": "Đã dùng 7 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 7 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 3031176, "title": "Xuất sắc", "content": "Tiki giao hàng cho mình lần nào cũng tuyệt, sách đẹp, chưa bao giờ gặp tình trạng quăn mép hay sách cũ.\n\nVì mình ít đọc trinh thám nên không biết phải nhận xét những tình tiết trinh thám ấy như nào ngoài việc nói rằng nó rất logic và hợp lí từ đầu đến cuối. Mình chỉ có thể nêu cảm nhận chung sau khi đọc cuốn sách xuất sắc này thôi :3\n\n\nĐọc truyện không ấn tượng với\ntình yêu của Ishagami với Yasuki lắm vì\nthứ tình yêu ấy mình đã gặp rất nhiều\ntrong những tiểu thuyết ngôn tình rồi.\nĐó là một tình yêu hết mình, một tình yêu có thể hi sinh cả bản thân, bao gồm cả tự do, danh dự cho người con gái mà mình yêu quý. Đó cũng là thứ tình yêu tiêu cực, vì muốn che giấu tội ác của người yêu mà đã tạo ra một tội ác khác, vì muốn người yêu có thể sống tự do hạnh phúc (dù không phải là hạnh phúc bên mình) mà có thể giam cầm cả đời mình trong chốn lao tù. Vì tình yêu, Ishagami có thể làm tất cả.\n\nThế nhưng, tình bạn của Yugawa là điều làm mình ấn tượng hơn. Ishigami là bạn cũ, là đối thủ xứng tầm, là người Yugawa hiểu nhất cũng là nghi can chính của vụ án mạng. Kunasagi là bạn thân và là điều tra viên của vụ án đó. Yugawa đã làm tốt vai trò của một người bạn, dù vị trí là đứng ở giữa, dù phải làm trái với nguyện ý của Ishigami cũng không muốn người con gái kia nhởn nhơ sống mà không biết đến sự hi sinh của Ishigami với cô ta là lớn đến như nào.", "status": "approved", "thank_count": 2, "score": 0.01401815, "new_score": 0.14951224, "customer_id": 5617678, "comment_count": 0, "rating": 5, "images": [{"id": 830370, "full_path": "https://salt.tikicdn.com/ts/review/c0/62/bc/17169bdc7ebdd77f7440565c6e892119.jpg", "status": "approved"}], "thanked": false, "created_at": 1582178055, "created_by": {"id": 5617678, "name": "Nguyễn Thanh", "full_name": "Nguyễn Thanh", "region": null, "avatar_url": "https://salt.tikicdn.com/cache/512x512/ts/avatar/e4/d1/bc/1feef9de2a1fc86c69acc5be37047f85.png", "purchased": true, "purchased_at": 1581348161, "contribute_info": {"id": 5617678, "name": "Thuý Thanh", "avatar": "https://salt.tikicdn.com/cache/512x512/ts/avatar/e4/d1/bc/1feef9de2a1fc86c69acc5be37047f85.png", "