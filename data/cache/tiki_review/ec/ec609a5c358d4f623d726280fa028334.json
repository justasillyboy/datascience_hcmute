]}, "delivery_rating": []}, {"id": 2762318, "title": "RẤT HAY VÀ CẢM ĐỘNG", "content": "Một câu chuyện đầy tình người và động lực về cuộc sống. Một sự hy sinh đầy tính nhân văn. Cách viết vô cùng lôi cuốn, mặc dù đã biết trước kết quả nhưng bài toán Ishigami đặt ra vô cùng tài tình, *** hết các điều tra viên có tìm đi chăng nữa cũng không phải là kết quả đúng. \nBuồn nhất là tình bạn của Yukawa và Ishigami, vừa tìm được một người tri kỉ lại không thể giữ được. Nếu Yukawa xuất hiện sớm hơn, có lẽ Ishigami sẽ không vì chuyện này mà nghĩ quẩn, vì trước sau gì thì cũng không thể qua mắt Yukawa. Yukawa qua các truyện khác của Keigo cực kì đơn thân độc mã, và anh ý yêu thích chuyện đó. Nhưng, chứng kiến bạn mình - ngừoi tri kỉ có một không hai hay một THIÊN TÀI - đánh mất cuộc sống, mất đi cơ hội... \nCâu chuyện này thật sự buồn", "status": "approved", "thank_count": 7, "score": 0.0189444, "new_score": 0.14845, "customer_id": 737822, "comment_count": 2, "rating": 5, "images": [{"id": 717785, "full_path": "https://salt.tikicdn.com/ts/review/cb/8a/36/80ee6b275046d5338b6187e049d9ae65.jpg", "status": "approved"}], "thanked": false, "created_at": 1576860635, "created_by": {"id": 737822, "name": "Phan Như Ngọc", "full_name": "Phan Như Ngọc", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "purchased": true, "purchased_at": 1576379955, "contribute_info": {"id": 737822, "name": "Phan Như Ngọc", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 11 năm", "total_review": 5, "total_thank": 8}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 17336365, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 17336364, "timeline": {"review_created_date": "2019-12-20 23:50:35", "delivery_date": "2019-12-16 11:46:27", "current_date": "2026-09-08 23:38:10", "content": "Đã dùn