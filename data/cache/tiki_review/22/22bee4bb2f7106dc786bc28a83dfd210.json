 của các bạn nhỏ. NNA mang đến cho người đọc từ bất ngờ này đến bất ngờ khác. Người đọc dễ bị cuốn vào dòng cảm xúc của nhân vật. Càng đọc càng không thể bỏ cuốn sách xuống, cứ vừa đọc vừa hy vọng. Cách nhìn nhận cuộc sống theo hướng tích cực mà NNA mang lại qua nhân vật Tèo rất ý nghĩa.  5 sao cho nội dung sách.", "status": "approved", "thank_count": 15, "score": 0.00908378, "new_score": 0.15308085, "customer_id": 835440, "comment_count": 1, "rating": 5, "images": [{"id": 592131, "full_path": "https://salt.tikicdn.com/ts/review/44/13/93/d0cc5ebcb999f916a7beb0972ed4b186.jpg", "status": "approved"}, {"id": 592132, "full_path": "https://salt.tikicdn.com/ts/review/f2/ab/61/1e76551b7543d972fcdaa69a1adbd286.jpg", "status": "approved"}, {"id": 592133, "full_path": "https://salt.tikicdn.com/ts/review/5f/73/79/f6c2df24e96938df51b58d2dbe1acf86.jpg", "status": "approved"}], "thanked": false, "created_at": 1569917301, "created_by": {"id": 835440, "name": "Nhan Phan", "full_name": "Nhan Phan", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "purchased": true, "purchased_at": 1569576690, "rank": 5, "badge": "Bút mới nổi", "badge_icon": "https://vcdn.tikicdn.com/assets/img/review-badge/badge-5.png", "contribute_info": {"id": 835440, "name": "Nhan Phan", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 11 năm", "total_review": 113, "total_thank": 114}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 31509727, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 31509726, "timeline": {"review_created_date": "2019-10-01 15:08:21", "delivery_date": "2019-09-30 10:43:34", "current_date": "2026-09-08 12:59:10", "content": "Đã dùng 1 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 ngày."}, "comments": [{"id": 384933, "review_id": 2490363, "commenta