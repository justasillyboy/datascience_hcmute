o chính sự ngây thơ trẻ nhỏ trước nghịch cảnh, chính sự hiểu chuyện của mấy cô cậu nhóc tì, làm người trưởng thành càng đọc càng thấy xót xa và đau nhói.\r\nCảm ơn tác giả mang lại câu chuyện tưởng như bình thường lại rất đời và thật gần gũi!!", "status": "approved", "thank_count": 0, "score": 33.33333333, "new_score": 0.17412554, "customer_id": 20366126, "comment_count": 0, "rating": 5, "images": [{"id": 4305499, "full_path": "https://salt.tikicdn.com/ts/review/87/c7/05/07966e079b19395d34243b93e5c66f13.jpg", "status": "approved"}], "thanked": false, "created_at": 1698830330, "created_by": {"id": 20366126, "name": "Dương Vàng", "full_name": "Dương Vàng", "region": null, "avatar_url": "https://salt.tikicdn.com/cache/512x512/ts/avatar/86/ef/a2/4bca8808da81dafe0a0b8c49a7753e73.png", "created_time": "2021-02-19 07:46:35", "group_id": 8, "purchased": true, "purchased_at": 1698822118, "contribute_info": {"id": 20366126, "name": "Dương Thị Kim Vàng", "avatar": "https://salt.tikicdn.com/cache/512x512/ts/avatar/86/ef/a2/4bca8808da81dafe0a0b8c49a7753e73.png", "summary": {"joined_time": "Đã tham gia 6 năm", "total_review": 32, "total_thank": 9}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 31509727, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "21/ce/5c/b52d0b8576680dc3666474ae31b091ec.jpg"}, "product_id": 31509726, "timeline": {"review_created_date": "2023-11-01 16:18:50", "delivery_date": "2023-11-01 15:36:00", "current_date": "2026-09-08 12:59:09", "content": "Đã dùng 1 giờ", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 giờ."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": [{"question": "Thời gian giao hàng?", "option": "Giao đúng hẹn"}, {"question": "Thái độ của shipper?", "option": "Lịch sự"}, {"question": "Giờ giao hàng?", "option": "Có hẹn giờ trước"}, {"question": "Cách đóng gói sản phẩm?", "option": "Cẩn thận"}]}, {"id": 6105750, "ti