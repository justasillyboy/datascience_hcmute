 riêng mình.\r\nP/s: cho 4* vì Nhã Nam xem lại cty in, sách in đôi chỗ mực nhoè, chất lượng giấy k mượt. Sách in 2019.", "status": "approved", "thank_count": 0, "score": 33.33333333, "new_score": 0.1552175, "customer_id": 11037253, "comment_count": 0, "rating": 4, "images": [{"id": 1430051, "full_path": "https://salt.tikicdn.com/ts/review/db/50/98/35c7b7686a3721082cb9f41e50b8ff31.jpg", "status": "approved"}], "thanked": false, "created_at": 1609306024, "created_by": {"id": 11037253, "name": "Duyen Hanh", "full_name": "Duyen Hanh", "region": null, "avatar_url": "https://lh5.googleusercontent.com/-0c8F-fDyB64/AAAAAAAAAAI/AAAAAAAAAEM/RNlf7Dzxp8A/photo.jpg", "purchased": true, "purchased_at": 1609140315, "contribute_info": {"id": 11037253, "name": "Duyen Hanh", "avatar": "https://lh5.googleusercontent.com/-0c8F-fDyB64/AAAAAAAAAAI/AAAAAAAAAEM/RNlf7Dzxp8A/photo.jpg", "summary": {"joined_time": "Đã tham gia 8 năm", "total_review": 20, "total_thank": 38}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 8886000, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 8885999, "timeline": {"review_created_date": "2020-12-30 12:27:04", "delivery_date": "2020-12-29 13:22:40", "current_date": "2026-09-07 23:49:07", "content": "Đã dùng 1 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 17086729, "title": "Hài lòng", "content": "Hàng giao đúng hạn nhưng do không có bọc khí nên sách bị nhăn ở vài góc.", "status": "approved", "thank_count": 0, "score": 44.44444444, "new_score": 0.15429126, "customer_id": 27393586, "comment_count": 0, "rating": 4, "images": [{"id": 3692632, "full_path": "https://salt.tikicdn.com/ts/review/70/b8/57/f74bc0f1826bfb27ce401b953a4bb2a7.jpg", "status": "approved"}, {"id"