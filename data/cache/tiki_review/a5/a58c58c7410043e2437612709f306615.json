{"stars": {"1": {"count": 12, "percent": 1}, "2": {"count": 13, "percent": 1}, "3": {"count": 23, "percent": 1}, "4": {"count": 165, "percent": 8}, "5": {"count": 1910, "percent": 89}}, "rating_average": 4.9, "reviews_count": 2123, "review_photo": {"total": 307, "total_photo": 471}, "data": [{"id": 17890959, "title": "Hài lòng", "content": "Giao hàng nhanh\r\nSách mới nguyên\r\nNhân viên giao hàng lịch sự, nhanh nhẹn.\r\nChưa đọc chưa nhận xét nối dung được.\r\nĐóng gói chỉ có hộp, ko chèn, may mà ko chuyển xa nên sách ko sứt mẻ gì.", "status": "approved", "thank_count": 0, "score": 50, "new_score": 0.16827144, "customer_id": 68708, "comment_count": 0, "rating": 4, "images": [{"id": 3918943, "full_path": "https://salt.tikicdn.com/ts/review/99/24/ff/31a4bb3d7828ec5b81096b2e3600c9a0.jpg", "status": "approved"}, {"id": 3918944, "full_path": "https://salt.tikicdn.com/ts/review/8b/47/4d/d9dcd5a79d302a49cad62b1fbda35cf2.jpg", "status": "approved"}, {"id": 3918945, "full_path": "https://salt.tikicdn.com/ts/review/51/38/2a/fdc22ec8d2fd85e4eb0a67155302ad09.jpg", "status": "approved"}, {"id": 3918946, "full_path": "https://salt.tikicdn.com/ts/review/9d/26/6d/892763f21974b3a395295c241a08c7b7.jpg", "status": "approved"}], "thanked": false, "created_at": 1665115486, "created_by": {"id": 68708, "name": "Lê Bá Ninh", "full_name": "Lê Bá Ninh", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2012-11-04 20:18:05", "group_id": 8, "purchased": true, "purchased_at": 1665046981, "contribute_info": {"id": 68708, "name": "Lê Bá Ninh", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 14 năm", "total_review": 28, "total_thank": 3}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 8886000, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 8885999, "timeline": {"review_created_date": "2022-10-07 11:04:46", "delivery_date": "2022-10-07 10:44:16", "current_date": "2026-09-07 23:49:07", "content": "Đã dùng 21 phút", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 21 phút."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 19042128, "title": "Hài lòng", "content": "Sách còn mới nguyên, tuy rằng mình không thích tiki đóng gói không bọc gì thêm nhưng hiện mình chưa nhận dính cuốn nào bị hỏng. \r\nTotto-Chan bên cửa sổ - Kuroyanagy Tetsuko\r\nMở đầu tháng 04 bằng một câu chuyện hết sức dễ thương đánh tan mọi nghi ngờ của mình về tác giả Nhật văn phong Nhật không hay như lần đầu tiên mình đọc trước đó. Thực sự mình recomment cho các cô, thầy giáo, các mẹ có con nhỏ đọc cuốn này. Sách được xuất bản từ năm 1981 tức là cách đây hơn 40 năm rồi, đọc xong mình mới biết thực sự không chỉ về kinh tế mà cả về giáo dục Nhật Bản đã đi trước nước mình từ rất lâu.\r\nCâu truyện là tự truyện của chính tác giả kể lại thời còn đi học tiểu học ở ngôi trường Tomoe xinh đẹp và đặc biệt, nơi có người thầy hiệu trưởng đáng kính Kobayashi Sosaku và các bạn của mình. Câu chuyện tái hiện lại sự ngây thơ và trong trẻo về tuổi thơ về sự hiếu động, nghịch ngợm, tò mò mọi thứ về thế giới xung quanh như chính chúng ta thời con trẻ, đôi khi còn bị mang cái mác “đứa trẻ hư”. Câu chuyện dạy cho ta về sự thấu hiểu, sẻ chia và hiểu hơn về suy nghĩ của trẻ nhỏ về tình bạn, tình thầy trò, tình yêu, ước mơ và hoài bão thông qua TottoChan và quan trọng nhất là thông điệp về giáo dục mà thầy hiệu trưởng Kobayashi Sosaku đã nói “Hãy để các em phát triển tự nhiên. Đừng cản trở sự khát vọng của các em nhỏ. Ước mơ của các em lớn hơn mơ ước của các thầy cô nữa đấy”. Thông điệp như nói để các em phát triển tự nhiên, cứ để các em tò mò về thế giới và chỉ dạy các em những điều đúng đắn nhất sẽ giúp các em lớn lên trưởng thành trở thành người tốt và có ích cho xã hội.\r\nP/s: Tranh vẽ minh hoạ của tác giả Iwasaki Chihiro rất đẹp.", "status": "approved", "thank_count": 0, "score": 38.88888889, "new_score": 0.17323827, "customer_id": 28986403, "comment_count": 0, "rating": 4, "images": [{"id": 4175501, "full_path": "https://salt.tikicdn.com/ts/review/62/91/6f/a27080a7a2d931cf5ef2742030cec764.jpg", "status": "approved"}, {"id": 4175502, "full_path": "https://salt.tikicdn.com/ts/review/b7/48/83/d00cb6b4c479b6f9f210daa3534fe9eb.jpg", "status": "approved"}], "thanked": false, "created_at": 1680425169, "created_by": {"id": 28986403, "name": "Phùng Thái", "full_name": "Phùng Thái", "region": null, "avatar_url": "https://salt.tikicdn.com/cache/512x512/ts/avatar/97/9f/d1/0fdad76e51809aedb9a37487cb6856f2.png", "created_time": "2023-03-24 20:45:04", "group_id": 8, "purchased": true, "purchased_at": 1680051726, "contribute_info": {"id": 28986403, "name": "Phùng Thái", "avatar": "https://salt.tikicdn.com/cache/512x512/ts/avatar/97/9f/d1/0fdad76e51809aedb9a37487cb6856f2.png", "summary": {"joined_time": "Đã tham gia 4 năm", "total_review": 41, "total_thank": 3}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 8886000, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 8885999, "timeline": {"review_created_date": "2023-04-02 15:46:09", "delivery_date": "2023-03-30 09:44:54", "current_date": "2026-09-07 23:49:07", "content": "Đã dùng 3 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 3 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 18642271, "title": "Hài lòng", "content": "Sách mới tái bản năm 2022. Nhưng mua 3 cuốn thì 1 cuốn bị rách chút phần đai sách, 1 cuốn thì bị bẩn bên mép. Mong bên bán cẩn thận hơn.", "status": "approved", "thank_count": 0, "score": 38.88888889, "new_score": 0.16002954, "customer_id": 7564725, "comment_count": 0, "rating"