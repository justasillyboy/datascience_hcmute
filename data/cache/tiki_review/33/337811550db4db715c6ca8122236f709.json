thận"}]}, {"id": 20162839, "title": "Cực kì hài lòng", "content": "Cuốn sách lớn đúng nghĩa tuy không dài. Văn Han Kang luôn tinh tế và xoáy sâu vào những vấn đề trong tâm lý con người. Truyện chia làm 7 phần từ 7 con người khác nhau, lối viết phân mảnh ấy phù hợp tuyệt đối với nội dung của cuốn sách này. Mình đã rất xúc động khi đọc đến đoạn nhắc về chiến tranh tại Việt Nam và những cuộc chiến trên toàn thế giới trong đây.", "status": "approved", "thank_count": 0, "score": 33.33333333, "new_score": 0.18622423, "customer_id": 2228190, "comment_count": 0, "rating": 5, "images": [{"id": 4412635, "full_path": "https://salt.tikicdn.com/ts/review/85/ac/13/4dbe8f17e062100aef300039794fe9e0.jpg", "status": "approved"}], "thanked": false, "created_at": 1756114217, "created_by": {"id": 2228190, "name": "Dương Thùy Dung", "full_name": "Dương Thùy Dung", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2017-03-02 13:56:57", "group_id": 8, "purchased": true, "purchased_at": 1741511804, "contribute_info": {"id": 2228190, "name": "Dương Thùy Dung", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 10 năm", "total_review": 34, "total_thank": 8}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 30757179, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 30757177, "timeline": {"review_created_date": "2025-08-25 16:30:17", "delivery_date": "2025-03-10 09:26:36", "current_date": "2026-09-08 12:48:35", "content": "Đã dùng 1 năm", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 năm."}, "comments": [], "vote_attributes": {"agree": ["in ấn/màu sắc rõ nét", "Khổ sách nhỏ gọn, dễ mang đi", "Nội dung sách hấp dẫn, bổ ích", "Trình bày/Bố cục dễ hiểu"], "disagree": []}, "delivery_rating": []}, {"id": 15801088, "title": "Cực kì hài lòng", "content": "Cuốn sách tái hiện phong trào dân chủ Gwangju đầy sống động, ta thấy được sự đấu tranh khốc liệt của người dân, thấy được quân lính tàn bạo dã man đến nhường nào và sự máu lạnh vô nhân tính của chính phủ Hàn Quốc. \nCác nhân vật đưa ta vào bên trong cuộc chiến, sâu bên trong nội tâm của họ. Để thấy được nỗi mất mát, đau đớn cào cấu giằng xé không hồi kết. Dù là nạn nhân hay là người thân của người đã chết trong cuộc thảm sát này thì cuộc sống về sau của họ đều ĐAU ĐỚN. Họ trở thành cái xác không linh hồn, chẳng còn được sống như những người bình thường được nữa. \n\"Tôi đang chiến đấu. Ngày nào tôi cũng một mình chiến đấu. Tôi chiến đấu với nỗi nhục nhã vì mình đã sống sót, và vì mình vẫn còn đang sống tiếp.\"\nĐây là một cuốn sách hay mn nên đọc nhé!!", "status": "approved", "thank_count": 1, "score": 0.05090748, "new_score": 0.16966444, "customer_id": 18075264, "comment_count": 0, "rating": 5, "images": [{"id": 3325964, "full_path": "https://salt.tikicdn.com/ts/review/59/6c/50/c65b2d9e95930fe29cae7d820babae07.jpg", "status": "approved"}, {"id": 3325965, "full_path": "https://salt.tikicdn.com/ts/review/f7/a3/c0/0dfdff44de6ebe000a58714d6e96eaee.jpg", "status": "approved"}, {"id": 3325966, "full_path": "https://salt.tikicdn.com/ts/review/ac/67/2b/d39703df9bb3777d2ea2d7a9bac68e5c.jpg", "status": "approved"}], "thanked": false, "created_at": 1649242336, "created_by": {"id": 18075264, "name": "Hương Yeon", "full_name": "Hương Yeon", "region": null, "avatar_url": "https://salt.tikicdn.com/cache/512x512/ts/avatar/ec/65/12/db548badb7ceea534fa969dcc17f197e.png", "created_time": "2020-08-11 22:46:55", "group_id": 8, "purchased": true, "purchased_at": 1648314347, "contribute_info": {"id": 18075264, "name": "Hương Yeon", "avatar": "https://salt.tikicdn.com/cache/512x512/ts/avatar/ec/65/12/db548badb7ceea534fa969dcc17f197e.png", "summary": {"joined_time": "Đã tham gia 6 năm", "total_review": 53, "total_thank": 17}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "