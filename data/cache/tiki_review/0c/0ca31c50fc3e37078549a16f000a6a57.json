"region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2018-06-02 13:28:47", "group_id": 8, "purchased": true, "purchased_at": 1636565361, "contribute_info": {"id": 7230605, "name": "Phạm Thị Tuyết Mai", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 8 năm", "total_review": 11, "total_thank": 15}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 77105731, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 77105730, "timeline": {"review_created_date": "2021-11-21 17:29:13", "delivery_date": "2021-11-12 11:44:42", "current_date": "2026-09-07 23:54:14", "content": "Đã dùng 9 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 9 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 18721777, "title": "Cực kì hài lòng", "content": "Đây là câu chuyện của cái đẹp.\r\nToàn bộ câu chuyện được kể qua góc nhìn của Quản gia Stevens - trọn gói cùng Dinh thự Darlington.\r\nStevens đã kể lại sự nghiệp của mình trong sự bình thản, hết mực trân quý và tôn trọng, tự hào về sự chuyên nghiệp và phẩm cách của nghề quản gia trong hầu hết mọi trường hợp mà ông đã đối mặt. Mọi thứ đều đẹp. Thấy một con người trân quý nghề của mình như vậy thật đẹp. Nhưng cũng rất tàn nhẫn.\r\nStevens đã khái quát hoá cuộc đời mình trong nghề nghiệp của ông. Ông chưa từng nhận ra mình thật sự là ai, đã đánh mất những gì. Ông luôn coi gánh nặng mình mang là sự tự hào của một quản gia có phẩm cách. Ông đã đặt nhẹ cuộc sống cá nhân của mình, tôn sùng chủ nhân của mình, và lấy đó làm lẽ sống.\r\nTôi cực kỳ ấn tượng với cung cách Stevens thể hiện. Và cũng buồn vì những tháng ngày dài đằng đẵng cô độc sắp tới. Tàn ngày, Stevens cất gọn cá nhân mình vào một góc, trở lại là một gói đi kèm Dinh thự Darlington.\r\nTruyện có một số lỗi dịch và biên, tuy nhiên tôi hiểu để lột tả đc ngôn từ Stevens sử dụng cho phù hợp đã là sự cố gắng rất lớn từ phía dịch giả và nhà phát hành.\r\nXin hãy trân trọng câu chuyện này, câu chuyện về một cái đẹp thơ dại đang dần tàn lụi.", "status": "approved", "thank_count": 1, "score": 0.74814815, "new_score": 0.16616986, "customer_id": 162493, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1675308982, "created_by": {"id": 162493, "name": "Nguyễn Minh Trang", "full_name": "Nguyễn Minh Trang", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2013-08-21 19:26:13", "group_id": 8, "purchased": true, "purchased_at": 1671123008, "contribute_info": {"id": 162493, "name": "Nguyễn Minh Trang", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 13 năm", "total_review": 43, "total_thank": 78}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 77105731, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 77105730, "timeline": {"review_created_date": "2023-02-02 10:36:22", "delivery_date": "2022-12-16 15:35:28", "current_date": "2026-09-07 23:54:14", "content": "Đã dùng 2 tháng", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 2 tháng."}, "comments": [], "vote_attributes": {"agree": ["chất lượng giấy tốt", "in ấn/màu sắc rõ nét", "Khổ sách nhỏ gọn, dễ mang đi", "Nội dung hấp dẫn"], "disagree": []}, "delivery_rating": []}, {"id": 18713268, "title": "Cực kì hài lòng", "content": "Sách đẹp lắm nhưng hk có bọc lại trong quá trình vận chuyển nên hơi biến dạng ở chỗ gáy sách", "status": "approved", "thank_count": 0, "score": 0.63948841, "new_score": 0.15993674, "customer_id": 26460358, "comment_count": 0, "rating": 5, "images": [{"id": 4105676, "full_path": "https://salt.tikicdn.com/ts/review/f0/2a/7f/09e89b6ec38ff22163d8ac7db300df05.jpg", "status": "approved"}, {"id": 4105677, "full_path": "https://salt.tikicdn.com/ts/review/1c/61/14/c3dec5c094dacfdccc08ab5a6933368f.jpg", "status": "approved"}, {"id": 4105678, "full_path": "https://salt.tikicdn.com/ts/review/be/bf/7a/dd3b99db752117d38b0ad7123dae711f.jpg", "status": "approved"}], "thanked": false, "created_at": 1675209753, "created_by": {"id": 26460358, "name": "Phạm Ngoc Thi", "full_name": "Phạm Ngoc Thi", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2022-01-11 12:25:19", "group_id": 8, "purchased": true, "purchased_at": 1674781455, "contribute_info": {"id": 26460358, "name": "Phạm Ngoc Thi", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 5 năm", "total_review": 7, "total_thank": 1}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 77105731, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 77105730, "timeline": {"review_created_date": "2023-02-01 07:02:33", "delivery_date": "2023-01-31 11:43:39", "current_date": "2026-09-07 23:54:14", "content": "Đã dùng 1 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 18617226, "title": "Cực kì hài lòng", "content": "Cuốn sách của Ishiguro triển khai rất chậm trong lời kể rù rì của người kể chuyện về già, giữa một chuyến đi miên man qua những vùng đồng quê không có biến cố gì xảy ra, nhưng lần lần, những ký ức ngày càng mở rộng của Stevens đã cuốn hút người đọc vào những mạch truyện đan cài: chuyện của Stevens, chuyện của cô đồng nghiệp cũ, chuyện của ông chủ cũ, và cả chuyện những người dân gặp trên đường đi về miền Tây nước Anh. Đến cuối sách, những mạch truyện theo nhau gút lại khiến người đọc nhận ra, câu chuyện không hẳn như Stevens kể, những con người trong đó cũng không hẳn như Stevens kể, và bản thân Stevens cũng không hẳn như Stevens kể; có những tầng sâu không chỉ của sự kiện, cảm xúc mà của cả định nghĩa về phận người, của sự tự mị bản thân. Tàn ngày để lại thuộc vào loại sách để đọc lại, và không chỉ một lần, bởi dưới những sự kiện thoạt trông chẳng có gì kia lại có nhiều hơn những gì được nói\r\n\r\nĐoạt giải Booker năm 1989, Tàn ngày để lại khẳng định Ishiguro không chỉ như một bậc thầy về tiểu thuyết, mà còn là bậc thầy về ngôn ngữ, được nhà văn Anh Julian Barnes ca ngợi về “lối kể chuyện tài tình và khả năng kiểm soát giọng điệu hoàn mỹ”, và khiến tất cả những cuốn sách mới của ông từ đó về sau đều được bạn đọc thế giới trông đợi. Tàn ngày để lại được dựng thành phim năm 1993 với sự tham gia của Anthony Hopkins và Emma Thompson, nhận được 8 đề cử Oscar", "status": "approved", "thank_count": 2, "score": 0.004571, "new_score": 0.16578234, "customer_id": 13552782, "comment_count": 0, "rating": 5, "images": [], "thanked": false, "created_at": 1673416410, "created_by": {"id": 13552782, "name": "Hi và hi", "full_name": "Hi và hi", "region": null, "avatar_url": "https://salt.tikicdn.com/cache/512x512/ts/avatar/2f/03/e6/c419db08b6ab65e80bdb28c8eded09a1.png", "created_time": "2019-08-19 21:31:40", "group_id": 8, "purchased": true, "purchased_at": 1661662947, "contribute_info": {"id": 13552782, "name": "Hi và hi", "avatar": "https://salt.tikicdn.com/cache/512x512/ts/avatar/2f/03/e6/c419db08b6ab65e80bdb28c8eded09a1.png", "summary": {"joined_time": "Đã tham gia 7 năm", "total_review": 106, "total_thank": 151}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 77105731, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "21/ce/5c/b52d0b8576680dc3666474ae31b091ec.jpg"}, "product_id": 77105730, "timeline": {"review_created_date": "2023-01-11 12:53:30", "delivery_date": "2022-08-29 14:32:59", "cur