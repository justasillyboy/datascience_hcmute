: "https://salt.tikicdn.com/ts/review/69/bf/74/4e72723b9a9810c7f161776c24d70084.jpg", "status": "approved"}, {"id": 4374136, "full_path": "https://salt.tikicdn.com/ts/review/2d/b4/52/1465a4259ed48b45703c3f8fc8dfe66a.jpg", "status": "approved"}, {"id": 4374137, "full_path": "https://salt.tikicdn.com/ts/review/b1/06/8f/d94e91e201254e4c50d913adc9aaaf38.jpg", "status": "approved"}], "thanked": false, "created_at": 1724832307, "created_by": {"id": 11444654, "name": "Hồ Thị Anh Mỹ", "full_name": "Hồ Thị Anh Mỹ", "region": null, "avatar_url": "https://salt.tikicdn.com/cache/512x512/ts/avatar/9f/ed/65/e2744bae7dc55a9ad4eac4d7617de033.png", "created_time": "2019-03-22 17:15:20", "group_id": 8, "purchased": true, "purchased_at": 1724702742, "contribute_info": {"id": 11444654, "name": "Hồ Thị Anh Mỹ", "avatar": "https://salt.tikicdn.com/cache/512x512/ts/avatar/9f/ed/65/e2744bae7dc55a9ad4eac4d7617de033.png", "summary": {"joined_time": "Đã tham gia 8 năm", "total_review": 28, "total_thank": 130}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 10862753, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg"}, "product_id": 631034, "timeline": {"review_created_date": "2024-08-28 15:05:07", "delivery_date": "2024-08-28 09:50:37", "current_date": "2026-09-08 00:48:18", "content": "Đã dùng 5 giờ", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 5 giờ."}, "comments": [{"id": 3244833, "review_id": 19965910, "commentator": "seller", "customer_id": 1, "fullname": "Tiki Trading", "avatar_url": "https://vcdn.tikicdn.com/ts/seller/d1/3f/ae/13ce3d83ab6b6c5e77e6377ad61dc4a5.jpg", "content": "Cảm ơn chị Anh Mỹ đã tin tưởng Tiki và cho Tiki 5⭐️! Tiki yêu chị nhiều ❤️", "score": 0, "create_at": 1724913132, "badge": "https://salt.tikicdn.com/ts/review/05/6f/c0/d7462c4721ae3d6aabb2f51ff13fa44f.png", "status": 2, "is_reported": false}], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": [{"question": "Thời gian giao hàng?", "option": "Giao đúng hẹn"}, {"question": "Thái độ của shipper?", "option": "Lịch sự"}, {"question": "Giờ giao hàng?", "option": "Có hẹn giờ trước"}, {"question": "Cách đóng gói sản phẩm?", "option": "Cẩn thận"}]}, {"id": 2823848, "title": "Hài lòng, sp cấp ẩm tốt, ngon bổ rẻ", "content": "Mình dùng em sửa rữa mặt (srm) Hada Labo Advanced Nourish- Hyaluron Cleanser này cũng gần hết tuýp thứ 3 rồi, tất nhiên là mình vẫn thấy thích lắm. Nhưng đây là lần đầu mình dùng ứng dụng mua sắm trực tuyến tại trang Tiki, vì thấy được sự tiện lợi, được mua hàng chính hãng, mà không quá tốn thời gian lựa chọn, lại còn được giao hàng tận nhà luôn. Cảm nghĩ về dịch vụ mua & vận chuyển của Tiki rất ổn nhé! Đối với sản phẩm này thì mình dùng cũng đủ nhiều nên các bạn nào muốn dùng thử thì đừng ngại ngùng chi, hãy nhanh tay đặt hàng đi nè! Đặc biệt với các bạn da khô thì càng cần mua đấy, bởi dưỡng ẩm của em này ok lắm. Xài là sẽ phê cho mà coi ^^ \nNói về thiết kế: em này có dạng tuýp như hình, với hai màu chủ đạo là trắng và xanh da trời rất thanh tao, nhã nhặn, rất Hada Labo, rất Nhật.\nCảm nhận sau khi dùng: Sp có một mùi thơm nhẹ không gây khó chịu lắm. Khả năng tạo bọt của em này mình đánh giá là rất tốt, mình dùng tay không cũng đã tạo được 1 lượng kha khá rồi chưa kể còn dùng lưới tạo bọt. Lớp bọt mịn, len lỏi sâu vào tận lỗ chân lông giúp làm sạch da một cách hiệu quả hơn rất nhiều. Khi rửa mặt xong thì mình thấy da cực kì mềm, sạch vừa phải chứ không sạch quá dân đến khô kin kít. Đối với mình đây là loại srm cho mình finish đã nhất luôn ấy, da mềm mịn, căng mọng mà vẫn đủ nước. Dùng em này còn giúp mình giảm bớt 1 ít mụn cám nữa cơ mà. Độ pH của sản phẩm này là 5.5 và đây là độ pH rất hợp lí cho da mặt.\nƯu điểm: Rẻ với túi tiền sinh viên; rửa đủ sạch mà không làm khô da; thành phần ổn; bao bì đơn giản, mùi nhẹ nhàng, không gây khó chịu; dễ tìm mua chính hãng, đỡ sợ hàng giả.\nNhược điểm: Trừ khi bị dị ứng với thành phần trong srm, còn không thì không có chỗ nào để chê được\nNếu bạn đang muốn tìm 1 loại srm có đầy đủ chức năng cơ bản, quan trọng là rửa nhẹ nhàng không gây khô da, ở phân khúc giá rẻ thì mua em ấy dùng thử đi!", "status": "approved", "thank_count": 44, "score": 0.00372897, "new_score": 0.1521704, "customer_id": 13076741, "comment_count": 1, "rating": 5, "images": [{"id": 741070, "full_path": "https://salt.tikicdn.com/ts/review/4a/3d/f2/2f83ab8354bdb70a54bfd43f64abdbd9.jpg", "status": "approved"}, {"id": 741071, "full_path": "https://salt.tikicdn.com/ts/review/e2/60/18/88793bf77569dd1ffd719925ce3ccda9.jpg", "status": "approved"}], "thanked": false, "created_at": 1578140333, "created_by": {"id": 13076741, "name": "Nguyễn Thị Kim Ngân", "full_name": "Nguyễn Thị Kim Ngân", "region": null, "avatar_url": "https://platform-lookaside.fbsbx.com/platform/profilepic/?asid=1337574779744023&height=200&width=200&ext=1566625373&hash=AeQU4WSzCHAoqrKJ", "created_time": "2019-07-25 12:43:57", "group_id": 7, "purchased": true, "purchased_at": 1577801947, "contribute_info": {"id": 13076741, "name": "Nguyễn Thị Kim Ngân", "avatar": "https://platform-lookaside.fbsbx.com/platform/profilepic/?asid=1337574779744023&height=200&width=200&ext=1566625373&hash=AeQU4WSzCHAoqrKJ", "summary": {"joined_time": "Đã tham gia 7 năm", "total_review": 3, "total_thank": 45}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 10862753, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 631034, "timeline": {"review_created_date": "2020-01-04 19:18:53", "delivery_date": "2020-01-03 13:51:05", "current_date": "2026-09-08 00:48:18", "content": "Đã dùng 1 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 ngày."}, "comments": [{"id": 486018, "review_id": 2823848, "commentator": "customer", "customer_id": 13062106, "