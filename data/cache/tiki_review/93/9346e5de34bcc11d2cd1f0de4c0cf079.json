n được sách đẹp như trong hình, mọi thứ về hình thức đều tốt. Nếu có thêm bookmark thì tuyệt hơn.", "status": "approved", "thank_count": 3, "score": 0.00299248, "new_score": 0.15620719, "customer_id": 7625585, "comment_count": 0, "rating": 5, "images": [{"id": 1174912, "full_path": "https://salt.tikicdn.com/ts/review/9e/f7/15/17fec5c38b178a6450497d032a3bdf65.jpg", "status": "approved"}, {"id": 1174913, "full_path": "https://salt.tikicdn.com/ts/review/32/e6/cb/3fb74bc6c9bc4195d94d5b28797a1c39.jpg", "status": "approved"}], "thanked": false, "created_at": 1599614796, "created_by": {"id": 7625585, "name": "Nguyễn Đức Huy", "full_name": "Nguyễn Đức Huy", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2018-08-10 16:13:41", "group_id": 8, "purchased": true, "purchased_at": 1599536914, "contribute_info": {"id": 7625585, "name": "Nguyễn Đức Huy", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 8 năm", "total_review": 4, "total_thank": 3}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 42230122, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "21/ce/5c/b52d0b8576680dc3666474ae31b091ec.jpg"}, "product_id": 42230121, "timeline": {"review_created_date": "2020-09-09 08:26:36", "delivery_date": "2020-09-08 18:43:54", "current_date": "2026-09-08 13:09:48", "content": "Đã dùng 1 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 16173325, "title": "Cực kì hài lòng", "content": "hôm qua đặt, hôm nay có. giao hàng rất nhanh cảm ơn Tiki rất nhiều. điểm trừ là duy nhất là ko bọc sách bằng 1 lớp xốp hoặc túi khí.", "status": "approved", "thank_count": 0, "score": 44.44444444, "new_score": 0.15814068, "customer_id": 22064249, "comment_count": 0, "rating": 5, "images": [{"id": 3432735, "full_path": "https://salt.tikicdn.co