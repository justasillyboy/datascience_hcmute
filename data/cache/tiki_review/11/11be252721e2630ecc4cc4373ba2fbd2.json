SCONCELOS.\n\" Ai ở trên đời, thì tức là người đó đều xứng đáng được sinh ra con ạ. Con cũng thế.\"", "status": "approved", "thank_count": 0, "score": 33.33333333, "new_score": 0.16164239, "customer_id": 1901059, "comment_count": 0, "rating": 5, "images": [{"id": 2902199, "full_path": "https://salt.tikicdn.com/ts/review/0d/0e/cd/5d2d7a38b2ed4add270175a25e0ed504.jpg", "status": "approved"}], "thanked": false, "created_at": 1639726082, "created_by": {"id": 1901059, "name": "Ngọc Truyền Phan", "full_name": "Ngọc Truyền Phan", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2016-11-17 22:22:17", "purchased": true, "purchased_at": 1639320122, "contribute_info": {"id": 1901059, "name": "Ngọc Truyền Phan", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 10 năm", "total_review": 9, "total_thank": 5}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 74021318, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 74021317, "timeline": {"review_created_date": "2021-12-17 14:28:02", "delivery_date": "2021-12-16 12:33:02", "current_date": "2026-09-08 23:21:56", "content": "Đã dùng 1 ngày", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 1 ngày."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 17134594, "title": "Cực kì hài lòng", "content": "Chưa đọc nên k đánh giá về nội dung, cơ mà đợt này tiki đóng hàng chán quá, hộp to hơn sách rất nhiều, cho 2 tờ giấy chèn vào cho có chả có tác dụng gì. May Nhã Nam bọc màng nên không sao", "status": "approved", "thank_count": 1, "score": 2.52688172, "new_score": 0.16110933, "customer_id": 26874988, "comment_count": 0, "rating": 5, "images": [{"id": 3707643, "full_path": "https://salt.tikicdn.com/ts/review/1b/66/0f/fc5b2dc6bacefe3db22fb697672ac9b