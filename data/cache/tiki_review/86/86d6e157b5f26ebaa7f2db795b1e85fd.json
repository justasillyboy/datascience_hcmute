g tiếp theo. Trường hợp cần hỗ trợ thêm, bạn có thể liên hệ với Tiki qua hộp thư hotro@tiki.vn hoặc hotline 1900-6035. Trân trọng.", "score": 0, "create_at": 1566283284, "badge": "https://salt.tikicdn.com/ts/review/05/6f/c0/d7462c4721ae3d6aabb2f51ff13fa44f.png", "status": 1, "is_reported": false}], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 2087542, "title": "sách", "content": "Đây là lỗi của nhà xuất bản hoặc bên bảo quản hàng, sách mình mua tặng nhưng bị trầy rách vết rõ to.\nMình biết sách dày, mình đã bỏ qua lỗi trầy ở gáy và một số chỗ khác nhưng vết này mình khẳng định không phải do sự quá khổ của sách!!  \nsách vừa trầy vừa bị vàng \n( chất liệu sách không tốt lắm, hơi nhẹ so vs hơn nghìn trang) \nMình thực sự muốn đổi trả hàng", "status": "approved", "thank_count": 40, "score": 0.00727052, "new_score": 0.14369644, "customer_id": 527407, "comment_count": 5, "rating": 2, "images": [{"id": 387840, "full_path": "https://salt.tikicdn.com/ts/review/47/f5/98/c20531c04daca3239fd294e0eddb1bf5.jpg", "status": "approved"}], "thanked": false, "created_at": 1552453039, "created_by": {"id": 527407, "name": "Lê Thùy Dương", "full_name": "Lê Thùy Dương", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "purchased": true, "purchased_at": 1552361361, "contribute_info": {"id": 527407, "name": "Lê Thùy Dương", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 12 năm", "total_review": 4, "total_thank": 40}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 7982629, "is_photo": true, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 7982628, "timeline": {"review_created_date": "2019-03-13 11:57:19", "delivery_date": "2019-03-13 11:48:25", "current_date": "2026-09-07 23:45:57", "content": "Đã dùng 9 phút", "explain": "Khi viết đánh giá, khách 