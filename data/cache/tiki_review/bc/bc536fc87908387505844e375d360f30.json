p cách chừng 10m nhưng qua 2 vách tường dày. Tôi đặt em nó cách router 5m và qua 1 vách, sóng gió dưới bếp vách kế bên full cây, chạy ổn. Tôi cũng không có nhu cầu để *** sóng ở khoảng cách xa hơn vì xác định ngay từ đầu là hàng cấp thấp này cũng ko mong chờ gì nhiều. Tuy nhiên em này trong top best sellers của Amazon.", "status": "approved", "thank_count": 11, "score": 0.00170855, "new_score": 0.12588097, "customer_id": 1115867, "comment_count": 0, "rating": 4, "images": [], "thanked": false, "created_at": 1483976358, "created_by": {"id": 1115867, "name": "Trần Tấn Tài", "full_name": "Trần Tấn Tài", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2016-01-17 15:12:11", "purchased": true, "purchased_at": 1483809698, "contribute_info": {"id": 1115867, "name": "Trần Tấn Tài", "avatar": "//tiki.vn/assets/img/avatar.png", "summary": {"joined_time": "Đã tham gia 11 năm", "total_review": 29, "total_thank": 120}}}, "suggestions": [], "attributes": ["Mua từ nhà bán Tiki Trading"], "product_attributes": [], "spid": 229132, "is_photo": false, "seller": {"id": 1, "name": "Tiki Trading", "logo": "https://vcdn.tikicdn.com/ts/seller/ee/fa/a0/98f3f134f85cff2c6972c31777629aa0.png"}, "product_id": 511960, "timeline": {"review_created_date": "2017-01-09 22:39:18", "delivery_date": "2017-01-09 12:47:11", "current_date": "2026-09-07 22:53:00", "content": "Đã dùng 10 giờ", "explain": "Khi viết đánh giá, khách hàng đã dùng sản phẩm 10 giờ."}, "comments": [], "vote_attributes": {"agree": [], "disagree": []}, "delivery_rating": []}, {"id": 15618965, "title": "Hài lòng", "content": "sóng kém", "status": "approved", "thank_count": 0, "score": 27.77777778, "new_score": 0.13779665, "customer_id": 5590510, "comment_count": 0, "rating": 4, "images": [], "thanked": false, "created_at": 1648347658, "created_by": {"id": 5590510, "name": "Vũ Mạnh Đan", "full_name": "Vũ Mạnh Đan", "region": null, "avatar_url": "//tiki.vn/assets/img/avatar.png", "created_time": "2017-0